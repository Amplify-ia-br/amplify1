---
import PageShell from "@/layouts/PageShell.astro";
import logoAmplify from "@/assets/logo-amplify-branco.png";

const logoSrc = logoAmplify.src;
---
<PageShell
  title="Ana | Estrategista de IA da Amplify"
  description="Converse com a Ana, estrategista de IA da Amplify, para entender o próximo passo mais adequado para seu contexto."
  chatbot={false}
>
  <main class="ana-page" data-stage="intro">
    <header class="ana-header" aria-label="Amplify">
      <a href="/" class="ana-logo-link" aria-label="Voltar para a pagina inicial da Amplify">
        <img src={logoSrc} alt="Amplify" width="160" height="32" class="ana-logo" />
      </a>
      <span class="ana-header-status" data-phase-label>Pronta para conversar</span>
    </header>

    <section class="ana-shell" aria-labelledby="ana-title">
      <div class="ana-grid">
        <div class="ana-presence-panel">
          <div class="ana-presence" aria-hidden="true">
            <div class="ana-orbit ana-orbit-one"></div>
            <div class="ana-orbit ana-orbit-two"></div>
            <div class="ana-orbit ana-orbit-three"></div>
            <div class="ana-avatar" data-avatar>
              <span></span>
            </div>
          </div>
          <div class="ana-signal">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>

        <div class="ana-experience">
          <div class="ana-copy">
            <p class="ana-kicker">Amplify AI Strategy</p>
            <h1 id="ana-title">Ana</h1>
            <p class="ana-status" data-status>
              Conte o que você quer fazer com Inteligência Artificial. A conversa se adapta ao seu contexto e, se fizer sentido, prepara o próximo passo com a Amplify.
            </p>
          </div>

          <div class="ana-form" data-start-panel>
            <button type="button" class="ana-primary-button" data-start-button>Conversar com a Ana</button>
            <p class="ana-privacy-note">Você escolhe se prefere responder por voz ou por texto.</p>
          </div>

          <div class="ana-conversation" data-conversation hidden>
            <div class="ana-answer-box">
              <p class="ana-question-label" data-answer-label>Pergunta da Ana</p>
              <p data-transcript>A conversa vai começar.</p>
            </div>

            <div class="ana-choice-grid" data-choice-grid hidden></div>

            <form class="ana-text-fallback" data-answer-form hidden>
              <input data-answer-input type="text" autocomplete="off" placeholder="Digite sua resposta" />
              <button type="submit" class="ana-secondary-button">Enviar</button>
            </form>

            <div class="ana-actions">
              <button type="button" class="ana-primary-button" data-listen-button>Responder por voz</button>
              <button type="button" class="ana-secondary-button" data-type-button>Prefiro digitar</button>
              <button type="button" class="ana-ghost-button" data-skip-button hidden>Não sei agora</button>
              <button type="button" class="ana-ghost-button" data-repeat-button hidden>Repetir fala</button>
            </div>

            <div class="ana-completion" data-completion hidden>
              <p data-completion-text></p>
              <button type="button" class="ana-secondary-button" data-retry-button hidden>Tentar envio novamente</button>
            </div>
          </div>

          <p class="ana-error" data-error role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </main>


  <script>
    import "../scripts/ana-client.js";
  </script>

  <style>
    .ana-page {
      min-height: 100svh;
      overflow-x: hidden;
      background:
        radial-gradient(circle at 50% 48%, hsl(var(--primary) / 0.18), transparent 24rem),
        radial-gradient(circle at 76% 18%, rgba(255,255,255,0.08), transparent 18rem),
        linear-gradient(145deg, #050607 0%, hsl(var(--background)) 58%, #030404 100%);
      color: hsl(var(--foreground));
    }

    .ana-page::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--foreground) / 0.035) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--foreground) / 0.025) 1px, transparent 1px);
      background-size: 4.5rem 4.5rem;
      mask-image: radial-gradient(circle at center, black, transparent 72%);
    }

    .ana-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 4.5rem;
      padding: 0 clamp(1rem, 4vw, 3rem);
      border-bottom: 1px solid hsl(var(--border) / 0.6);
      background: rgba(5, 6, 7, 0.72);
      backdrop-filter: blur(18px);
    }

    .ana-logo-link {
      display: inline-flex;
      align-items: center;
    }

    .ana-logo {
      height: 1.65rem;
      width: auto;
    }

    .ana-header-status {
      color: hsl(var(--muted-foreground));
      font-size: 0.82rem;
      font-weight: 600;
    }

    .ana-shell {
      min-height: 100svh;
      width: min(100%, 82rem);
      margin: 0 auto;
      padding: 5.2rem clamp(1rem, 3vw, 2.5rem) 1.4rem;
      display: grid;
      align-items: center;
    }

    .ana-grid {
      display: grid;
      grid-template-columns: minmax(17rem, 0.92fr) minmax(22rem, 1fr);
      align-items: center;
      gap: clamp(1.4rem, 4vw, 4.5rem);
      min-height: min(calc(100svh - 6.6rem), 42rem);
    }

    .ana-presence-panel {
      display: grid;
      justify-items: center;
      gap: 1rem;
    }

    .ana-presence {
      position: relative;
      width: min(34vw, 24rem);
      min-width: 17rem;
      aspect-ratio: 1;
      display: grid;
      place-items: center;
    }

    .ana-avatar,
    .ana-orbit {
      position: absolute;
      border-radius: 999px;
    }

    .ana-avatar {
      width: 42%;
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border: 1px solid hsl(var(--primary) / 0.62);
      background:
        radial-gradient(circle at 42% 32%, rgba(255,255,255,0.95), transparent 0.42rem),
        radial-gradient(circle at center, hsl(var(--primary) / 0.34), hsl(var(--card)) 66%);
      box-shadow:
        0 0 46px hsl(var(--primary) / 0.34),
        inset 0 0 42px hsl(var(--primary) / 0.12);
      transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .ana-avatar span {
      width: 32%;
      aspect-ratio: 1;
      border-radius: 999px;
      background: hsl(var(--primary));
      box-shadow: 0 0 32px hsl(var(--primary) / 0.8);
    }

    .ana-orbit {
      inset: 20%;
      border: 1px solid hsl(var(--primary) / 0.24);
      animation: ana-pulse 3s ease-in-out infinite;
    }

    .ana-orbit-two {
      inset: 9%;
      animation-delay: 0.4s;
    }

    .ana-orbit-three {
      inset: 0;
      border-color: hsl(var(--foreground) / 0.08);
      animation-delay: 0.8s;
    }

    .ana-page[data-stage="speaking"] .ana-orbit,
    .ana-page[data-stage="listening"] .ana-orbit,
    .ana-page[data-stage="processing"] .ana-orbit {
      animation-duration: 1.12s;
      border-color: hsl(var(--primary) / 0.62);
    }

    .ana-page[data-stage="listening"] .ana-avatar {
      transform: scale(1.04);
      box-shadow:
        0 0 72px hsl(var(--primary) / 0.42),
        inset 0 0 42px hsl(var(--primary) / 0.16);
    }

    .ana-signal {
      height: 1.9rem;
      display: flex;
      align-items: center;
      gap: 0.34rem;
      opacity: 0.72;
    }

    .ana-signal span {
      width: 0.18rem;
      height: 0.65rem;
      border-radius: 999px;
      background: hsl(var(--primary));
      animation: ana-bars 1.2s ease-in-out infinite;
      transform-origin: center;
    }

    .ana-signal span:nth-child(2) { animation-delay: 0.12s; }
    .ana-signal span:nth-child(3) { animation-delay: 0.24s; }
    .ana-signal span:nth-child(4) { animation-delay: 0.36s; }
    .ana-signal span:nth-child(5) { animation-delay: 0.48s; }

    .ana-experience {
      display: grid;
      gap: clamp(1rem, 2vh, 1.35rem);
      min-width: 0;
    }

    .ana-copy {
      display: grid;
      gap: 0.7rem;
    }

    .ana-kicker {
      margin: 0;
      color: hsl(var(--primary));
      font-size: 0.76rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    .ana-copy h1 {
      margin: 0;
      font-size: clamp(4rem, 9vw, 7.2rem);
      line-height: 0.88;
      letter-spacing: 0;
    }

    .ana-status {
      min-height: 5.4rem;
      margin: 0;
      color: hsl(var(--foreground) / 0.82);
      font-size: clamp(1rem, 1.8vw, 1.26rem);
      line-height: 1.46;
      max-width: 42rem;
      scroll-margin-top: 4.75rem;
    }

    .ana-form,
    .ana-conversation {
      width: min(100%, 34rem);
      display: grid;
      gap: 0.78rem;
    }

    .ana-privacy-note {
      margin: 0;
      color: hsl(var(--muted-foreground));
      font-size: 0.78rem;
      text-align: center;
    }

    .ana-form label {
      display: grid;
      gap: 0.36rem;
      text-align: left;
      color: hsl(var(--muted-foreground));
      font-size: 0.82rem;
      font-weight: 700;
    }

    .ana-field-row {
      display: grid;
      grid-template-columns: 1fr 2.7rem;
      gap: 0.55rem;
    }

    .ana-form input,
    .ana-text-fallback input {
      min-height: 2.82rem;
      border: 1px solid hsl(var(--border));
      border-radius: 0.5rem;
      padding: 0 0.92rem;
      background: rgba(14, 16, 18, 0.78);
      color: hsl(var(--foreground));
      outline: none;
    }

    .ana-form input:focus,
    .ana-text-fallback input:focus {
      border-color: hsl(var(--primary));
      box-shadow: 0 0 0 3px hsl(var(--primary) / 0.12);
    }

    .ana-icon-button,
    .ana-primary-button,
    .ana-secondary-button,
    .ana-ghost-button {
      min-height: 2.85rem;
      border-radius: 0.5rem;
      border: 1px solid transparent;
      font: inherit;
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      transition: transform 160ms ease, opacity 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .ana-icon-button {
      background: hsl(var(--secondary));
      color: hsl(var(--primary));
      font-size: 0.96rem;
    }

    .ana-primary-button {
      background: hsl(var(--primary));
      color: hsl(var(--primary-foreground));
      box-shadow: 0 0 22px hsl(var(--cyan) / 0.28), 0 0 48px hsl(var(--cyan) / 0.08);
    }

    .ana-secondary-button,
    .ana-ghost-button {
      background: rgba(255,255,255,0.035);
      color: hsl(var(--foreground));
      border-color: hsl(var(--border));
    }

    .ana-ghost-button {
      color: hsl(var(--muted-foreground));
    }

    .ana-icon-button:hover,
    .ana-primary-button:hover,
    .ana-secondary-button:hover,
    .ana-ghost-button:hover {
      transform: translateY(-1px);
      border-color: hsl(var(--primary) / 0.5);
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.58;
      transform: none;
    }

    .ana-answer-box {
      min-height: 6.5rem;
      display: grid;
      align-content: center;
      gap: 0.5rem;
      border: 1px solid hsl(var(--border));
      border-radius: 0.5rem;
      padding: 1rem;
      background: rgba(14, 16, 18, 0.68);
      text-align: left;
    }

    .ana-question-label {
      margin: 0;
      color: hsl(var(--primary));
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    .ana-answer-box p:last-child {
      margin: 0;
      color: hsl(var(--foreground));
      line-height: 1.45;
    }

    .ana-choice-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }

    .ana-choice-button {
      min-height: 2.85rem;
      border: 1px solid hsl(var(--border));
      border-radius: 0.5rem;
      padding: 0.65rem 0.8rem;
      background: rgba(255,255,255,0.035);
      color: hsl(var(--foreground));
      font: inherit;
      font-size: 0.86rem;
      font-weight: 750;
      cursor: pointer;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .ana-choice-button:hover,
    .ana-choice-button:focus-visible {
      transform: translateY(-1px);
      border-color: hsl(var(--primary) / 0.72);
      background: hsl(var(--primary) / 0.08);
      outline: none;
    }

    .ana-text-fallback {
      display: grid;
      grid-template-columns: 1fr 6rem;
      gap: 0.6rem;
    }

    .ana-actions {
      display: grid;
      grid-template-columns: 1.1fr 1fr 0.82fr 0.82fr;
      gap: 0.6rem;
    }

    .ana-completion {
      display: grid;
      gap: 0.7rem;
      padding: 0.85rem 1rem;
      border: 1px solid hsl(var(--border));
      border-radius: 0.5rem;
      background: hsl(var(--primary) / 0.06);
    }

    .ana-completion p {
      margin: 0;
      color: hsl(var(--foreground) / 0.86);
      font-size: 0.9rem;
      line-height: 1.45;
    }

    .ana-error {
      min-height: 1.3rem;
      margin: 0;
      color: #fca5a5;
      font-size: 0.86rem;
    }

    [hidden] {
      display: none !important;
    }

    @keyframes ana-pulse {
      0%,
      100% {
        transform: scale(0.92);
        opacity: 0.26;
      }
      50% {
        transform: scale(1.05);
        opacity: 0.78;
      }
    }

    @keyframes ana-bars {
      0%,
      100% {
        transform: scaleY(0.58);
        opacity: 0.42;
      }
      50% {
        transform: scaleY(1.7);
        opacity: 0.95;
      }
    }

    @media (max-width: 860px) {
      .ana-page {
        min-height: 100svh;
        overflow-y: auto;
      }

      .ana-header {
        height: 4rem;
      }

      .ana-header-status {
        font-size: 0.74rem;
      }

      .ana-shell {
        min-height: 100svh;
        height: auto;
        padding-top: 4.75rem;
        padding-bottom: max(2rem, env(safe-area-inset-bottom));
        align-items: start;
      }

      .ana-grid {
        min-height: 0;
        height: auto;
        grid-template-columns: 1fr;
        align-content: start;
        justify-items: center;
        gap: 0.9rem;
      }

      .ana-presence {
        width: min(54vw, 14.5rem);
        min-width: 10.5rem;
      }

      .ana-signal {
        height: 1.2rem;
      }

      .ana-experience {
        width: min(100%, 34rem);
        justify-items: center;
        text-align: center;
        gap: 0.8rem;
      }

      .ana-copy h1 {
        font-size: clamp(3rem, 13vw, 4.2rem);
      }

      .ana-status {
        min-height: 4.5rem;
        font-size: 0.98rem;
        line-height: 1.38;
      }

      .ana-form,
      .ana-conversation {
        gap: 0.65rem;
      }

      .ana-actions {
        grid-template-columns: 1fr;
      }

      .ana-choice-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-height: 720px) and (min-width: 861px) {
      .ana-presence {
        width: min(30vw, 18rem);
      }

      .ana-copy h1 {
        font-size: clamp(3.4rem, 7vw, 5.2rem);
      }

      .ana-status {
        min-height: 4.4rem;
        font-size: 1rem;
      }
    }
  </style>
</PageShell>
