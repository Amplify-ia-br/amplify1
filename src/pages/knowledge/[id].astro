---
import { render } from "astro:content";
import { ArrowLeft, ArrowRight, Files } from "lucide-react";
import KnowledgeToc from "@/components/knowledge/KnowledgeToc";
import KnowledgeAnnotations from "@/components/knowledge/KnowledgeAnnotations";
import KnowledgeLayout from "@/layouts/KnowledgeLayout.astro";
import { getPublicKnowledge, markdownToSearchText, type PublicKnowledgeEntry } from "@/lib/knowledge";
import { parentTarget } from "@/lib/knowledge-hierarchy";

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getPublicKnowledge();
  return entries.map((entry) => ({ params: { id: entry.data.id }, props: { entry, entries } }));
}

const { entry, entries } = Astro.props as { entry: PublicKnowledgeEntry; entries: PublicKnowledgeEntry[] };
const { Content, headings } = await render(entry);
const items = entries.map((item) => ({
  id: item.data.id,
  title: item.data.title,
  description: item.data.description,
  type: item.data.type,
  status: item.data.status,
  tags: item.data.tags,
  lastReviewed: item.data.last_reviewed,
  content: markdownToSearchText(item.body),
  relationships: item.data.relationships,
}));
const parentId = parentTarget(entry.data.relationships);
const parent = parentId ? entries.find((item) => item.data.id === parentId) : undefined;
const relatedDocuments = entries.filter((item) => parentTarget(item.data.relationships) === entry.data.id);
const publicIds = new Set(entries.map((item) => item.data.id));
const navigationEntries = entries.filter((item) => {
  const target = parentTarget(item.data.relationships);
  return !target || !publicIds.has(target);
});
const navigationIndex = navigationEntries.findIndex((item) => item.data.id === entry.data.id);
const previous = navigationIndex > 0 ? navigationEntries[navigationIndex - 1] : undefined;
const next = navigationIndex >= 0 ? navigationEntries[navigationIndex + 1] : undefined;
const statusLabels = {
  approved: "Aprovado",
  active: "Ativo",
  review: "Em revisão",
  draft: "Rascunho",
  deprecated: "Descontinuado",
};
const typeLabels = {
  company: "Empresa",
  education: "Educação",
  glossary: "Glossário",
  method: "Método",
  offering: "Oferta",
  portfolio: "Portfólio",
};
const [year, month, day] = entry.data.last_reviewed.split("-");
const reviewedAt = year && month && day ? `${day}/${month}/${year}` : entry.data.last_reviewed;
---

<KnowledgeLayout title={`${entry.data.title} | Amplify`} description={entry.data.description} items={items} activeId={entry.data.id}>
  <article class="kb-document-page">
    <div>
      <nav class="kb-breadcrumb" aria-label="Caminho do documento">
        <a href="/knowledge"><ArrowLeft aria-hidden="true" /> Base de conhecimento</a>
        {parent && <><span>/</span><a href={`/knowledge/${parent.data.id}`}>{parent.data.title}</a></>}
      </nav>
      <header class="kb-document-header">
        <div class="kb-document-kicker">
          <b>{typeLabels[entry.data.type] ?? entry.data.type}</b><i></i>
          <span>{statusLabels[entry.data.status] ?? entry.data.status}</span><i></i>
          <span>Revisado em {reviewedAt}</span>
        </div>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
        {entry.data.tags.length > 0 && <ul aria-label="Tags">{entry.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
      </header>
      <div class="knowledge-prose"><Content /></div>
      {relatedDocuments.length > 0 && <section class="kb-related-documents" aria-labelledby="related-documents-title">
        <div class="kb-related-heading"><Files aria-hidden="true" /><div><h2 id="related-documents-title">Documentos relacionados</h2><p>Materiais complementares que fazem parte deste conteúdo.</p></div></div>
        <div>{relatedDocuments.map((document) => <a href={`/knowledge/${document.data.id}`}><span><small>{typeLabels[document.data.type] ?? document.data.type}</small><strong>{document.data.title}</strong><p>{document.data.description}</p></span><ArrowRight aria-hidden="true" /></a>)}</div>
      </section>}
      <KnowledgeAnnotations client:load okfId={entry.data.id} returnTo={`/knowledge/${entry.data.id}`} />
      {(previous || next) && <nav class="kb-page-navigation" aria-label="Documentos anterior e próximo">
        {previous ? <a href={`/knowledge/${previous.data.id}`}><small>Anterior</small><strong>{previous.data.title}</strong></a> : <span></span>}
        {next && <a href={`/knowledge/${next.data.id}`}><small>Próximo</small><strong>{next.data.title}</strong></a>}
      </nav>}
    </div>
    <KnowledgeToc client:load headings={headings} />
  </article>
</KnowledgeLayout>
