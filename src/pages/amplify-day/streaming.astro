---
export const prerender = true;
const eventDate = "23 set 2026 · 15h às 16h30";
const speakers = [
  { name: "Iara Christina Silva Barroca", role: "Coordenadora-Geral de Inovação · SEGAPE/MEC", image: "/amplify-day/speakers/iara-barroca-transparent.webp", width: 1050, height: 1498, position: "center bottom", contribution: "Dos referenciais nacionais à implementação nas redes de ensino." },
  { name: "Gustavo Wigman", role: "Fundador e CEO do Instituto Vertere", image: "/amplify-day/speakers/gustavo-wigman-transparent.webp", width: 1254, height: 1254, position: "center bottom", contribution: "Aprendizagem, pensamento crítico e protagonismo estudantil." },
  { name: "Rafael Lacerda", role: "Fundador e CEO da Raleduc", image: "/amplify-day/speakers/rafael-lacerda-transparent.webp", width: 1309, height: 1202, position: "center bottom", contribution: "Educação, tecnologia e adoção prática em organizações." },
  { name: "Prof. Álvaro", role: "Educador e líder do Missão Escola", image: "/amplify-day/speakers/prof-alvaro-complete-transparent.webp", width: 1024, height: 1536, position: "center bottom", contribution: "Mais de 40 anos entre sala de aula e gestão educacional." },
];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" /><meta name="googlebot" content="noindex, nofollow, noarchive" />
  <meta name="theme-color" content="#f0eee6" /><meta name="description" content="Transmissão ao vivo do Palco AMPL_IA no Ampl_IA Day by X-Via." />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>Palco AMPL_IA ao vivo | Ampl_IA Day by X-Via</title>
</head>
<body>
<main class="page" style="--paper-texture:url(/_astro/editorial-paper.x6nYmJrj.webp)">
  <nav class="editorial-nav" aria-label="Navegação do Ampl_IA Day">
    <a class="nav-brand" href="#inicio" aria-label="Ampl_IA Day by X-Via"><b>Ampl<span>_IA</span> Day</b><small>by X-Via</small></a>
    <div class="nav-meta"><span>23 set<br />2026</span><span>Transmissão ao vivo</span></div>
    <div class="nav-links"><a href="#lineup">Lineup</a><a href="#debate">O debate</a><a href="#brasilia">Brasília</a></div>
  </nav>

  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <header class="hero-head"><div class="event-lockup" aria-label="Ampl_IA Day by X-Via"><strong>Ampl<span>_IA</span> Day</strong><div class="event-lockup-meta"><div class="event-by"><small>by</small><img src="/amplify-day/brand/xvia-symbol-color.png" alt="" width="327" height="212" /><b>X-Via</b></div></div></div></header>
    <div class="hero-date" aria-label="23 de setembro de 2026"><div class="date-number" aria-hidden="true">23</div><div class="date-caption"><span>Set</span><span>2026</span></div></div>
    <figure class="hero-image"><img src="/_astro/catedral-tres-poderes.CNZs75Dv.webp" alt="Arquitetura de Brasília" width="1600" height="2400" /><figcaption><i aria-hidden="true"></i><span>Streaming ao vivo dos nossos estúdios em Brasília</span></figcaption></figure>
    <aside class="hero-action" aria-labelledby="hero-title"><div class="action-title"><span>01</span><h1 id="hero-title">Assista<br />ao vivo</h1></div><div class="action-bottom"><p>Transmissão gratuita do Palco AMPL_IA para todo o Brasil.</p><button class="primary" type="button" data-open-form>Garantir acesso gratuito</button></div></aside>
    <footer class="hero-foot hero-partners">
      <div class="hero-partner-group"><span class="hero-partner-label">Realização</span><div class="brands" aria-label="Realização: X-VIA, Amplify e Shock Wave"><img class="xvia" src="/_astro/xvia-white.ClfTZZ9-.png" alt="X-VIA" width="3426" height="774" /><span aria-hidden="true">+</span><img class="amplify" src="/_astro/logo-amplify-color.BWlawH-N.png" alt="Amplify" width="1301" height="204" /><span aria-hidden="true">+</span><img class="shock" src="/_astro/shockwave.7DdAxS2m.webp" alt="Shock Wave" width="500" height="331" /></div></div>
      <span class="hero-partner-separator" aria-hidden="true"></span>
      <div class="hero-support"><img src="/amplify-day/logos/xc-studio-black.webp" alt="XC Studio" width="301" height="296" /><p class="hero-curation"><span>Apoio</span><strong>XC Studio</strong></p></div>
    </footer>
  </section>

  <section class="lineup section-shell" id="lineup" aria-labelledby="lineup-title">
    <header class="section-heading"><span>02 · Lineup confirmado</span><h2 id="lineup-title">Quem participa dessa conversa.</h2><p>Política pública, escola, aprendizagem e implementação no mesmo debate.</p></header>
    <div class="lineup-grid">
      <article class="feature-speaker"><figure><img src={speakers[0].image} alt={speakers[0].name} width={speakers[0].width} height={speakers[0].height} /></figure><div><span>Debatedora em destaque</span><h3>{speakers[0].name}</h3><p>{speakers[0].role}</p><small>Professora da UFV · Pesquisadora Fulbright</small><strong>{speakers[0].contribution}</strong><em>Integra a equipe de pesquisa e redação do Referencial do MEC sobre IA na Educação.</em></div></article>
      <div class="speaker-stack">{speakers.slice(1).map((speaker, index) => <article><figure><img class:list={{ "is-complete-portrait": speaker.name === "Prof. Álvaro" }} src={speaker.image} alt={speaker.name} width={speaker.width} height={speaker.height} style={`object-position:${speaker.position}`} /></figure><div><span>{String(index + 2).padStart(2, "0")}</span><h3>{speaker.name}</h3><p class="role">{speaker.role}</p><p>{speaker.contribution}</p></div></article>)}</div>
    </div>
  </section>

  <section class="debate section-shell" id="debate" aria-labelledby="debate-title">
    <div class="debate-heading"><span>03 · O debate</span><h2 id="debate-title">Da orientação pública à prática nas escolas.</h2></div>
    <ol><li><span>01</span><p>Governança e uso responsável.</p></li><li><span>02</span><p>Formação docente.</p></li><li><span>03</span><p>Aplicação nas redes de ensino.</p></li></ol>
    <aside><p>Uma conversa para diretores, mantenedores, lideranças pedagógicas e profissionais de inovação e tecnologia no ensino.</p><button type="button" data-open-form>Quero assistir <span>→</span></button></aside>
  </section>

  <section class="brasilia" id="brasilia" aria-labelledby="brasilia-title"><figure><img src="/_astro/catedral-tres-poderes.CNZs75Dv.webp" alt="Arquitetura de Brasília" width="1600" height="2400" loading="lazy" /><figcaption>Brasília · DF</figcaption></figure><div><span>04 · De Brasília para o Brasil</span><h2 id="brasilia-title">Onde decisões públicas ganham alcance nacional.</h2><p>Transmitimos de Brasília, sede do pensamento e da decisão sobre políticas educacionais, para escolas, gestores e educadores de todo o país.</p></div></section>
  <section class="final-cta section-shell"><p>{eventDate} · Online e gratuito</p><h2>Ouça essa conversa<br />em primeira mão.</h2><button class="primary" type="button" data-open-form data-closing-cta>Garantir acesso gratuito</button></section>
  <footer class="site-foot section-shell"><div class="brands"><img class="xvia" src="/_astro/xvia-white.ClfTZZ9-.png" alt="X-VIA" /><b>+</b><img class="amplify" src="/_astro/logo-amplify-color.BWlawH-N.png" alt="Amplify" /><b>+</b><img class="shock" src="/_astro/shockwave.7DdAxS2m.webp" alt="Shock Wave" /></div><p>Ampl_IA Day · Edição 01</p></footer>

  <button class="floating-cta" type="button" data-open-form data-floating-cta aria-hidden="true" tabindex="-1"><span>Acesso gratuito</span><i aria-hidden="true"></i></button>
  <section class="access-modal" data-access-modal aria-hidden="true" inert><button class="modal-backdrop" type="button" data-close-form aria-label="Fechar formulário"></button><div class="dialog" role="dialog" aria-modal="true" aria-labelledby="registration-title"><header><p>Ampl_IA Day · Transmissão ao vivo</p><button type="button" data-close-form>Fechar</button></header><div class="dialog-body">
    <div data-form-shell><span class="dialog-index">Acesso gratuito</span><h2 id="registration-title">Garanta seu<br />acesso ao vivo.</h2><p>Receba o link e os lembretes por e-mail.</p><form data-streaming-form novalidate>
      <label><span>Nome</span><input name="name" type="text" autocomplete="name" required minlength="2" /><small data-error="name" hidden>Informe seu nome.</small></label><label><span>E-mail</span><input name="email" type="email" autocomplete="email" required /><small data-error="email" hidden>Informe um e-mail válido.</small></label><label><span>Escola</span><input name="school" type="text" autocomplete="organization" required minlength="2" /><small data-error="school" hidden>Informe sua escola.</small></label><label><span>Cargo</span><input name="role" type="text" autocomplete="organization-title" required minlength="2" /><small data-error="role" hidden>Informe seu cargo.</small></label><input class="honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" /><button class="primary" type="submit" data-submit-form>Garantir meu acesso gratuito</button><p class="submit-error" data-submit-error role="alert" hidden>Não foi possível concluir agora. Tente novamente.</p><p class="form-note">Ao se cadastrar, você concorda em receber informações do Ampl_IA Day por e-mail.</p>
    </form></div><div class="success" data-success-state hidden tabindex="-1" role="status"><span>Acesso reservado</span><h2>Nos vemos<br />ao vivo.</h2><p>Cadastro confirmado. Enviaremos o acesso e os lembretes para o seu e-mail.</p><button type="button" data-reset-form>Cadastrar outro e-mail</button></div>
  </div></div></section>
</main>

<script>
  const form=document.querySelector<HTMLFormElement>("[data-streaming-form]"),shell=document.querySelector<HTMLElement>("[data-form-shell]"),success=document.querySelector<HTMLElement>("[data-success-state]"),modal=document.querySelector<HTMLElement>("[data-access-modal]"),dialog=modal?.querySelector<HTMLElement>("[role='dialog']"),floating=document.querySelector<HTMLButtonElement>("[data-floating-cta]"),hero=document.querySelector<HTMLElement>(".hero"),closing=document.querySelector<HTMLElement>("[data-closing-cta]"),submitButton=form?.querySelector<HTMLButtonElement>("[data-submit-form]"),submitError=form?.querySelector<HTMLElement>("[data-submit-error]");
  let opener:HTMLElement|null=null,storedY=0,opened=false,closingVisible=false;
  const syncFloating=()=>{if(!floating||!hero)return;const show=hero.getBoundingClientRect().bottom<=64&&!opened&&!closingVisible;floating.classList.toggle("is-visible",show);floating.setAttribute("aria-hidden",String(!show));floating.tabIndex=show?0:-1};
  const openModal=(trigger:HTMLElement)=>{if(!modal||opened)return;opener=trigger;storedY=scrollY;opened=true;modal.removeAttribute("inert");modal.setAttribute("aria-hidden","false");modal.classList.add("is-open");document.documentElement.classList.add("modal-open");document.body.style.top=`-${storedY}px`;syncFloating();setTimeout(()=>form?.querySelector<HTMLInputElement>('input[name="name"]')?.focus(),40)};
  const closeModal=()=>{if(!modal||!opened)return;opened=false;modal.classList.remove("is-open");modal.setAttribute("aria-hidden","true");modal.setAttribute("inert","");document.documentElement.classList.remove("modal-open");document.body.style.top="";scrollTo(0,storedY);syncFloating();opener?.focus()};
  document.querySelectorAll<HTMLElement>("[data-open-form]").forEach(b=>b.addEventListener("click",()=>openModal(b)));document.querySelectorAll<HTMLElement>("[data-close-form]").forEach(b=>b.addEventListener("click",closeModal));
  const syncField=(field:HTMLInputElement)=>{const valid=field.validity.valid;field.setAttribute("aria-invalid",String(!valid));const error=form?.querySelector<HTMLElement>(`[data-error="${field.name}"]`);if(error)error.hidden=valid;return valid};
  const fields=[...(form?.querySelectorAll<HTMLInputElement>('input:not([name="website"])')??[])];fields.forEach(f=>{f.addEventListener("blur",()=>syncField(f));f.addEventListener("input",()=>{if(f.getAttribute("aria-invalid")==="true")syncField(f)})});form?.addEventListener("submit",async e=>{e.preventDefault();submitError?.setAttribute("hidden","");if(!fields.map(syncField).every(Boolean))return fields.find(f=>!f.validity.valid)?.focus();if(!submitButton)return;const originalLabel=submitButton.textContent||"Garantir meu acesso gratuito";submitButton.disabled=true;submitButton.setAttribute("aria-busy","true");submitButton.textContent="Cadastrando...";const data=new FormData(form),params=new URLSearchParams(location.search);try{const response=await fetch("/api/amplify-day-streaming",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name:data.get("name"),email:data.get("email"),school:data.get("school"),role:data.get("role"),website:data.get("website"),utm_source:params.get("utm_source"),utm_medium:params.get("utm_medium"),utm_campaign:params.get("utm_campaign"),utm_content:params.get("utm_content")})}),result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.error||"registration_failed");shell?.setAttribute("hidden","");success?.removeAttribute("hidden");success?.focus()}catch(error){console.error("Cadastro do streaming:",error);submitError?.removeAttribute("hidden")}finally{submitButton.disabled=false;submitButton.removeAttribute("aria-busy");submitButton.textContent=originalLabel}});
  document.querySelector<HTMLElement>("[data-reset-form]")?.addEventListener("click",()=>{success?.setAttribute("hidden","");shell?.removeAttribute("hidden");form?.reset();submitError?.setAttribute("hidden","");fields.forEach(f=>f.removeAttribute("aria-invalid"));form?.querySelectorAll<HTMLElement>("[data-error]").forEach(e=>e.hidden=true);form?.querySelector<HTMLInputElement>('input[name="name"]')?.focus()});
  document.addEventListener("keydown",e=>{if(!opened||!dialog)return;if(e.key==="Escape")return closeModal();if(e.key!=="Tab")return;const items=[...dialog.querySelectorAll<HTMLElement>('button:not([disabled]),input:not([disabled]),[tabindex]:not([tabindex="-1"])')].filter(i=>i.offsetParent!==null),first=items[0],last=items.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last?.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first?.focus()}});
  if(closing)new IntersectionObserver(([e])=>{closingVisible=e.isIntersecting;syncFloating()},{threshold:.25}).observe(closing);addEventListener("scroll",syncFloating,{passive:true});addEventListener("resize",syncFloating);syncFloating();
</script>
</body></html>

<style is:global>
:root{--paper:#f0eee6;--ink:#0b0e0c;--cyan:#08b7c7;--pink:#c8184a;--line:rgba(11,14,12,.72);--soft:rgba(11,14,12,.25);--display:"Bricolage Grotesque",sans-serif;--ui:Inter,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--paper)}body{margin:0;overflow-x:hidden;color:var(--ink);background:var(--paper);font-family:var(--ui)}button,input{font:inherit}button{border-radius:0}a{color:inherit}[hidden]{display:none!important}.page{min-height:100%;background-color:var(--paper);background-image:var(--paper-texture);background-size:520px}.modal-open{overflow:hidden}.modal-open body{position:fixed;right:0;left:0;width:100%;overflow:hidden}
.editorial-nav{position:sticky;z-index:30;top:0;display:grid;grid-template-columns:190px minmax(0,1fr) auto;align-items:center;height:64px;border-bottom:1px solid var(--line);padding:0 clamp(24px,3vw,44px);background:rgba(240,238,230,.96);backdrop-filter:blur(8px)}.nav-brand{display:flex;width:max-content;flex-direction:column;text-decoration:none;text-transform:uppercase}.nav-brand b{font:800 13px/.9 var(--display);letter-spacing:.15em}.nav-brand b span{color:var(--cyan)}.nav-brand small{align-self:flex-end;margin-top:4px;font:700 6px/1 var(--ui);letter-spacing:.08em}.nav-meta{display:flex;align-items:center;gap:48px;font:750 10px/1.08 var(--ui);letter-spacing:.13em;text-transform:uppercase}.nav-links{display:flex;gap:38px}.nav-links a{font:750 9px/1 var(--ui);letter-spacing:.13em;text-decoration:none;text-transform:uppercase}
.hero{display:grid;grid-template-columns:minmax(0,1.62fr) minmax(220px,.54fr) minmax(330px,.82fr);grid-template-rows:150px minmax(0,1fr) 90px;height:calc(100svh - 64px);min-height:700px;padding:0 clamp(24px,3vw,44px)}.hero-head{grid-column:1/3;display:flex;align-items:center;border-right:1px solid var(--soft);border-bottom:1px solid var(--line)}.event-lockup{display:flex;width:max-content;max-width:100%;flex-direction:column;justify-content:center;padding-right:clamp(28px,3vw,48px)}.event-lockup>strong{font:700 clamp(58px,6.6vw,98px)/.8 var(--display);letter-spacing:-.075em;text-transform:uppercase;white-space:nowrap}.event-lockup>strong span{color:var(--cyan)}.event-lockup-meta{display:flex;align-items:center;justify-content:flex-end;margin-top:16px;padding-left:3px}.event-by{display:flex;align-items:center;gap:7px}.event-lockup small{font:750 10px/1 var(--ui)}.event-lockup img{width:36px;height:24px;object-fit:fill}.event-by b{font:750 20px/1 var(--ui);letter-spacing:-.05em;text-transform:uppercase}
.hero-date{position:relative;grid-column:1;grid-row:2;display:grid;min-width:0;grid-template-columns:minmax(0,1fr) auto;align-items:end;overflow:hidden;border-right:1px solid var(--soft);padding:34px clamp(26px,3vw,44px) 40px 0}.date-number{position:relative;z-index:1;align-self:end;font:700 min(31vw,430px)/.67 var(--display);letter-spacing:-.11em}.date-number:before{position:absolute;z-index:-1;left:-18px;content:"23";color:transparent;-webkit-text-stroke:2px rgba(200,24,74,.1);transform:translate(-12px,-5px)}.date-caption{align-self:end;margin-bottom:28px;border-left:1px solid var(--line);padding-left:20px;font:800 clamp(38px,4.2vw,62px)/.78 var(--display);letter-spacing:-.06em;text-transform:uppercase}.date-caption span{display:block}.date-caption span:last-child{color:var(--cyan)}
.hero-image{position:relative;grid-column:2;grid-row:2;min-width:0;margin:0;overflow:hidden;border-right:1px solid var(--soft);background:#98a9ae}.hero-image>img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 56%;filter:saturate(.75) contrast(1.06)}.hero-image:after{position:absolute;inset:0;content:"";background-image:radial-gradient(circle,rgba(11,14,12,.7) .65px,transparent .9px);background-size:5px 5px;opacity:.28}.hero-image figcaption{position:absolute;z-index:2;right:14px;bottom:14px;display:flex;width:min(210px,calc(100% - 28px));align-items:flex-start;gap:8px;padding:9px 10px;color:#fff;background:var(--ink);font:800 9px/1.3 var(--ui);letter-spacing:.1em;text-transform:uppercase}.hero-image figcaption i{flex:0 0 auto;width:7px;height:7px;margin-top:2px;border-radius:50%;background:var(--pink);box-shadow:0 0 0 3px rgba(255,255,255,.16)}
.hero-action{grid-column:3;grid-row:1/3;display:flex;min-width:0;flex-direction:column;padding:clamp(34px,4vh,46px) 0 34px clamp(28px,3.2vw,48px)}.action-title{display:grid;grid-template-columns:28px 1fr;align-items:start;gap:14px}.action-title>span{margin-top:8px;color:#00828d;font:800 10px/1 var(--ui);letter-spacing:.13em}.action-title h1{margin:0;font:500 min(5.3vw,9.3vh,76px)/.87 var(--display);letter-spacing:-.072em;text-transform:uppercase}.action-title h1:after{display:block;width:46%;height:4px;margin-top:24px;content:"";background:var(--cyan)}.action-bottom{margin-top:auto}.action-bottom>p{max-width:390px;margin:0 0 22px;font:500 clamp(17px,1.45vw,22px)/1.22 var(--display);letter-spacing:-.025em}.primary{position:relative;width:100%;height:68px;border:1px solid var(--ink);color:var(--ink);background:var(--cyan);font:800 11px/1 var(--ui);letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:transform .2s,box-shadow .2s}.primary:hover,.primary:focus-visible{box-shadow:4px 4px 0 var(--pink);transform:translate(-2px,-2px)}.action-bottom small{display:block;margin-top:14px;color:rgba(11,14,12,.62);font:500 9px/1.4 var(--ui)}
.hero-foot{grid-column:1/-1;grid-row:3;border-top:1px solid var(--line)}.hero-partners{display:grid;grid-template-columns:auto 1px minmax(220px,.42fr);align-items:center;gap:clamp(18px,2vw,30px)}.hero-partner-group{display:flex;min-width:0;align-items:center;gap:clamp(12px,1.3vw,20px)}.hero-partner-label,.hero-curation span{font:700 8px/1 var(--ui);letter-spacing:.14em;text-transform:uppercase}.hero-foot .brands{display:flex;flex-shrink:0;align-items:center;gap:clamp(8px,.85vw,13px)}.hero-foot .brands>span{font:500 17px/1 var(--ui)}.hero-foot .brands img{display:block;width:auto;object-fit:contain}.hero-foot .brands .xvia{width:clamp(86px,7.2vw,110px);filter:brightness(0)}.hero-foot .brands .amplify{width:clamp(100px,8.6vw,132px);filter:grayscale(1) brightness(0)}.hero-foot .brands .shock{width:clamp(66px,5.25vw,80px);filter:brightness(0)}.hero-partner-separator{width:1px;height:46px;background:rgba(11,14,12,.42)}.hero-support{display:flex;min-width:0;align-items:center;justify-content:flex-start;gap:clamp(14px,1.4vw,22px)}.hero-support img{display:block;width:clamp(48px,4.35vw,69px);height:auto;max-height:52px;object-fit:contain}.hero-curation{display:grid;gap:5px;margin:0}.hero-curation strong{font:650 clamp(10px,.78vw,12px)/1.22 var(--display);letter-spacing:-.01em}
.section-shell{padding:clamp(52px,6vh,72px) clamp(48px,7.6vw,118px)}.section-heading{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.55fr);align-items:end;gap:50px}.section-heading>span{grid-column:1/-1}.section-heading h2,.debate h2,.brasilia h2{margin:16px 0 0;font:700 clamp(48px,4.6vw,70px)/.9 var(--display);letter-spacing:-.065em;text-transform:uppercase;text-wrap:balance}.section-heading>p{margin:0 0 5px;font:500 18px/1.3 var(--display)}
