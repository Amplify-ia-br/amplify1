---
import PageShell from "@/layouts/PageShell.astro";
import logoAmplify from "@/assets/logo-amplify-branco.png";

const logoSrc = logoAmplify.src;
---
<PageShell
  title="Ana | Estrategista de IA da Amplify"
  description="Converse com a Ana, estrategista de IA da Amplify, para qualificar oportunidades de aplicacao de IA na sua empresa."
>
  <main class="ana-page" data-stage="intro">
    <header class="ana-header" aria-label="Amplify">
      <a href="/" class="ana-logo-link" aria-label="Voltar para a pagina inicial da Amplify">
        <img src={logoSrc} alt="Amplify" width="160" height="32" class="ana-logo" />
      </a>
      <span class="ana-header-status" data-phase-label>Pronta para conversar</span>
    </header>

    <section class="ana-shell" aria-labelledby="ana-title">
      <div class="ana-grid">
        <div class="ana-presence-panel">
          <div class="ana-presence" aria-hidden="true">
            <div class="ana-orbit ana-orbit-one"></div>
            <div class="ana-orbit ana-orbit-two"></div>
            <div class="ana-orbit ana-orbit-three"></div>
            <div class="ana-avatar" data-avatar>
              <span></span>
            </div>
          </div>
          <div class="ana-signal">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>

        <div class="ana-experience">
          <div class="ana-copy">
            <p class="ana-kicker">Amplify AI Strategy</p>
            <h1 id="ana-title">Ana</h1>
            <p class="ana-status" data-status>
              Antes de começar, me diga seu nome e email. Depois eu faço quatro perguntas rápidas para entender onde a IA pode gerar mais impacto na sua operação.
            </p>
          </div>

          <form class="ana-form" data-lead-form>
            <label>
              Nome
              <div class="ana-field-row">
                <input data-name-input name="name" type="text" autocomplete="name" placeholder="Seu nome" required />
                <button type="button" class="ana-icon-button" data-dictate="name" aria-label="Ditar nome">●</button>
              </div>
            </label>
            <label>
              Email
              <div class="ana-field-row">
                <input data-email-input name="email" type="email" autocomplete="email" placeholder="seu@email.com" required />
                <button type="button" class="ana-icon-button" data-dictate="email" aria-label="Ditar email">●</button>
              </div>
            </label>
            <button type="submit" class="ana-primary-button" data-start-button>Iniciar conversa com a Ana</button>
          </form>

          <div class="ana-conversation" data-conversation hidden>
            <div class="ana-answer-box">
              <p class="ana-question-label" data-answer-label>Resposta capturada</p>
              <p data-transcript>Pode responder quando a Ana terminar de falar.</p>
            </div>

            <form class="ana-text-fallback" data-answer-form hidden>
              <input data-answer-input type="text" autocomplete="off" placeholder="Digite sua resposta" />
              <button type="submit" class="ana-secondary-button">Enviar</button>
            </form>

            <div class="ana-actions">
              <button type="button" class="ana-primary-button" data-listen-button>Responder por voz</button>
              <button type="button" class="ana-secondary-button" data-type-button>Prefiro digitar</button>
              <button type="button" class="ana-ghost-button" data-repeat-button>Repetir fala</button>
            </div>
          </div>

          <p class="ana-error" data-error role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    const questions = [
      "Quantos colaboradores sua empresa tem hoje?",
      "Sua empresa já usa alguma ferramenta de IA no dia a dia?",
      "Qual área da operação você mais quer melhorar com tecnologia?",
      "O que te impede de avançar nisso hoje?",
    ];

    const introText =
      "Oi, sou a Ana, a estrategista de IA da Amplify. Vou te fazer algumas perguntas rápidas para entender como podemos ajudar sua empresa.";

    const finalText =
      "Perfeito, já tenho o suficiente para o time da Amplify entender seu contexto e avaliar onde a IA pode gerar mais impacto na sua operação.";

    const state = {
      currentQuestionIndex: 0,
      messages: [],
      answers: [],
      lead: { name: "", email: "" },
      lastAudioUrl: "",
      isBusy: false,
      isComplete: false,
      hasAutoListened: false,
    };

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const page = document.querySelector(".ana-page");
    const leadForm = document.querySelector("[data-lead-form]");
    const conversation = document.querySelector("[data-conversation]");
    const answerForm = document.querySelector("[data-answer-form]");
    const nameInput = document.querySelector("[data-name-input]");
    const emailInput = document.querySelector("[data-email-input]");
    const answerInput = document.querySelector("[data-answer-input]");
    const statusEl = document.querySelector("[data-status]");
    const transcriptEl = document.querySelector("[data-transcript]");
    const errorEl = document.querySelector("[data-error]");
    const avatar = document.querySelector("[data-avatar]");
    const listenButton = document.querySelector("[data-listen-button]");
    const repeatButton = document.querySelector("[data-repeat-button]");
    const typeButton = document.querySelector("[data-type-button]");
    const phaseLabel = document.querySelector("[data-phase-label]");
    const answerLabel = document.querySelector("[data-answer-label]");
    let recognition = null;
    let activeAudio = null;

    function setPhase(phase, label) {
      page.dataset.stage = phase;
      phaseLabel.textContent = label;
      avatar.classList.toggle("is-speaking", phase === "speaking" || phase === "processing");
      avatar.classList.toggle("is-listening", phase === "listening");
    }

    function setError(message = "") {
      errorEl.textContent = message;
    }

    function setBusy(isBusy) {
      state.isBusy = isBusy;
      document.querySelectorAll("button").forEach((button) => {
        button.disabled = isBusy && button !== repeatButton;
      });
    }

    function decodeHeaderText(value) {
      if (!value) return "";
      try {
        const binary = atob(value);
        const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
        return new TextDecoder().decode(bytes);
      } catch (_error) {
        return "";
      }
    }

    function createRecognition() {
      if (!SpeechRecognition) {
        showTextFallback("Seu navegador não liberou voz agora. Pode digitar sua resposta.");
        return null;
      }

      const instance = new SpeechRecognition();
      instance.lang = "pt-BR";
      instance.interimResults = false;
      instance.maxAlternatives = 1;
      return instance;
    }

    function normalizeDictatedEmail(value) {
      return value
        .toLowerCase()
        .replace(/\s+arroba\s+/g, "@")
        .replace(/\s+ponto\s+/g, ".")
        .replace(/\s+dot\s+/g, ".")
        .replace(/\s+/g, "");
    }

    function dictateField(fieldName) {
      const fieldRecognition = createRecognition();
      if (!fieldRecognition) return;

      setError("");
      fieldRecognition.onresult = (event) => {
        const transcript = event.results[0][0].transcript.trim();
        if (fieldName === "email") {
          emailInput.value = normalizeDictatedEmail(transcript);
          return;
        }
        nameInput.value = transcript;
      };
      fieldRecognition.onerror = () => {
        setError("Não consegui acessar o microfone agora. Você pode preencher este campo digitando.");
      };
      fieldRecognition.start();
    }

    function showTextFallback(message = "") {
      answerForm.hidden = false;
      answerInput.focus();
      if (message) setError(message);
    }

    function hideTextFallback() {
      answerForm.hidden = true;
      answerInput.value = "";
    }

    async function requestAnaSpeech(text, { autoListen = true, storeAssistantMessage = true } = {}) {
      setBusy(true);
      setError("");
      setPhase("processing", "Ana pensando");
      statusEl.textContent = "Ana está pensando...";

      try {
        const response = await fetch("/api/ana-speak", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            messages: state.messages,
            currentQuestion: text,
          }),
        });

        if (!response.ok) {
          const errorPayload = await response.json().catch(() => ({}));
          throw new Error(errorPayload.error || "Não foi possível gerar a fala da Ana.");
        }

        const anaText = decodeHeaderText(response.headers.get("x-ana-text")) || text;
        const audioBlob = await response.blob();

        if (state.lastAudioUrl) URL.revokeObjectURL(state.lastAudioUrl);
        state.lastAudioUrl = URL.createObjectURL(audioBlob);
        statusEl.textContent = anaText;
        if (storeAssistantMessage) state.messages.push({ role: "assistant", content: anaText });

        setPhase("speaking", "Ana falando");
        await playAudio(state.lastAudioUrl);

        if (autoListen && !state.isComplete) {
          window.setTimeout(() => listenForAnswer({ automatic: true }), 280);
        } else if (!state.isComplete) {
          setPhase("ready", "Pode responder agora");
        }
      } catch (error) {
        statusEl.textContent = text;
        setPhase("ready", "Pode responder agora");
        showTextFallback(error.message || "A Ana não conseguiu falar agora. Pode seguir digitando sua resposta.");
      } finally {
        setBusy(false);
      }
    }

    function playAudio(url) {
      return new Promise((resolve) => {
        if (activeAudio) {
          activeAudio.pause();
          activeAudio = null;
        }

        activeAudio = new Audio(url);
        activeAudio.onended = resolve;
        activeAudio.onerror = resolve;
        activeAudio.play().catch(resolve);
      });
    }

    async function startConversation(event) {
      event.preventDefault();
      const name = nameInput.value.trim();
      const email = emailInput.value.trim();

      if (!name || !email) {
        setError("Antes de falar com a Ana, preencha nome e email.");
        return;
      }

      state.lead = { name, email };
      state.messages = [{ role: "user", content: `Meu nome é ${name} e meu email é ${email}.` }];
      leadForm.hidden = true;
      conversation.hidden = false;
      transcriptEl.textContent = "A Ana vai conduzir. Quando ela terminar, é só responder naturalmente.";
      await requestAnaSpeech(`${introText} ${questions[0]}`);
    }

    function listenForAnswer({ automatic = false } = {}) {
      if (state.isBusy || state.isComplete) return;
      recognition = createRecognition();
      if (!recognition) return;

      setError("");
      hideTextFallback();
      setPhase("listening", "Pode responder agora");
      transcriptEl.textContent = automatic ? "Pode responder agora." : "Estou ouvindo...";
      listenButton.disabled = true;

      recognition.onresult = async (event) => {
        const answer = event.results[0][0].transcript.trim();
        listenButton.disabled = false;

        if (!isValidAnswer(answer)) {
          transcriptEl.textContent = "Não consegui ouvir bem.";
          showTextFallback("Pode repetir ou digitar sua resposta.");
          setPhase("ready", "Pode responder agora");
          return;
        }

        await handleAnswer(answer);
      };

      recognition.onerror = () => {
        listenButton.disabled = false;
        transcriptEl.textContent = "Não consegui ouvir bem.";
        showTextFallback("Seu microfone não respondeu agora. Pode digitar sua resposta.");
        setPhase("ready", "Pode responder agora");
      };

      recognition.onend = () => {
        listenButton.disabled = false;
        if (!state.isBusy && !state.isComplete && page.dataset.stage === "listening") {
          setPhase("ready", "Pode responder agora");
        }
      };

      recognition.start();
    }

    function isValidAnswer(answer) {
      return answer && answer.replace(/\s/g, "").length >= 3;
    }

    async function handleAnswer(answer) {
      hideTextFallback();
      transcriptEl.textContent = answer;
      answerLabel.textContent = `Resposta ${state.currentQuestionIndex + 1} de ${questions.length}`;
      state.answers[state.currentQuestionIndex] = answer;
      state.messages.push({
        role: "user",
        content: `${questions[state.currentQuestionIndex]} Resposta: ${answer}`,
      });
      state.currentQuestionIndex += 1;

      if (state.currentQuestionIndex >= questions.length) {
        await finishConversation();
        return;
      }

      await requestAnaSpeech(questions[state.currentQuestionIndex]);
    }

    async function finishConversation() {
      state.isComplete = true;
      setPhase("processing", "Concluindo");
      await requestAnaSpeech(finalText, { autoListen: false, storeAssistantMessage: false });
      await submitLead();
    }

    async function submitLead() {
      setBusy(true);
      setPhase("processing", "Enviando contexto");
      statusEl.textContent = "Recebi seu contexto. Estou preparando o próximo passo com a equipe da Amplify.";

      try {
        const response = await fetch("/api/ana-lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: state.lead.name,
            email: state.lead.email,
            resposta_1: state.answers[0],
            resposta_2: state.answers[1],
            resposta_3: state.answers[2],
            resposta_4: state.answers[3],
          }),
        });

        if (!response.ok) {
          const errorPayload = await response.json().catch(() => ({}));
          throw new Error(errorPayload.error || "Não foi possível criar o lead.");
        }

        setPhase("complete", "Contexto recebido");
        statusEl.textContent = "Recebi seu contexto. A equipe da Amplify vai avaliar onde a IA pode gerar mais impacto na sua operação.";
        transcriptEl.textContent = "Conversa concluída.";
        listenButton.hidden = true;
        typeButton.hidden = true;
        answerForm.hidden = true;
      } catch (error) {
        console.error("Ana lead submission failed:", error);
        setPhase("complete", "Contexto recebido");
        statusEl.textContent = "Recebi seu contexto. A equipe da Amplify vai avaliar onde a IA pode gerar mais impacto na sua operação.";
        transcriptEl.textContent = "Conversa concluída.";
        listenButton.hidden = true;
        typeButton.hidden = true;
        answerForm.hidden = true;
        setError("");
      } finally {
        setBusy(false);
      }
    }

    leadForm.addEventListener("submit", startConversation);
    listenButton.addEventListener("click", () => listenForAnswer({ automatic: false }));
    repeatButton.addEventListener("click", () => {
      if (state.lastAudioUrl && !state.isBusy) {
        setPhase("speaking", "Ana falando");
        playAudio(state.lastAudioUrl).then(() => {
          if (!state.isComplete) setPhase("ready", "Pode responder agora");
        });
      }
    });
    typeButton.addEventListener("click", () => showTextFallback());
    answerForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const answer = answerInput.value.trim();
      if (!isValidAnswer(answer)) {
        setError("Digite uma resposta um pouco mais completa.");
        return;
      }
      await handleAnswer(answer);
    });

    document.querySelectorAll("[data-dictate]").forEach((button) => {
      button.addEventListener("click", () => dictateField(button.dataset.dictate));
    });
  </script>

  <style>
    .ana-page {
      height: 100svh;
      overflow: hidden;
      background:
        radial-gradient(circle at 50% 48%, hsl(var(--primary) / 0.18), transparent 24rem),
        radial-gradient(circle at 76% 18%, rgba(255,255,255,0.08), transparent 18rem),
        linear-gradient(145deg, #050607 0%, hsl(var(--background)) 58%, #030404 100%);
      color: hsl(var(--foreground));
    }

    .ana-page::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(hsl(var(--foreground) / 0.035) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--foreground) / 0.025) 1px, transparent 1px);
      background-size: 4.5rem 4.5rem;
      mask-image: radial-gradient(circle at center, black, transparent 72%);
    }

    .ana-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 4.5rem;
      padding: 0 clamp(1rem, 4vw, 3rem);
      border-bottom: 1px solid hsl(var(--border) / 0.6);
      background: rgba(5, 6, 7, 0.72);
      backdrop-filter: blur(18px);
    }

    .ana-logo-link {
      display: inline-flex;
      align-items: center;
    }

    .ana-logo {
      height: 1.65rem;
      width: auto;
    }

    .ana-header-status {
      color: hsl(var(--muted-foreground));
      font-size: 0.82rem;
      font-weight: 600;
    }

    .ana-shell {
      height: 100%;
      width: min(100%, 82rem);
      margin: 0 auto;
      padding: 5.2rem clamp(1rem, 3vw, 2.5rem) 1.4rem;
      display: grid;
      align-items: center;
    }

    .ana-grid {
      display: grid;
      grid-template-columns: minmax(17rem, 0.92fr) minmax(22rem, 1fr);
      align-items: center;
      gap: clamp(1.4rem, 4vw, 4.5rem);
      height: min(100%, 42rem);
    }

    .ana-presence-panel {
      display: grid;
      justify-items: center;
      gap: 1rem;
    }

    .ana-presence {
      position: relative;
      width: min(34vw, 24rem);
      min-width: 17rem;
      aspect-ratio: 1;
      display: grid;
      place-items: center;
    }

    .ana-avatar,
    .ana-orbit {
      position: absolute;
      border-radius: 999px;
    }

    .ana-avatar {
      width: 42%;
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border: 1px solid hsl(var(--primary) / 0.62);
      background:
        radial-gradient(circle at 42% 32%, rgba(255,255,255,0.95), transparent 0.42rem),
        radial-gradient(circle at center, hsl(var(--primary) / 0.34), hsl(var(--card)) 66%);
      box-shadow:
        0 0 46px hsl(var(--primary) / 0.34),
        inset 0 0 42px hsl(var(--primary) / 0.12);
      transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .ana-avatar span {
      width: 32%;
      aspect-ratio: 1;
      border-radius: 999px;
      background: hsl(var(--primary));
      box-shadow: 0 0 32px hsl(var(--primary) / 0.8);
    }

    .ana-orbit {
      inset: 20%;
      border: 1px solid hsl(var(--primary) / 0.24);
      animation: ana-pulse 3s ease-in-out infinite;
    }

    .ana-orbit-two {
      inset: 9%;
      animation-delay: 0.4s;
    }

    .ana-orbit-three {
      inset: 0;
      border-color: hsl(var(--foreground) / 0.08);
      animation-delay: 0.8s;
    }

    .ana-page[data-stage="speaking"] .ana-orbit,
    .ana-page[data-stage="listening"] .ana-orbit,
    .ana-page[data-stage="processing"] .ana-orbit {
      animation-duration: 1.12s;
      border-color: hsl(var(--primary) / 0.62);
    }

    .ana-page[data-stage="listening"] .ana-avatar {
      transform: scale(1.04);
      box-shadow:
        0 0 72px hsl(var(--primary) / 0.42),
        inset 0 0 42px hsl(var(--primary) / 0.16);
    }

    .ana-signal {
      height: 1.9rem;
      display: flex;
      align-items: center;
      gap: 0.34rem;
      opacity: 0.72;
    }

    .ana-signal span {
      width: 0.18rem;
      height: 0.65rem;
      border-radius: 999px;
      background: hsl(var(--primary));
      animation: ana-bars 1.2s ease-in-out infinite;
      transform-origin: center;
    }

    .ana-signal span:nth-child(2) { animation-delay: 0.12s; }
    .ana-signal span:nth-child(3) { animation-delay: 0.24s; }
    .ana-signal span:nth-child(4) { animation-delay: 0.36s; }
    .ana-signal span:nth-child(5) { animation-delay: 0.48s; }

    .ana-experience {
      display: grid;
      gap: clamp(1rem, 2vh, 1.35rem);
      min-width: 0;
    }

    .ana-copy {
      display: grid;
      gap: 0.7rem;
    }

    .ana-kicker {
      margin: 0;
      color: hsl(var(--primary));
      font-size: 0.76rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    .ana-copy h1 {
      margin: 0;
      font-size: clamp(4rem, 9vw, 7.2rem);
      line-height: 0.88;
      letter-spacing: 0;
    }

    .ana-status {
      min-height: 5.4rem;
      margin: 0;
      color: hsl(var(--foreground) / 0.82);
      font-size: clamp(1rem, 1.8vw, 1.26rem);
      line-height: 1.46;
      max-width: 42rem;
    }

    .ana-form,
    .ana-conversation {
      width: min(100%, 34rem);
      display: grid;
      gap: 0.78rem;
    }

    .ana-form label {
      display: grid;
      gap: 0.36rem;
      text-align: left;
      color: hsl(var(--muted-foreground));
      font-size: 0.82rem;
      font-weight: 700;
    }

    .ana-field-row {
      display: grid;
      grid-template-columns: 1fr 2.7rem;
      gap: 0.55rem;
    }

    .ana-form input,
    .ana-text-fallback input {
      min-height: 2.82rem;
      border: 1px solid hsl(var(--border));
      border-radius: 0.5rem;
      padding: 0 0.92rem;
      background: rgba(14, 16, 18, 0.78);
      color: hsl(var(--foreground));
      outline: none;
    }

    .ana-form input:focus,
    .ana-text-fallback input:focus {
      border-color: hsl(var(--primary));
      box-shadow: 0 0 0 3px hsl(var(--primary) / 0.12);
    }

    .ana-icon-button,
    .ana-primary-button,
    .ana-secondary-button,
    .ana-ghost-button {
      min-height: 2.85rem;
      border-radius: 0.5rem;
      border: 1px solid transparent;
      font: inherit;
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      transition: transform 160ms ease, opacity 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .ana-icon-button {
      background: hsl(var(--secondary));
      color: hsl(var(--primary));
      font-size: 0.96rem;
    }

    .ana-primary-button {
      background: hsl(var(--primary));
      color: hsl(var(--primary-foreground));
      box-shadow: 0 0 22px hsl(var(--cyan) / 0.28), 0 0 48px hsl(var(--cyan) / 0.08);
    }

    .ana-secondary-button,
    .ana-ghost-button {
      background: rgba(255,255,255,0.035);
      color: hsl(var(--foreground));
      border-color: hsl(var(--border));
    }

    .ana-ghost-button {
      color: hsl(var(--muted-foreground));
    }

    .ana-icon-button:hover,
    .ana-primary-button:hover,
    .ana-secondary-button:hover,
    .ana-ghost-button:hover {
      transform: translateY(-1px);
      border-color: hsl(var(--primary) / 0.5);
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.58;
      transform: none;
    }

    .ana-answer-box {
      min-height: 6.5rem;
      display: grid;
      align-content: center;
      gap: 0.5rem;
      border: 1px solid hsl(var(--border));
      border-radius: 0.5rem;
      padding: 1rem;
      background: rgba(14, 16, 18, 0.68);
      text-align: left;
    }

    .ana-question-label {
      margin: 0;
      color: hsl(var(--primary));
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    .ana-answer-box p:last-child {
      margin: 0;
      color: hsl(var(--foreground));
      line-height: 1.45;
    }

    .ana-text-fallback {
      display: grid;
      grid-template-columns: 1fr 6rem;
      gap: 0.6rem;
    }

    .ana-actions {
