---
import PageShell from "@/layouts/PageShell.astro";
import logoAmplify from "@/assets/logo-amplify-branco.png";
import heroBook from "@/assets/mockup-livro.png";

const logoSrc = logoAmplify.src;
const heroBookSrc = heroBook.src;
---
<PageShell
  title="O Profissional Nexialista | Amplify"
  description="Baixe o e-book O Profissional Nexialista e descubra como ligar IA à estratégia, aos processos e às decisões que movem a empresa."
  chatbot={false}
>
  <main class="nex-page">
    <header class="nex-header" aria-label="Amplify">
      <a href="/" class="nex-logo-link" aria-label="Voltar para a pagina inicial da Amplify">
        <img src={logoSrc} alt="Amplify" width="160" height="32" class="nex-logo" />
      </a>
      <nav class="nex-header-nav" aria-label="Navegação da página">
        <a class="nex-header-link" href="#tensao">Tese</a>
        <a class="nex-header-link" href="#entender">Conteúdo</a>
        <a class="nex-header-link" href="#diagnostico">Diagnóstico</a>
      </nav>
    </header>

    <section class="nex-hero" aria-labelledby="nex-title">
      <div class="nex-ambient" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="nex-hero-copy">
        <p class="nex-kicker">E-book executivo + diagnóstico de 3 minutos</p>
        <h1 id="nex-title">
          <span>Quem formula melhor</span>
          <span>decide melhor.</span>
        </h1>
        <p class="nex-lead">Um guia para executivos que precisam tirar a IA do improviso.</p>
        <p class="nex-author">Por Fernando Godoy, CEO e cofundador da Amplify.</p>
        <div class="nex-actions">
          <a class="nex-primary" href="#diagnostico">Descobrir meu perfil nexialista</a>
          <a class="nex-secondary" href="#entender">Ler o ebook gratuito</a>
        </div>
      </div>

      <div class="nex-hero-visual" aria-hidden="true">
        <img src={heroBookSrc} alt="" class="nex-hero-book" width="380" height="558" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </section>

    <section id="tensao" class="nex-section nex-tension" aria-label="Tensão executiva com IA">
      <h2>IA virou iniciativa de área quando deveria virar capacidade da empresa.</h2>
    </section>

    <section class="nex-section nex-for" aria-label="Para quem é este e-book">
      <div>
        <p class="nex-kicker">Para quem é</p>
        <h2>Três formas de reconhecer que este material é para você.</h2>
      </div>
      <div class="nex-for-grid">
        <article>
          <h3>Você lidera uma empresa</h3>
          <p>Precisa que a IA vire decisão, não experimento.</p>
        </article>
        <article>
          <h3>Você gerencia equipes</h3>
          <p>Quer que seu time use IA com método, não no improviso.</p>
        </article>
        <article>
          <h3>Você quer se reposicionar</h3>
          <p>Precisa de uma linguagem para o que já faz intuitivamente.</p>
        </article>
      </div>
    </section>

    <section id="entender" class="nex-section nex-understand" aria-label="O que você vai entender">
      <div>
        <p class="nex-kicker">O que você vai entender</p>
        <h2>Três ideias para usar IA com mais critério.</h2>
      </div>
      <ol class="nex-understand-list">
        <li><span>01</span><p>A diferença real entre especialista, generalista e nexialista</p></li>
        <li><span>02</span><p>Como as cinco bases se constroem e se reforçam</p></li>
        <li><span>03</span><p>Como aplicar pensamento nexialista em decisões com IA</p></li>
      </ol>
    </section>

    <section id="diagnostico" class="nex-section nex-diagnostic" aria-labelledby="diagnostico-title">
      <div class="nex-diagnostic-copy">
        <p class="nex-kicker">Incentivo Nexialista</p>
        <h2 id="diagnostico-title">Descubra seu nível de prontidão nexialista.</h2>
        <p>
          O e-book custa R$ 127. Mas a Amplify quer incentivar líderes que têm contexto real, campo de aplicação e problemas relevantes para aplicar pensamento nexialista dentro de uma organização.
        </p>
        <p class="nex-time">Em menos de 3 minutos, suas respostas ajudam a identificar seu perfil de aplicação e o nível de incentivo disponível para o seu acesso.</p>
        <ul>
          <li class="nex-incentive-highlight">
            <span>Incentivo para perfil Nexialista: Gratuito</span>
            <span class="nex-tooltip" tabindex="0" aria-label="O acesso gratuito depende do resultado do diagnóstico.">
              ?
              <span role="tooltip">Depende do resultado do diagnóstico.</span>
            </span>
          </li>
          <li>Incentivo avançado: R$ 37</li>
          <li>Incentivo parcial: R$ 67</li>
          <li>Valor integral: R$ 127</li>
        </ul>
        <p class="nex-fineprint">O incentivo depende do perfil de aplicação identificado no diagnóstico.</p>
      </div>

      <div class="nex-diagnostic-form-column">
        <div class="nex-form-shell">
        <div class="nex-form-top">
          <span data-step-name>Identidade</span>
          <strong data-step-counter>1 de 6</strong>
        </div>
        <div class="nex-progress" aria-hidden="true">
          <span data-progress-bar></span>
        </div>
        <form class="nex-form" data-nex-form novalidate>
          <fieldset class="nex-step is-active" data-step="0">
            <h3>Comece seu diagnóstico</h3>
            <p class="nex-step-copy">Leva menos de 3 minutos. Ao final, você verá seu nível de prontidão nexialista e o incentivo disponível para acessar o e-book.</p>
            <label>Nome<input name="name" autocomplete="name" required placeholder="Seu nome" /></label>
            <label>Email<input name="email" type="email" autocomplete="email" required placeholder="seuemail@empresa.com" /></label>
            <label>WhatsApp <small>opcional, para receber seu resultado</small><input name="phone" autocomplete="tel" placeholder="DDD + número" /></label>
          </fieldset>

          <fieldset class="nex-step" data-step="1">
            <h3>Qual é seu escopo de decisão e influência?</h3>
            <label>Cargo
              <select name="role" required>
                <option value="">Selecione</option>
                <option value="CEO / Founder">CEO / Founder</option>
                <option value="C-level">C-level</option>
                <option value="Diretoria">Diretoria</option>
                <option value="Gerente">Gerente</option>
                <option value="Especialista / coordenação">Especialista / coordenação</option>
                <option value="Outro">Outro</option>
              </select>
            </label>
            <label>Empresa<input name="company" required placeholder="Nome da empresa" /></label>
            <label>Tamanho da organização
              <select name="companySize" required>
                <option value="">Selecione</option>
                <option value="self-employed">Autônomo ou independente</option>
                <option value="1-10">1 a 10 pessoas</option>
                <option value="11-50">11 a 50 pessoas</option>
                <option value="51-200">51 a 200 pessoas</option>
                <option value="201-500">201 a 500 pessoas</option>
                <option value="501-1000">501 a 1.000 pessoas</option>
                <option value="1001-5000">1.001 a 5.000 pessoas</option>
                <option value="5001-10000">5.001 a 10.000 pessoas</option>
                <option value="10001+">10.001+ pessoas</option>
              </select>
            </label>
          </fieldset>

          <fieldset class="nex-step" data-step="2">
            <h3>Qual problema merece IA de verdade?</h3>
            <label>Segmento
              <select name="segment" required>
                <option value="">Selecione</option>
                <option value="Serviços">Serviços</option>
                <option value="Indústria">Indústria</option>
                <option value="Educação">Educação</option>
                <option value="Saúde">Saúde</option>
                <option value="Construção / engenharia">Construção / engenharia</option>
                <option value="Tecnologia">Tecnologia</option>
                <option value="Outro">Outro</option>
              </select>
            </label>
            <label>Principal desafio de negócio hoje
              <textarea name="businessChallenge" required rows="4" placeholder="Ex: reduzir retrabalho entre áreas, acelerar atendimento sem perder qualidade, usar dados na decisão comercial..."></textarea>
            </label>
          </fieldset>

          <fieldset class="nex-step" data-step="3">
            <h3>Como a IA está sendo usada na prática?</h3>
            <p class="nex-field-context">Isso nos ajuda a entender onde você está — sem julgamento.</p>
            <label>Uso atual de IA
              <select name="aiUsage" required>
                <option value="">Selecione</option>
                <option value="Não usa ainda">Não usa ainda</option>
                <option value="Uso individual informal">Uso individual informal</option>
                <option value="Algumas ferramentas em áreas específicas">Algumas ferramentas em áreas específicas</option>
                <option value="Projetos estruturados em andamento">Projetos estruturados em andamento</option>
                <option value="IA integrada a processos críticos">IA integrada a processos críticos</option>
              </select>
            </label>
            <label>Maturidade em IA
              <select name="aiMaturity" required>
                <option value="">Selecione</option>
                <option value="Explorando">Explorando</option>
                <option value="Testando">Testando</option>
                <option value="Implementando">Implementando</option>
                <option value="Escalando">Escalando</option>
              </select>
            </label>
          </fieldset>

          <fieldset class="nex-step" data-step="4">
            <h3>Qual movimento mudaria o resultado?</h3>
            <label>Próximo passo desejado com IA
              <textarea name="aiNextStep" required rows="4" placeholder="Descreva o próximo movimento que faria a IA gerar resultado visível na organização."></textarea>
            </label>
            <label>Você quer um diagnóstico com a Amplify?
              <select name="diagnosisInterest" required>
                <option value="">Selecione</option>
                <option value="sim">Sim, quero avaliar um diagnóstico</option>
                <option value="talvez">Talvez, quero entender melhor</option>
                <option value="nao">Não agora, quero apenas o e-book</option>
              </select>
            </label>
          </fieldset>

          <fieldset class="nex-step" data-step="5">
            <h3>Já houve investimento real?</h3>
            <label>Investimento em IA nos últimos 12 meses
              <select name="aiInvestment" required>
                <option value="">Selecione</option>
                <option value="Ainda não investiu">Ainda não investiu</option>
                <option value="Até R$ 10 mil">Até R$ 10 mil</option>
                <option value="R$ 10 mil a R$ 50 mil">R$ 10 mil a R$ 50 mil</option>
                <option value="R$ 50 mil a R$ 200 mil">R$ 50 mil a R$ 200 mil</option>
                <option value="Acima de R$ 200 mil">Acima de R$ 200 mil</option>
              </select>
            </label>
            <label>Já contratou programa ou consultoria de IA?
              <select name="aiConsulting" required>
                <option value="">Selecione</option>
                <option value="Não">Não</option>
                <option value="Sim, até R$ 20 mil">Sim, até R$ 20 mil</option>
                <option value="Sim, R$ 20 mil a R$ 100 mil">Sim, R$ 20 mil a R$ 100 mil</option>
                <option value="Sim, acima de R$ 100 mil">Sim, acima de R$ 100 mil</option>
              </select>
            </label>
          </fieldset>

          <div class="nex-form-actions">
            <button type="button" class="nex-secondary" data-prev disabled>Voltar</button>
            <button type="button" class="nex-primary" data-next>Continuar diagnóstico</button>
            <button type="submit" class="nex-primary" data-submit hidden>Revelar meu perfil</button>
          </div>
          <p class="nex-form-note">Seu resultado será calculado a partir das suas respostas.</p>
          <p class="nex-form-error" data-form-error role="status" aria-live="polite"></p>
        </form>

        <section class="nex-result" data-result hidden aria-live="polite">
          <p class="nex-step-label">Resultado</p>
          <h3 data-result-title></h3>
          <p data-result-copy></p>
          <div class="nex-result-meter" aria-hidden="true">
            <span data-result-meter></span>
          </div>
          <div class="nex-result-grid">
            <div>
              <span>Nível</span>
              <strong data-result-level></strong>
            </div>
            <div>
              <span>Incentivo</span>
              <strong data-result-incentive></strong>
            </div>
          </div>
          <div class="nex-result-price">
            <span>Seu acesso</span>
            <strong data-result-price></strong>
          </div>
          <div class="nex-downloads" data-free-downloads hidden>
          </div>
          <div class="nex-result-actions">
            <button type="button" class="nex-primary" data-checkout hidden>Ativar meu incentivo</button>
            <a class="nex-secondary" href="/contato?origem=nexialista-diagnostico" target="_blank" rel="noopener noreferrer">Solicitar diagnóstico</a>
          </div>
          <p class="nex-form-error" data-result-error role="status" aria-live="polite"></p>
        </section>
      </div>
      </div>
    </section>

    <section class="nex-section nex-faq" aria-label="Dúvidas comuns">
      <div>
        <p class="nex-kicker">Dúvidas comuns</p>
        <h2>Antes de começar</h2>
      </div>
      <div class="nex-faq-list">
        <details>
          <summary>O diagnóstico é gratuito?</summary>
          <p>Sim. Ele leva menos de 3 minutos e identifica seu perfil de aplicação.</p>
        </details>
        <details>
          <summary>Preciso informar cartão?</summary>
          <p>Não para fazer o diagnóstico. Cartão só aparece se o seu resultado indicar acesso pago.</p>
        </details>
        <details>
          <summary>O e-book é técnico?</summary>
          <p>Não. Ele foi criado para líderes que precisam conectar IA à estratégia, processos, pessoas e decisões de negócio.</p>
        </details>
        <details>
          <summary>O que significa “nexialista”?</summary>
          <p>É o profissional capaz de atravessar áreas, conectar repertórios e resolver problemas inteiros, em vez de otimizar partes isoladas.</p>
        </details>
        <details>
          <summary>O incentivo é garantido?</summary>
          <p>Não. O incentivo depende do perfil identificado no diagnóstico.</p>
        </details>
      </div>
    </section>
  </main>

  <script is:inline>
    const form = document.querySelector("[data-nex-form]");
    const steps = [...document.querySelectorAll("[data-step]")];
    const progressBar = document.querySelector("[data-progress-bar]");
    const prevButton = document.querySelector("[data-prev]");
    const nextButton = document.querySelector("[data-next]");
    const submitButton = document.querySelector("[data-submit]");
    const formError = document.querySelector("[data-form-error]");
    const resultSection = document.querySelector("[data-result]");
    const resultTitle = document.querySelector("[data-result-title]");
    const resultCopy = document.querySelector("[data-result-copy]");
    const resultPrice = document.querySelector("[data-result-price]");
    const resultLevel = document.querySelector("[data-result-level]");
    const resultIncentive = document.querySelector("[data-result-incentive]");
    const resultMeter = document.querySelector("[data-result-meter]");
    const resultError = document.querySelector("[data-result-error]");
    const checkoutButton = document.querySelector("[data-checkout]");
    const freeDownloads = document.querySelector("[data-free-downloads]");
    const stepName = document.querySelector("[data-step-name]");
    const stepCounter = document.querySelector("[data-step-counter]");
    const stepNames = ["Identidade", "Contexto", "Desafio", "IA", "Próximo passo", "Investimento"];

    let currentStep = 0;
    let lastPayload = null;
    let lastFreeAccessUrl = "";

    function setStep(index) {
      currentStep = index;
      steps.forEach((step, stepIndex) => step.classList.toggle("is-active", stepIndex === currentStep));
      prevButton.disabled = currentStep === 0;
      nextButton.hidden = currentStep === steps.length - 1;
      submitButton.hidden = currentStep !== steps.length - 1;
      progressBar.style.width = `${((currentStep + 1) / steps.length) * 100}%`;
      stepName.textContent = stepNames[currentStep];
      stepCounter.textContent = `${currentStep + 1} de ${steps.length}`;
      formError.textContent = "";
    }

    function getCurrentFields() {
      return [...steps[currentStep].querySelectorAll("input, select, textarea")];
    }

    function getFieldLabel(field) {
      const label = field.closest("label");
      return label ? label.childNodes[0].textContent.trim() : "campo obrigatório";
    }

    function validateCurrentStep() {
      const fields = getCurrentFields();
      const invalidField = fields.find((field) => {
        if (!field.required) return false;
        return !String(field.value || "").trim();
      });

      if (invalidField) {
        formError.textContent = `Preencha o campo: ${getFieldLabel(invalidField)}.`;
        invalidField.focus({ preventScroll: true });
        return false;
      }

      formError.textContent = "";
      return true;
    }

    function getFormData() {
      return Object.fromEntries(new FormData(form).entries());
    }

    function includesAny(value, options) {
      return options.some((option) => String(value || "").toLowerCase().includes(option.toLowerCase()));
    }

    function getScoreSignals(data) {
      const role = String(data.role || "");
      const companySize = String(data.companySize || "");
      const segment = String(data.segment || "");
      const aiUsage = String(data.aiUsage || "");
      const aiMaturity = String(data.aiMaturity || "");
      const aiInvestment = String(data.aiInvestment || "");
      const aiConsulting = String(data.aiConsulting || "").toLowerCase();
      const businessChallengeLength = String(data.businessChallenge || "").trim().length;
      const aiNextStepLength = String(data.aiNextStep || "").trim().length;

      return {
        isDecisionMaker: ["CEO / Founder", "C-level", "Diretoria"].includes(role),
        isManager: role === "Gerente",
        hasIcpRole: ["CEO / Founder", "C-level", "Diretoria", "Gerente"].includes(role),
        hasIcpSize: ["51-200", "201-500", "501-1000"].includes(companySize),
        hasNearIcpSize: ["11-50", "1001-5000"].includes(companySize),
        hasLargeNonIcpSize: ["5001-10000", "10001+"].includes(companySize),
        isPrioritySegment: ["Serviços", "Indústria", "Educação", "Saúde", "Construção / engenharia"].includes(segment),
        hasClearChallenge: businessChallengeLength >= 80,
        hasSomeChallenge: businessChallengeLength >= 30,
        hasStructuredAi: ["Projetos estruturados em andamento", "IA integrada a processos críticos"].includes(aiUsage),
        hasSomeAiUse: ["Uso individual informal", "Algumas ferramentas em áreas específicas"].includes(aiUsage),
        hasAdvancedMaturity: ["Implementando", "Escalando"].includes(aiMaturity),
        hasTestingMaturity: aiMaturity === "Testando",
        hasRelevantInvestment: ["R$ 50 mil a R$ 200 mil", "Acima de R$ 200 mil"].includes(aiInvestment),
        hasSomeInvestment: ["Até R$ 10 mil", "R$ 10 mil a R$ 50 mil"].includes(aiInvestment),
        hasRelevantConsulting: aiConsulting.includes("acima") || aiConsulting.includes("r$ 20 mil a"),
        hasSomeConsulting: aiConsulting.includes("até"),
        hasClearNextStep: aiNextStepLength >= 80,
        hasSomeNextStep: aiNextStepLength >= 30,
        wantsDiagnosis: data.diagnosisInterest === "sim",
        maybeWantsDiagnosis: data.diagnosisInterest === "talvez",
      };
    }

    function calculateScore(data) {
      const signals = getScoreSignals(data);
      let score = 0;

      if (signals.isDecisionMaker) score += 18;
      else if (signals.isManager) score += 11;
      else if (data.role) score += 5;

      if (signals.hasIcpSize) score += 18;
      else if (signals.hasNearIcpSize) score += 12;
      else if (signals.hasLargeNonIcpSize) score += 10;
      else if (data.companySize === "1-10") score += 4;
      else if (data.companySize === "self-employed") score += 2;

      if (signals.isPrioritySegment) score += 10;
      else if (data.segment) score += 4;

      if (signals.hasClearChallenge) score += 10;
      else if (signals.hasSomeChallenge) score += 5;

      if (signals.hasStructuredAi) score += 14;
      else if (signals.hasSomeAiUse) score += 8;
      else if (data.aiUsage) score += 3;

      if (signals.hasAdvancedMaturity) score += 12;
      else if (signals.hasTestingMaturity) score += 6;
      else if (data.aiMaturity) score += 3;

      if (signals.hasRelevantInvestment) score += 10;
      else if (signals.hasSomeInvestment) score += 5;

      if (signals.hasRelevantConsulting) score += 6;
      else if (signals.hasSomeConsulting) score += 3;

      if (signals.hasClearNextStep) score += 7;
      else if (signals.hasSomeNextStep) score += 4;

      if (signals.wantsDiagnosis) score += 7;
      else if (signals.maybeWantsDiagnosis) score += 3;

      return Math.min(score, 100);
    }

    function hasFreeAccessGate(data) {
      const signals = getScoreSignals(data);
      return (
        signals.hasIcpRole &&
        signals.hasIcpSize &&
        signals.isPrioritySegment
      );
    }

    function getCreditResult(score, data = {}) {
      if (hasFreeAccessGate(data) || score >= 68) {
        return {
          score,
          tier: "free",
          price: "Gratuito",
          label: "Incentivo integral",
          level: "Alto Potencial Nexialista",
          incentive: "100%",
          creditTag: "incentivo_nexialista_gratuito",
          title: "Você está no grupo que a Amplify quer perto.",
          copy: "Suas respostas indicam aderência ao perfil de aplicação que a Amplify quer aproximar deste material: escopo de decisão, porte, segmento ou sinais fortes de maturidade para transformar leitura em ação. Por isso, seu acesso ao e-book foi liberado de forma imediata.",
          cta: "Acesso gratuito e imediato",
        };
      }

      if (score >= 44) {
        return {
          score,
          tier: "partial",
          price: "R$ 67",
          label: "Incentivo parcial",
          level: "Potencial Nexialista em evolução",
          incentive: "R$ 60",
          creditTag: "incentivo_nexialista_67",
          title: "Você já vê que IA não se resolve só com ferramenta.",
          copy: "Suas respostas indicam repertório para ligar negócio, IA e operação. Ainda há espaço para amadurecer método e aplicação, então a Amplify reduziu o valor para facilitar seu acesso ao e-book.",
          cta: "Usar incentivo e acessar o e-book",
        };
      }

      return {
        score,
        tier: "full",
        price: "R$ 127",
        label: "Valor integral",
          level: "Sinal Inicial",
          incentive: "Valor integral",
          creditTag: "incentivo_nexialista_127",
          title: "Este é um bom ponto para começar com mais critério.",
          copy: "Suas respostas mostram que o próximo ganho está em repertório: entender onde a IA entra, onde atrapalha e como conectar áreas antes de investir mais tempo ou dinheiro.",
          cta: "Comprar o e-book",
      };
    }

    function spawnParticles() {
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReduced) return;

      for (let i = 0; i < 4; i++) {
        const particle = document.createElement("span");
        particle.style.cssText = `position:fixed;width:6px;height:6px;border-radius:50%;background:#2dd4bf;pointer-events:none;left:${30 + i * 14}%;bottom:20%;animation:nex-particle 600ms ease ${i * 80}ms both;z-index:9999`;
        document.body.appendChild(particle);
        setTimeout(() => particle.remove(), 800 + i * 80);
      }
    }

    function showResult(result) {
      form.hidden = true;
      resultSection.hidden = false;
      resultTitle.textContent = result.title;
      resultCopy.textContent = result.copy;
      resultPrice.textContent = result.price;
      resultLevel.textContent = result.level;
      resultIncentive.textContent = result.incentive && result.incentive !== "Não aplicado" ? result.incentive : "Valor integral";
      resultMeter.style.width = `${Math.max(result.score, 12)}%`;
      stepName.textContent = "Perfil revelado";
      stepCounter.textContent = "Resultado";
      progressBar.style.width = "100%";
      freeDownloads.hidden = true;
      checkoutButton.hidden = false;
      checkoutButton.textContent = result.cta;
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      resultSection.scrollIntoView({ behavior: prefersReduced ? "auto" : "smooth", block: "center" });
      spawnParticles();
    }

    async function submitLead(payload, { silent = false } = {}) {
      const response = await fetch("/api/nexialista-lead", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        const errorPayload = await response.json().catch(() => ({}));
        if (silent) return false;
        throw new Error(errorPayload.error || "Não foi possível registrar seu diagnóstico.");
      }

      return true;
    }

    async function readJson(response) {
      const text = await response.text();
      if (!text) return {};

      try {
        return JSON.parse(text);
      } catch (_error) {
        return { error: "O servidor retornou uma resposta inesperada." };
      }
    }

    async function ensureFreeAccess(payload) {
      if (lastFreeAccessUrl) return lastFreeAccessUrl;

      const accessResponse = await fetch("/api/nexialista-free", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: payload.email,
          name: payload.name,
          company: payload.company,
          tier: payload.result.tier,
        }),
      });
      const accessPayload = await readJson(accessResponse);

      if (!accessResponse.ok || !accessPayload.url) {
        throw new Error(accessPayload.error || "Acesso gratuito indisponível.");
      }

      lastFreeAccessUrl = accessPayload.url;
      return lastFreeAccessUrl;
    }

    function openInNewTab(url) {
      if (!url) return;

      const popupWindow = window.open(url, "_blank");
      if (popupWindow) {
        popupWindow.opener = null;
        return;
      }

      if (!popupWindow) {
        window.location.href = url;
      }
    }

    nextButton.addEventListener("click", async () => {
      if (!validateCurrentStep()) return;
      const data = getFormData();
      if (data.name && data.email) {
        submitLead({
          ...data,
          formStatus: "in_progress",
          completedStep: currentStep + 1,
          result: {
            label: "Diagnóstico incompleto",
            level: "Em andamento",
            price: "Não definido",
            score: "",
            copy: "Lead iniciou o diagnóstico Nexialista, mas ainda não concluiu.",
          },
        }, { silent: true });
      }
      setStep(Math.min(currentStep + 1, steps.length - 1));
    });

    prevButton.addEventListener("click", () => {
      setStep(Math.max(currentStep - 1, 0));
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!validateCurrentStep()) return;

      const data = getFormData();
      const result = getCreditResult(calculateScore(data), data);
      const payload = {
        ...data,
        formStatus: "completed",
        completedStep: steps.length,
        result,
      };
      lastPayload = payload;
      submitButton.disabled = true;
      formError.textContent = "Calculando e registrando seu diagnóstico...";

      try {
        await submitLead(payload);
        if (result.tier === "free") {
          formError.textContent = "Acesso liberado. Preparando envio por email...";
          await ensureFreeAccess(payload);
        }
        showResult(result);
      } catch (error) {
        formError.textContent = `${error.message} Mesmo assim, seu resultado será exibido agora.`;
        window.setTimeout(() => showResult(result), 900);
      } finally {
        submitButton.disabled = false;
      }
    });

    checkoutButton.addEventListener("click", async () => {
      if (!lastPayload) return;
      checkoutButton.disabled = true;
      resultError.textContent = "";

      try {
        if (lastPayload.result.tier === "free") {
          openInNewTab(await ensureFreeAccess(lastPayload));
          return;
        }

        const response = await fetch("/api/nexialista-checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: lastPayload.name,
            email: lastPayload.email,
            tier: lastPayload.result.tier,
            score: lastPayload.result.score,
            level: lastPayload.result.level,
            price: lastPayload.result.price,
          }),
        });
        const payload = await readJson(response);

        if (!response.ok || !payload.url) {
          throw new Error(payload.error || "Checkout indisponível.");
        }

        openInNewTab(payload.url);
      } catch (error) {
        resultError.textContent = lastPayload.result.tier === "free"
          ? error.message
          : `${error.message} Configure as variáveis do Stripe para ativar o pagamento.`;
        checkoutButton.disabled = false;
      }
    });

    setStep(0);
  </script>

