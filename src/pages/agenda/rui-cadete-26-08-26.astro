---
import PageShell from "@/layouts/PageShell.astro";
import logoAmplify from "@/assets/logo-amplify-branco.png";
import { getBootcampCheckoutUrl, getBootcampEventBySlug } from "@/lib/bootcamp-events.js";
import { BOOTCAMP_NATAL } from "@/lib/bootcamp-natal-content.js";

export const prerender = false;

const event = getBootcampEventBySlug("rui-cadete-26-08-26");
const content = BOOTCAMP_NATAL;
const checkoutUrl = event ? getBootcampCheckoutUrl(event, Astro.url) : "";
const eventTitle = "Bootcamp IA para Negócio";
const eventLongDate = "26 de agosto de 2026";
const eventAddress = "Rua Apodi, 209 - Cidade Alta, Natal - RN";
const eventTimeLabel = "Horário a confirmar";
const logoSrc = logoAmplify.src;
const heroSrc = "/bootcamp/rui-cadete/rui-cadete-hero.webp";
const partnerName = "Rui Cadete";
const partnerDescriptor = "RC Hub";
const ruiCadeteLogoSrc = "/bootcamp/rui-cadete/logo-rui-cadete-horizontal.webp";
const rcHubLogoSrc = "/bootcamp/rui-cadete/logo-rc-hub-official.webp";
const ruiCadeteOfficeSrc = "/bootcamp/rui-cadete/rui-cadete-office.webp";
const professorImage = content.templateAssets.mentor;
const companyNames = [
  "Contabilidade",
  "Bookkeeping",
  "Departamento Pessoal",
  "Finanças",
  "Tecnologia",
  "Pessoas",
  "Serviços especializados",
  "Co-working",
];

const mentorHighlights = [
  {
    title: "Pesquisa",
    copy: "IA aplicada ao aprendizado organizacional, estratégia e performance em empresas de alto crescimento.",
  },
  {
    title: "Implantação",
    copy: "Projetos de data science e IA conectados a receita, produto, analytics, go-to-market e operação comercial.",
  },
  {
    title: "Formação",
    copy: "Mestre pela Fundação Dom Cabral, doutorando pela Burgundy School of Business, Educador de IA e Head de Soluções da Amplify.",
  },
];

const roles = [
  "Empresário(a)",
  "Sócio(a) / CEO",
  "Diretor(a) financeiro",
  "Gestor(a) administrativo",
  "Controller / financeiro",
  "RH / departamento pessoal",
  "Comercial / operações",
  "Consultoria ou BPO",
];

const modules = [
  {
    title: "IA para produtividade empresarial",
    copy: "Como usar IA para acelerar leitura, síntese, planejamento, comunicação, atendimento e execução de tarefas sem transformar a operação em improviso.",
  },
  {
    title: "Dados, documentos e decisões",
    copy: "Como estruturar contexto, revisar respostas, preparar análises, apoiar documentos internos e transformar informação solta em insumo de decisão.",
  },
  {
    title: "Financeiro, atendimento e operação",
    copy: "Exemplos aplicados a rotinas administrativas, relatórios, cobrança, relacionamento com clientes, compras, RH, reuniões, follow-up e gestão de pendências.",
  },
  {
    title: "Da ferramenta ao método no negócio",
    copy: "Um roteiro para escolher casos de uso, priorizar ganhos reais, padronizar prompts e voltar com próximos passos aplicáveis na empresa.",
  },
];

const audiences = [
  "Empresários e sócios que querem entender onde a IA entra no negócio com ganho real de produtividade.",
  "Clientes e empresas de perfil B2B que lidam com atendimento, documentos, financeiro, pessoas, vendas e operação.",
  "Lideranças administrativas, financeiras, comerciais e de RH que precisam transformar demanda repetitiva em processo.",
  "Gestores que querem orientar equipes no uso de IA sem perder critério, revisão humana e responsabilidade.",
  "Profissionais que querem sair da curiosidade com ChatGPT e chegar a rotinas aplicáveis no trabalho.",
];

const faq = [
  {
    question: "Preciso saber programar?",
    answer: "Não. O Bootcamp foi desenhado para empresários, gestores e equipes que precisam aplicar IA no trabalho, mesmo sem formação técnica.",
  },
  {
    question: "É uma palestra ou uma imersão prática?",
    answer: "É uma experiência presencial com demonstrações, método e exercícios aplicados a rotinas de negócio. A proposta é sair com caminhos claros para usar IA no dia a dia.",
  },
  {
    question: "O evento será pago?",
    answer: "Os detalhes de inscrição serão enviados pelos canais oficiais da Amplify, Rui Cadete e RC Hub. Use a página para receber as próximas informações sobre a turma.",
  },
  {
    question: "Empresas podem levar equipes?",
    answer: "Sim. O formato é especialmente útil para equipes administrativas, financeiras, comerciais, atendimento, RH e lideranças que precisam criar uma linguagem comum de IA.",
  },
  {
    question: "Haverá possibilidade de patrocínio?",
    answer: "Sim. A página mantém contato para marcas que queiram apoiar ações de inovação, relacionamento B2B, turmas corporativas ou novas edições.",
  },
];

const pageTitle = `${eventTitle} | Rui Cadete + RC Hub + Amplify`;
const pageDescription = `${eventTitle}: imersão presencial na Rui Cadete, em Natal, para empresários e clientes B2B aplicarem IA com método, produtividade e responsabilidade.`;
---

<PageShell title={pageTitle} description={pageDescription} chatbot={false}>
  <main class="crea-lp" data-bootcamp-slug={event.slug} data-bootcamp-version="rui-cadete">
    <header class="crea-nav">
      <div class="crea-container crea-nav__inner">
        <a class="crea-brand" href="/" aria-label="Voltar para a pagina inicial da Amplify">
          <img class="crea-brand__amplify" src={logoSrc} alt="Amplify" width="120" height="24" />
          <span class="crea-brand__divider"></span>
          <span class="rc-brand-lockup" aria-label={`${partnerName} e ${partnerDescriptor}`}>
            <img class="rc-rui-logo rc-rui-logo--nav" src={ruiCadeteLogoSrc} alt={partnerName} width="639" height="120" />
            <span class="crea-logo-chip crea-logo-chip--nav">
              <img class="rc-hub-logo rc-hub-logo--nav" src={rcHubLogoSrc} alt={partnerDescriptor} width="361" height="136" />
            </span>
          </span>
        </a>
        <nav aria-label="Navegação principal">
          <a href="#programacao">Programação</a>
          <a href="#inscricao">Inscrição</a>
        </nav>
      </div>
    </header>

    <section class="crea-hero" aria-labelledby="crea-title">
      <img class="crea-hero__photo" src={heroSrc} alt="" width="1280" height="720" loading="eager" />
      <div class="crea-hero__scrim"></div>
      <div class="crea-blueprint" aria-hidden="true"></div>
      <div class="crea-container crea-hero__inner">
        <p class="crea-label">Bootcamp presencial · Natal · {eventLongDate}</p>
        <h1 id="crea-title">{eventTitle}</h1>
        <p>
          Uma experiência presencial para empresários, lideranças e clientes B2B aplicarem
          inteligência artificial em produtividade, atendimento, documentos, financeiro e operação
          com método, critério e foco em resultado. Dia {eventLongDate}, na Rui Cadete, em Natal.
        </p>
        <div class="crea-actions">
          <a class="crea-button crea-button--primary" href="#inscricao">Fazer inscrição</a>
          <a class="crea-button crea-button--secondary" href="#programacao">Ver programação</a>
          <a class="crea-button crea-button--ghost" href="#patrocinio">Levar para minha empresa</a>
        </div>
        <div class="crea-meta" aria-label="Resumo do evento">
          <span>Rui Cadete / RC Hub</span>
          <span>{eventAddress}</span>
          <span>{eventTimeLabel}</span>
          <span>Perfil B2B</span>
        </div>
      </div>
    </section>

    <section class="crea-section crea-split" aria-labelledby="why-title">
      <div>
        <p class="crea-label">Por que com Rui Cadete e RC Hub</p>
        <h2 id="why-title">IA precisa sair da curiosidade e entrar na rotina real do negócio.</h2>
      </div>
      <div class="crea-copy">
        <p>
          Empresas B2B lidam com atendimento, documentos, prazos, financeiro, pessoas, vendas,
          processos e decisões que exigem velocidade sem perda de controle.
        </p>
        <p>
          Por isso, este Bootcamp não vende IA como atalho mágico. A proposta é ensinar um método
          para usar IA como apoio ao raciocínio, à organização e à execução, mantendo revisão humana,
          rastreabilidade e responsabilidade de gestão.
        </p>
        <div class="crea-note">Pensado para empresários, sócios, lideranças e clientes B2B conectados ao ecossistema Rui Cadete e RC Hub.</div>
      </div>
    </section>

    <section id="programacao" class="crea-section" aria-labelledby="program-title">
      <div class="crea-container">
        <div class="crea-section__head">
          <p class="crea-label">Programação</p>
          <h2 id="program-title">Quatro blocos práticos para transformar IA em rotina de negócio.</h2>
        </div>
        <div class="crea-program">
          {modules.map((module, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{module.title}</h3>
                <p>{module.copy}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="crea-program-cta">
          <p>Tem interesse, mas quer ver a programação completa?</p>
          <a class="crea-button crea-button--primary" href="#programacao-completa">Receber programação completa</a>
        </div>
      </div>
    </section>

    <section id="programacao-completa" class="crea-section crea-section--surface" aria-labelledby="conversion-title">
      <div class="crea-container crea-conversion">
        <div>
          <p class="crea-label">Programação completa</p>
          <h2 id="conversion-title">Receba o roteiro completo antes de decidir.</h2>
          <p>Enviamos detalhes da imersão, formato, local e próximos passos para você avaliar a participação na turma Rui Cadete + RC Hub.</p>
        </div>
        <form class="crea-form" data-bootcamp-form data-success-message="Programação solicitada. Enviaremos a programação completa e os próximos passos por email.">
          <input type="hidden" name="eventName" value="bootcamp_program_requested" />
          <input type="hidden" name="entryPoint" value="programacao_completa_rui_cadete_26_08" />
          <input type="hidden" name="intent" value="receber_programacao_completa" />
          <input type="hidden" name="sourceCta" value="receber_programacao_completa_rui_cadete" />
          <label>Nome<input name="name" type="text" autocomplete="name" required placeholder="Seu nome" /></label>
          <label>Email<input name="email" type="email" autocomplete="email" required placeholder="voce@empresa.com" /></label>
          <label>Perfil
            <select name="role" required>
              <option value="">Selecione</option>
              {roles.map((role) => <option value={role}>{role}</option>)}
            </select>
          </label>
          <button class="crea-button crea-button--primary" type="submit">Receber programação completa</button>
          <p class="crea-form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="crea-section crea-section--surface" aria-labelledby="audience-title">
      <div class="crea-container">
        <div class="crea-section__head">
          <p class="crea-label">Para quem é</p>
          <h2 id="audience-title">Um evento para quem responde por resultado, rotina e relacionamento com clientes.</h2>
        </div>
        <div class="crea-audience">
          {audiences.map((item) => <p><span>→</span>{item}</p>)}
        </div>
      </div>
    </section>

    <section class="crea-section crea-experience" aria-labelledby="included-title">
      <img src={ruiCadeteOfficeSrc} alt="Ambiente da Rui Cadete" width="720" height="480" loading="eager" />
      <div>
        <p class="crea-label">O que está incluído</p>
        <h2 id="included-title">O formato da experiência presencial na Rui Cadete.</h2>
        <ul>
          <li>Um dia de imersão prática presencial</li>
          <li>Exercícios aplicados a atendimento, documentos, financeiro, reuniões e operação</li>
          <li>Certificado digital de participação</li>
          <li>Roteiro de próximos passos para aplicar IA na empresa com método</li>
        </ul>
      </div>
    </section>

    <section class="crea-section crea-section--surface crea-mentor" aria-labelledby="mentor-title">
      <div class="crea-mentor__profile">
        <img class="crea-mentor__photo" src={professorImage} alt="Leonardo Camacho" width="720" height="900" loading="eager" />
        <div class="crea-mentor__content">
          <p class="crea-label">Quem será seu professor?</p>
          <h2 id="mentor-title">Leonardo Camacho</h2>
          <strong>Educador de IA e Head de Soluções da Amplify</strong>
          <div class="crea-mentor__bio">
            <p>{content.mentor.bio}</p>
            <p>{content.mentor.application}</p>
          </div>
          <div class="crea-mentor__proof">
            {mentorHighlights.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))}
          </div>
          <p class="crea-mentor__quote">Em negócios B2B, IA só vira ganho quando entra no processo com método, contexto e responsabilidade.</p>
        </div>
      </div>
      <div class="crea-client-row" aria-label="Frentes conectadas ao ecossistema RC Hub">
        <span>Frentes conectadas ao ecossistema RC Hub</span>
        <div>
          {companyNames.map((client) => (
            <span class="crea-client-chip">{client}</span>
          ))}
        </div>
      </div>
    </section>

    <section id="inscricao" class="crea-section" aria-labelledby="offer-title">
      <div class="crea-container">
        <div class="crea-section__head">
          <p class="crea-label">Inscrição, equipes e parceria</p>
          <h2 id="offer-title">Escolha como participar do {eventTitle}.</h2>
          <p>Faça inscrição na turma de Natal, leve a experiência para sua equipe ou associe sua marca a uma formação prática para empresários e clientes B2B.</p>
        </div>
        <div class="crea-offer-grid">
          <article class="crea-card crea-card--highlight crea-card--purchase">
            <div class="crea-card__intro">
              <span class="crea-badge">26/08 em Natal</span>
              <h3>Participação individual</h3>
              <p>Entre na lista de interesse para receber informações sobre inscrição e próximos passos da turma presencial na Rui Cadete.</p>
            </div>
            <div class="crea-card__body">
              <ul class="crea-card-list">
                <li>Produtividade, atendimento, documentos e rotinas de gestão com IA</li>
                <li>Certificado digital</li>
                <li>Aplicações para empresários, gestores e equipes B2B</li>
              </ul>
              <p class="crea-card-note">Assim que o canal de inscrição estiver disponível, os interessados receberão a orientação pelos canais oficiais.</p>
            </div>
            <div class="crea-card__action">
              <a class="crea-button crea-button--primary" href="#programacao-completa">Quero receber informações</a>
            </div>
          </article>

          <article class="crea-card crea-card--form">
            <div class="crea-card__intro">
              <span class="crea-badge crea-badge--outline">Equipes B2B</span>
              <h3>Plano corporativo</h3>
              <p>Leve a equipe para sair com uma linguagem comum de IA, casos de uso priorizados e próximos passos aplicáveis ao negócio.</p>
            </div>
            <form class="crea-form crea-form--compact" data-bootcamp-form data-whatsapp-form data-whatsapp-kind="corporate" data-success-message="Abrindo WhatsApp com a mensagem pronta.">
              <input type="hidden" name="eventName" value="bootcamp_corporate_lead" />
              <input type="hidden" name="entryPoint" value="plano_corporativo_rui_cadete" />
              <input type="hidden" name="intent" value="levar_para_equipe" />
              <input type="hidden" name="sourceCta" value="plano_corporativo_rui_cadete" />
              <label>Nome<input name="name" type="text" autocomplete="name" required placeholder="Seu nome" /></label>
              <label>Email<input name="email" type="email" autocomplete="email" required placeholder="voce@empresa.com" /></label>
              <label>Empresa<input name="company" type="text" autocomplete="organization" required placeholder="Nome da empresa" /></label>
              <label>Quantas pessoas?
                <select name="teamSize" required>
                  <option value="">Selecione</option>
                  <option value="5-9">5 a 9</option>
                  <option value="10-19">10 a 19</option>
                  <option value="20+">20+</option>
                </select>
              </label>
              <button class="crea-button crea-button--primary" type="submit">Pedir condição corporativa</button>
              <p class="crea-form-status" role="status" aria-live="polite"></p>
            </form>
          </article>

          <article class="crea-card crea-card--form" id="patrocinio">
            <div class="crea-card__intro">
              <span class="crea-badge crea-badge--outline">Marca parceira</span>
              <h3>Parceria</h3>
              <p>Associe sua marca a uma agenda prática de inovação para empresários, lideranças e empresas do ecossistema B2B.</p>
            </div>
            <form class="crea-form crea-form--compact" data-bootcamp-form data-whatsapp-form data-whatsapp-kind="sponsor" data-success-message="Abrindo WhatsApp com a mensagem pronta.">
              <input type="hidden" name="eventName" value="bootcamp_sponsor_lead" />
              <input type="hidden" name="entryPoint" value="parceria_rui_cadete" />
              <input type="hidden" name="intent" value="patrocinio" />
              <input type="hidden" name="sourceCta" value="parceria_rui_cadete" />
              <label>Nome<input name="name" type="text" autocomplete="name" required placeholder="Seu nome" /></label>
              <label>Email<input name="email" type="email" autocomplete="email" required placeholder="voce@empresa.com" /></label>
              <label>Empresa<input name="company" type="text" autocomplete="organization" required placeholder="Nome da empresa" /></label>
              <label>Interesse
                <select name="sponsorInterest" required>
                  <option value="">Selecione</option>
                  <option value="patrocinio">Patrocínio</option>
                  <option value="apoio_institucional">Apoio institucional</option>
                  <option value="plano_corporativo">Plano corporativo</option>
                </select>
              </label>
              <button class="crea-button crea-button--secondary" type="submit">Conversar sobre parceria</button>
              <p class="crea-form-status" role="status" aria-live="polite"></p>
            </form>
          </article>
        </div>
      </div>
    </section>

    <section class="crea-section crea-faq" aria-labelledby="faq-title">
      <div class="crea-container">
        <div class="crea-section__head">
          <p class="crea-label">Perguntas frequentes</p>
          <h2 id="faq-title">O essencial antes de decidir.</h2>
        </div>
        <div class="crea-faq__list">
          {faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="crea-final" aria-label="Inscrição">
      <div class="crea-container">
        <div class="rc-final-logos" aria-label={`${partnerName} e ${partnerDescriptor}`}>
          <img class="rc-rui-logo rc-rui-logo--final" src={ruiCadeteLogoSrc} alt={partnerName} width="639" height="120" loading="lazy" />
          <span class="crea-logo-chip crea-logo-chip--final">
            <img class="rc-hub-logo rc-hub-logo--final" src={rcHubLogoSrc} alt={partnerDescriptor} width="361" height="136" loading="lazy" />
          </span>
        </div>
        <h2>IA aplicada ao negócio, com método, produtividade e responsabilidade.</h2>
        <p>{eventLongDate}, {eventTimeLabel.toLowerCase()}, na Rui Cadete. {eventAddress}.</p>
        <div class="crea-actions crea-actions--center">
          <a class="crea-button crea-button--primary" href="#inscricao">Fazer inscrição</a>
          <a class="crea-button crea-button--secondary" href="#patrocinio">Levar para minha empresa</a>
        </div>
      </div>
    </section>

    <footer class="crea-footer">
      <div class="crea-container">
        <img src={logoSrc} alt="Amplify" width="120" height="24" />
        <span>Parceria Rui Cadete + RC Hub + Amplify · {eventTitle}</span>
      </div>
    </footer>
  </main>
</PageShell>

<script is:inline define:vars={{ slug: event.slug, checkoutUrl }}>
  const leadStorageKey = `bootcamp:${slug}:lead`;

  function getStoredLead() {
    try {
      return JSON.parse(window.localStorage.getItem(leadStorageKey) || "{}");
    } catch (_error) {
      return {};
    }
  }

  function storeLead(fields) {
    try {
      window.localStorage.setItem(leadStorageKey, JSON.stringify({ ...getStoredLead(), ...fields }));
    } catch (_error) {}
  }

  function getTicketLabel(value) {
    return ({ "5-9": "5 a 9", "10-19": "10 a 19", "20+": "20 ou mais" })[value] || value || "mais de 5";
  }

  function getWhatsappPayload(payload, kind) {
    const name = String(payload.name || "").trim();
    const company = String(payload.company || "").trim();
    const email = String(payload.email || "").trim();
    const identity = [name, company ? `da empresa ${company}` : ""].filter(Boolean).join(", ");
    const teamSize = getTicketLabel(String(payload.teamSize || "").trim());
    const base = kind === "sponsor"
      ? "gostaria de falar sobre parceria para o Bootcamp IA para Negócio com Rui Cadete, RC Hub e Amplify."
      : `gostaria de ver condições para ${teamSize} inscrições corporativas para o Bootcamp IA para Negócio com Rui Cadete, RC Hub e Amplify.`;
    const message = [
      "Olá Adriano,",
      identity ? `eu sou ${identity}` : "eu gostaria de falar com você",
      `e ${base}`,
      email ? `Meu email é ${email}.` : "",
    ].filter(Boolean).join(" ");

    return {
      message,
      url: `https://wa.me/5511950350002?text=${encodeURIComponent(message)}`,
    };
  }

  document.querySelectorAll("[data-bootcamp-form]").forEach((form) => {
    const status = form.querySelector(".crea-form-status");
    const button = form.querySelector("button[type='submit']");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      const email = String(payload.email || "").trim().toLowerCase();
      if (!email) return;

      storeLead({
        email,
        name: payload.name,
        company: payload.company,
        role: payload.role,
        teamSize: payload.teamSize,
      });

      if (status) status.textContent = "Enviando...";
      if (button) button.disabled = true;

      if (form.hasAttribute("data-whatsapp-form")) {
        const whatsapp = getWhatsappPayload(payload, form.dataset.whatsappKind);
        fetch("/api/bootcamp-track", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            slug,
            version: "rui-cadete",
            pageUrl: window.location.href,
            checkoutUrl,
            ...payload,
            email,
            whatsappMessage: whatsapp.message,
            forceFetch: true,
          }),
          keepalive: true,
        }).catch(() => {});
        if (status) status.textContent = form.dataset.successMessage || "Abrindo WhatsApp...";
        form.classList.add("is-submitted");
        window.open(whatsapp.url, "_blank", "noopener,noreferrer");
        if (button) button.disabled = false;
        return;
      }

      try {
        const response = await fetch("/api/bootcamp-track", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            slug,
            version: "rui-cadete",
