---
import PageShell from "@/layouts/PageShell.astro";
import KnowledgeChrome from "@/components/knowledge/KnowledgeChrome";
import type { KnowledgeListItem } from "@/components/knowledge/KnowledgeDirectory";

const { title, description, items, activeId, isIndex = false } = Astro.props as {
  title: string; description: string; items: KnowledgeListItem[]; activeId?: string; isIndex?: boolean;
};
---

<PageShell title={title} description={description} chatbot={false}>
  <meta slot="head" name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <div class="kb-shell">
    <KnowledgeChrome client:load items={items} activeId={activeId} isIndex={isIndex} />
    <main class="kb-main"><slot /></main>
  </div>
</PageShell>

<style is:global>
  :root{--kb-header:72px;--kb-sidebar:340px}html{scroll-behavior:smooth;scroll-padding-top:100px}body:has(.kb-shell){background:#090b0d}.kb-shell{min-height:100vh;color:#f5f7f7;background:radial-gradient(circle at 62% 0%,rgba(33,181,175,.055),transparent 30rem),#090b0d}.kb-topbar{position:fixed;inset:0 0 auto;z-index:100;height:var(--kb-header);display:flex;align-items:center;gap:32px;padding:0 36px;border-bottom:1px solid #22272a;background:rgba(9,11,13,.92);backdrop-filter:blur(18px)}.kb-brand{flex:0 0 calc(var(--kb-sidebar) - 36px);display:flex;align-items:center;gap:15px;color:#f6f8f8;text-decoration:none}.kb-brand img{width:auto;height:26px}.kb-brand>span{width:1px;height:27px;background:#343a3e}.kb-brand strong{font:500 17px Inter,sans-serif;letter-spacing:-.02em;color:#b6bfc0}.kb-search-wrap{position:relative;z-index:102;width:min(560px,42vw);height:42px;display:flex;align-items:center;margin:0 auto;border:1px solid #2b3134;border-radius:9px;background:#121619;color:#7f898b}.kb-search-wrap:focus-within{border-color:rgba(49,208,199,.65);box-shadow:0 0 0 3px rgba(49,208,199,.08)}.kb-search-wrap>svg{width:17px;margin-left:14px}.kb-search-wrap input{min-width:0;flex:1;height:100%;padding:0 12px;border:0;outline:0;background:transparent;color:#eff5f4;font:400 14px Inter,sans-serif}.kb-search-wrap kbd{margin-right:8px;padding:4px 7px;border:1px solid #303638;border-radius:5px;background:#1a1f22;color:#7f898b;font:500 11px Inter,sans-serif}.kb-mobile-search-close,.kb-search-mobile,.kb-menu-button{display:none}.kb-search-results{position:absolute;top:calc(100% + 10px);left:0;right:0;overflow:hidden;border:1px solid #2b3235;border-radius:12px;background:#101416;box-shadow:0 22px 60px rgba(0,0,0,.55)}.kb-search-results>p{margin:0;padding:12px 15px 8px;color:#737e81;font:600 10px Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase}.kb-search-results>a{display:flex;align-items:center;gap:12px;padding:11px 14px;color:#dce3e3;text-decoration:none;border-top:1px solid #1c2224}.kb-search-results>a:hover{background:#181e20}.kb-search-results>a svg{width:18px;color:#32c8c1}.kb-search-results>a span{display:grid;gap:3px}.kb-search-results>a strong{font:550 14px Inter,sans-serif}.kb-search-results>a small{color:#788285;font:11px Inter,sans-serif}.kb-search-empty{padding:28px 16px;color:#859092;text-align:center;font-size:13px}.kb-search-view{width:100%;padding:12px;border:0;border-top:1px solid #242a2d;background:transparent;color:#39cbc5;font-size:12px}.kb-search-scrim{position:fixed;z-index:90;inset:var(--kb-header) 0 0;border:0;background:rgba(0,0,0,.34);backdrop-filter:blur(2px)}
  .kb-sidebar{position:fixed;z-index:50;inset:var(--kb-header) auto 0 0;width:var(--kb-sidebar);overflow-y:auto;padding:30px 22px 40px;border-right:1px solid #202528;background:#0b0e10}.kb-sidebar nav,.kb-drawer nav{display:grid;gap:3px}.kb-sidebar nav>p,.kb-drawer nav>p{margin:23px 13px 8px;color:#626c6f;font:650 10px Inter,sans-serif;letter-spacing:.13em}.kb-sidebar nav>p:first-child,.kb-drawer nav>p:first-child{margin-top:0}.kb-sidebar nav>a,.kb-drawer nav>a{display:flex;align-items:center;gap:12px;min-height:42px;padding:9px 13px;border-radius:7px;color:#929c9e;font:450 14px/1.35 Inter,sans-serif;text-decoration:none}.kb-sidebar nav>a:hover,.kb-drawer nav>a:hover{background:#14191b;color:#e4e9e9}.kb-sidebar nav>a.is-active,.kb-drawer nav>a.is-active{background:rgba(44,196,189,.1);color:#48d5ce}.kb-sidebar nav>a svg,.kb-drawer nav>a svg{flex:0 0 auto;width:17px}.kb-main{min-height:100vh;margin-left:var(--kb-sidebar);padding-top:var(--kb-header)}.kb-page{width:min(100%,1120px);margin:0 auto;padding:82px 72px 100px}.kb-eyebrow{display:flex;align-items:center;gap:9px;margin:0 0 20px;color:#44d0ca;font:650 12px Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase}.kb-eyebrow:before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 16px rgba(68,208,202,.65)}.kb-page h1{max-width:800px;margin:0;color:#f6f8f8;font:580 clamp(46px,5.4vw,76px)/.98 "Bricolage Grotesque",Inter,sans-serif;letter-spacing:-.055em}.kb-lead{max-width:720px;margin:28px 0 0;color:#97a1a3;font:400 18px/1.7 Inter,sans-serif}
  .kb-directory{margin-top:66px}.kb-directory-toolbar{display:flex;align-items:center;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid #282d30}.kb-directory-toolbar p{margin:0;color:#788285;font:500 13px Inter,sans-serif}.kb-directory-toolbar button{display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border:1px solid #2c3235;border-radius:7px;background:#121619;color:#a8b1b3;font:500 12px Inter,sans-serif;cursor:pointer}.kb-directory-toolbar button svg{width:14px}.kb-directory-toolbar button span{display:grid;place-items:center;width:17px;height:17px;border-radius:50%;background:#35c8c1;color:#07100f;font-size:10px}.kb-filter-panel{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;gap:12px;align-items:end;padding:16px;border-bottom:1px solid #282d30;background:#0d1113}.kb-filter-panel label{display:grid;gap:6px;color:#737e81;font:600 10px Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase}.kb-filter-panel select{height:38px;padding:0 10px;border:1px solid #2b3134;border-radius:6px;background:#14191b;color:#c7cecf;font:13px Inter,sans-serif}.kb-filter-panel>button{height:38px;display:flex;align-items:center;gap:6px;border:0;background:transparent;color:#42ccc6;font-size:12px}.kb-filter-panel>button svg{width:14px}.kb-document-list article{border-bottom:1px solid #22282a}.kb-document-list article>a{display:grid;grid-template-columns:48px minmax(0,1fr) 24px;gap:20px;align-items:start;padding:29px 16px 29px 4px;color:inherit;text-decoration:none;transition:.18s}.kb-document-list article>a:hover{padding-left:12px;background:linear-gradient(90deg,rgba(48,198,191,.055),transparent 70%)}.kb-document-icon{display:grid;place-items:center;width:44px;height:44px;border:1px solid #2c3436;border-radius:9px;background:#121719;color:#3ac9c2}.kb-document-icon svg{width:20px}.kb-document-copy{display:grid;gap:9px}.kb-document-meta{display:flex;align-items:center;gap:9px;color:#788285;font:600 10px Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase}.kb-document-meta b{color:#3dcac4}.kb-document-meta i{width:3px;height:3px;border-radius:50%;background:#4f595c}.kb-document-copy>strong{color:#ecf0f0;font:550 20px "Bricolage Grotesque",Inter,sans-serif;letter-spacing:-.025em}.kb-document-copy>small{max-width:700px;color:#8d9799;font:400 14px/1.6 Inter,sans-serif}.kb-document-tags{display:flex;flex-wrap:wrap;gap:6px}.kb-document-tags em{padding:4px 7px;border:1px solid #283033;border-radius:4px;color:#6f7a7c;font:500 10px Inter,sans-serif;font-style:normal}.kb-document-arrow{align-self:center;width:18px;color:#566164}.kb-document-list a:hover .kb-document-arrow{color:#41ccc6;transform:translateX(4px)}.kb-empty{padding:70px 20px;text-align:center;color:#7e898b}.kb-empty>svg{width:32px;margin:0 auto 15px;color:#3dcac4}.kb-empty h2{color:#eef1f1;font-size:22px}.kb-empty button{margin-top:16px;border:0;background:transparent;color:#3dcac4}
  .kb-document-page{display:grid;grid-template-columns:minmax(0,760px) 230px;gap:78px;width:min(100%,1140px);margin:0 auto;padding:70px 56px 100px}.kb-breadcrumb{display:inline-flex;align-items:center;gap:7px;color:#768184;font:500 12px Inter,sans-serif;text-decoration:none}.kb-breadcrumb:hover{color:#40cbc5}.kb-breadcrumb svg{width:14px}.kb-document-header{padding-bottom:38px;border-bottom:1px solid #242a2d}.kb-document-kicker{display:flex;gap:10px;align-items:center;margin:34px 0 18px;color:#7f898b;font:600 10px Inter,sans-serif;letter-spacing:.11em;text-transform:uppercase}.kb-document-kicker b{color:#3ccbc4}.kb-document-kicker i{width:3px;height:3px;border-radius:50%;background:#4c5659}.kb-document-header h1{margin:0;color:#f3f6f6;font:580 clamp(38px,4.2vw,60px)/1.03 "Bricolage Grotesque",Inter,sans-serif;letter-spacing:-.05em}.kb-document-header>p{margin:22px 0 0;color:#96a0a2;font:400 17px/1.7 Inter,sans-serif}.kb-document-header ul{display:flex;flex-wrap:wrap;gap:7px;margin:22px 0 0;padding:0;list-style:none}.kb-document-header li{padding:5px 8px;border:1px solid #293134;border-radius:5px;color:#7b8688;font:500 10px Inter,sans-serif}.knowledge-prose{padding-top:18px}.knowledge-prose h1{display:none}.knowledge-prose h2{margin:52px 0 16px;color:#eef2f2;font:580 30px/1.18 "Bricolage Grotesque",Inter,sans-serif;letter-spacing:-.035em}.knowledge-prose h3{margin:35px 0 12px;color:#e5eaea;font:570 21px "Bricolage Grotesque",Inter,sans-serif}.knowledge-prose h2:hover:after,.knowledge-prose h3:hover:after{content:"#";margin-left:9px;color:#35c7c0;font-size:.72em}.knowledge-prose p,.knowledge-prose li{color:#9aa4a6;font:400 15.5px/1.8 Inter,sans-serif}.knowledge-prose p{margin:15px 0}.knowledge-prose ul,.knowledge-prose ol{margin:16px 0;padding-left:23px}.knowledge-prose li{margin:7px 0;padding-left:4px}.knowledge-prose li::marker{color:#36c5bf}.knowledge-prose a{color:#43d0ca;text-underline-offset:3px}.knowledge-prose strong{color:#dde4e4}.knowledge-prose table{display:block;width:100%;margin:28px 0;overflow-x:auto;border-collapse:collapse}.knowledge-prose th,.knowledge-prose td{min-width:140px;padding:12px 14px;border:1px solid #293033;text-align:left;vertical-align:top;font-size:13px}.knowledge-prose th{background:#13181a;color:#e2e7e7}.knowledge-prose td{color:#929c9e}.knowledge-prose pre{overflow-x:auto;margin:24px 0;padding:18px;border:1px solid #2a3133;border-radius:8px;background:#101416}.knowledge-prose code{border:1px solid #283033;border-radius:4px;background:#14191b;padding:2px 5px;color:#d0d7d7;font-size:.9em}.knowledge-prose pre code{border:0;background:transparent;padding:0}.kb-toc{position:sticky;top:calc(var(--kb-header) + 34px);align-self:start;padding-left:20px;border-left:1px solid #242a2d}.kb-toc>strong{color:#c7cecf;font:600 11px Inter,sans-serif;letter-spacing:.09em;text-transform:uppercase}.kb-toc ul{display:grid;gap:4px;margin:14px 0 0;padding:0;list-style:none}.kb-toc li{display:flex;align-items:center}.kb-toc li.is-child{padding-left:13px}.kb-toc a{flex:1;padding:6px 0;color:#737e80;font:400 12px/1.45 Inter,sans-serif;text-decoration:none}.kb-toc a:hover,.kb-toc a.is-active{color:#40cbc5}.kb-toc button{opacity:0;width:26px;height:26px;display:grid;place-items:center;border:0;background:transparent;color:#687376}.kb-toc li:hover button,.kb-toc button:focus-visible{opacity:1}.kb-toc button svg{width:12px}.kb-page-navigation{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:68px;padding-top:24px;border-top:1px solid #242a2d}.kb-page-navigation a{display:grid;gap:6px;padding:16px;border:1px solid #283033;border-radius:8px;color:#cbd2d2;text-decoration:none}.kb-page-navigation a:last-child{text-align:right}.kb-page-navigation a:hover{border-color:rgba(58,201,194,.55)}.kb-page-navigation small{color:#687376;font-size:10px;letter-spacing:.1em;text-transform:uppercase}.kb-page-navigation strong{font:550 14px Inter,sans-serif}.kb-drawer-layer{display:none}:focus-visible{outline:2px solid #40cbc5;outline-offset:3px}
  @media(max-width:1050px){:root{--kb-sidebar:275px}.kb-document-page{grid-template-columns:minmax(0,1fr);max-width:820px}.kb-toc{display:none}}
  @media(max-width:760px){:root{--kb-header:62px}.kb-topbar{gap:10px;padding:0 16px}.kb-brand{flex:1;gap:10px}.kb-brand img{height:22px}.kb-brand>span{height:21px}.kb-brand strong{font-size:14px}.kb-sidebar{display:none}.kb-main{margin-left:0}.kb-search-wrap{display:none}.kb-search-wrap.is-open{position:fixed;top:10px;left:10px;right:10px;z-index:120;display:flex;width:auto;height:44px}.kb-search-wrap.is-open kbd{display:none}.kb-mobile-search-close{display:grid;place-items:center;width:38px;height:38px;border:0;background:transparent;color:#899496}.kb-mobile-search-close svg{width:17px}.kb-search-mobile,.kb-menu-button{display:grid;place-items:center;width:38px;height:38px;padding:0;border:0;background:transparent;color:#aeb6b7}.kb-search-mobile svg,.kb-menu-button svg{width:20px}.kb-search-scrim{z-index:110;inset:0;background:rgba(0,0,0,.72)}.kb-drawer-layer{position:fixed;z-index:130;inset:0;display:block}.kb-drawer-scrim{position:absolute;inset:0;width:100%;border:0;background:rgba(0,0,0,.68)}.kb-drawer{position:absolute;inset:0 0 0 auto;width:min(86vw,340px);overflow-y:auto;padding:20px 18px 35px;border-left:1px solid #293033;background:#0d1113}.kb-drawer>div{display:flex;align-items:center;justify-content:space-between;margin-bottom:30px;padding:0 9px;color:#eef2f2;font:570 17px "Bricolage Grotesque",Inter,sans-serif}.kb-drawer>div button{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:6px;background:#171c1f;color:#9ca6a8}.kb-drawer>div svg{width:18px}.kb-page{padding:52px 22px 70px}.kb-page h1{font-size:46px;line-height:1}.kb-lead{margin-top:21px;font-size:16px}.kb-directory{margin-top:46px}.kb-filter-panel{grid-template-columns:1fr}.kb-document-list article>a{grid-template-columns:42px minmax(0,1fr);gap:14px;padding:24px 0}.kb-document-list article>a:hover{padding-left:0}.kb-document-icon{width:40px;height:40px}.kb-document-copy>strong{font-size:18px}.kb-document-copy>small{font-size:13px}.kb-document-arrow{display:none}.kb-document-page{display:block;padding:38px 22px 70px}.kb-document-header h1{font-size:40px}.kb-document-header>p{font-size:15px}.knowledge-prose h2{margin-top:44px;font-size:27px}.knowledge-prose p,.knowledge-prose li{font-size:15px}.kb-page-navigation{grid-template-columns:1fr}.kb-page-navigation a:last-child{text-align:left}}
  @media(max-width:760px){.kb-search-scrim{z-index:90;inset:var(--kb-header) 0 0}}
</style>
