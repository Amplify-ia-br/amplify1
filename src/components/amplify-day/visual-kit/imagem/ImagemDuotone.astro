---
/**
 * DUOTONE CIANO — preto e branco + ciano em blend.
 *
 * Silhuetas primeiro, cor depois. O degradê de proteção no topo garante
 * que qualquer tipografia sobreposta continue legível.
 *
 * O tratamento é isolado (`isolation: isolate`): o blend nunca alcança
 * o que está atrás do componente na página.
 */
import { kitStyle, type VisualKitProps } from "../kit";

interface Props extends VisualKitProps {
  /** URL da imagem (ou `.src` de um asset importado). */
  src: string;
  /** Texto alternativo. Vazio = imagem decorativa. */
  alt?: string;
  /** Intensidade do banho de cor (0–1). Padrão: `0.55`. */
  tint?: number | string;
  /** Força do degradê de proteção no topo (0–1). Padrão: `0.65`. */
  scrim?: number | string;
  loading?: "eager" | "lazy";
  width?: number | string;
  height?: number | string;
}

const props = Astro.props as Props;
const {
  class: className,
  src,
  alt = "",
  tint,
  scrim,
  loading = "lazy",
} = props;
---

<div
  class:list={["vk-duotone", className]}
  style={kitStyle(props, { "--vk-tint": tint, "--vk-scrim": scrim })}
>
  <img class="vk-duotone__img" src={src} alt={alt} loading={loading} decoding="async" />
  <div class="vk-duotone__banho"></div>
  <div class="vk-duotone__scrim"></div>
</div>

<style>
  .vk-duotone {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--vk-surface, #0d0d0d);
    opacity: var(--vk-opacity, 1);
  }

  .vk-duotone__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(calc(1 + 0.15 * var(--vk-intensity, 1)));
  }

  .vk-duotone__banho,
  .vk-duotone__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .vk-duotone__banho {
    background: var(--vk-accent, #2dd4bf);
    mix-blend-mode: color;
    opacity: var(--vk-tint, 0.55);
  }

  .vk-duotone__scrim {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--vk-surface, #0d0d0d) calc(var(--vk-scrim, 0.65) * 100%), transparent),
      transparent 55%
    );
  }
</style>
