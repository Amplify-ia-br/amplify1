---
import globalStyles from "@/index.css?url";

const {
  title = "Amplify | Inteligencia Artificial para empresas",
  description = "A Amplify conecta estrategia, educacao corporativa e consultoria para ajudar empresas a aplicar Inteligencia Artificial com impacto real.",
} = Astro.props;

const pageTitle = String(title).trim() || "Amplify | Inteligencia Artificial para empresas";
const pageDescription = String(description).trim() || "A Amplify conecta estrategia, educacao corporativa e consultoria para ajudar empresas a aplicar Inteligencia Artificial com impacto real.";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="stylesheet" href={globalStyles} />
    <link rel="preconnect" href="https://code.jquery.com" crossorigin />
    <link rel="preconnect" href="https://in.bot" crossorigin />
    <script is:inline>
      (() => {
        let loaded = false;

        function loadScript(id, src, async = true) {
          return new Promise((resolve, reject) => {
            if (document.getElementById(id)) {
              resolve();
              return;
            }
            const script = document.createElement("script");
            script.id = id;
            script.src = src;
            script.async = async;
            script.onload = () => resolve();
            script.onerror = () => reject(new Error(`Failed to load ${src}`));
            document.head.appendChild(script);
          });
        }

        async function loadChatbot() {
          if (loaded) return;
          loaded = true;
          try {
            await loadScript("chatbot-jquery-script", "https://code.jquery.com/jquery-3.7.1.min.js", true);
            await loadScript(
              "chatscript",
              "https://in.bot/api/inbot.gz.js?bot_id=1128&bot_token=21jygoakkt&bot_server_type=production",
              true
            );
          } catch (_err) {
            loaded = false;
          }
        }

        const start = () => {
          window.removeEventListener("pointerdown", start);
          window.removeEventListener("keydown", start);
          window.removeEventListener("scroll", start);
          loadChatbot();
        };

        window.addEventListener("pointerdown", start, { once: true, passive: true });
        window.addEventListener("keydown", start, { once: true, passive: true });
        window.addEventListener("scroll", start, { once: true, passive: true });

        // Fallback tardio para usuários que não interagem, sem afetar o carregamento inicial.
        window.setTimeout(loadChatbot, 15000);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
