---
/**
 * LAVADA + SCANLINE — a imagem em luminosidade sobre um bloco de cor,
 * com retícula horizontal por cima.
 *
 * Pensada para as telas de formulário, no carmim da jornada de conversão.
 * A sede do evento entra como fundo, não como protagonista.
 *
 * A cor do banho é `--vk-surface` (padrão: carmim), então o mesmo
 * componente serve a qualquer bloco de cor do sistema.
 */
import { kitStyle, type VisualKitProps } from "../kit";

interface Props extends VisualKitProps {
  /** URL da imagem (ou `.src` de um asset importado). */
  src: string;
  /** Texto alternativo. Vazio = imagem decorativa. */
  alt?: string;
  /** Passo da scanline. Padrão: `4px`. */
  scanline?: string;
  loading?: "eager" | "lazy";
  width?: number | string;
  height?: number | string;
}

const props = Astro.props as Props;
const { class: className, src, alt = "", scanline, loading = "lazy" } = props;
---

<div
  class:list={["vk-lavada", className]}
  style={kitStyle(props, { "--vk-scanline": scanline })}
>
  <img class="vk-lavada__img" src={src} alt={alt} loading={loading} decoding="async" />
  <div class="vk-lavada__scanline"></div>
</div>

<style>
  .vk-lavada {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--vk-surface, #c01a4e);
    opacity: var(--vk-opacity, 1);
  }

  .vk-lavada__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(calc(1 + 0.2 * var(--vk-intensity, 1)));
    mix-blend-mode: luminosity;
  }

  .vk-lavada__scanline {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      0deg,
      color-mix(in srgb, var(--vk-color, #0d0d0d) 18%, transparent) 0 1px,
      transparent 1px var(--vk-scanline, 4px)
    );
  }
</style>
