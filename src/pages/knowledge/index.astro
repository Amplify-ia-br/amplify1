---
import KnowledgeDirectory from "@/components/knowledge/KnowledgeDirectory";
import KnowledgeLayout from "@/layouts/KnowledgeLayout.astro";
import { getPublicKnowledge, markdownToSearchText } from "@/lib/knowledge";

export const prerender = true;

const entries = await getPublicKnowledge();
const items = entries.map((entry) => ({
  id: entry.data.id,
  title: entry.data.title,
  description: entry.data.description,
  type: entry.data.type,
  status: entry.data.status,
  tags: entry.data.tags,
  lastReviewed: entry.data.last_reviewed,
  content: markdownToSearchText(entry.body),
}));
---

<KnowledgeLayout
  title="Base de conhecimento | Amplify"
  description="Documentação pública sobre a Amplify, suas ofertas, seu método e sua frente de educação."
  items={items}
  isIndex={true}
>
  <div class="kb-page">
    <p class="kb-eyebrow">Amplify Knowledge</p>
    <h1>Base de conhecimento</h1>
    <p class="kb-lead">Documentação sobre a Amplify, seu trabalho, método, portfólio e frente de educação.</p>
    <KnowledgeDirectory client:load items={items} />
  </div>
</KnowledgeLayout>
