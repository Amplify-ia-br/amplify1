  /* Cidade v2: Sol + método, regionalidade sutil e conversão premium local. */
  .boot-mockup--cidade {
    --city-bg: #050707;
    --city-surface: #0a0f0e;
    --city-line: rgba(245, 242, 236, 0.1);
