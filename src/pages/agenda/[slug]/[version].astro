---
import PageShell from "@/layouts/PageShell.astro";
import logoAmplify from "@/assets/logo-amplify-branco.png";
import treinamentoPresencial from "@/assets/optimized/treinamento-presencial.webp";
import forumPalestra from "@/assets/optimized/forum-palestra.webp";
import logoGrupoPrimo from "@/assets/logos/logo-grupo-primo.png";
import logoAmcham from "@/assets/logos/logo-amcham.png";
import logoGouvea from "@/assets/logos/logo-gouvea.png";
import logoTecfil from "@/assets/logos/logo-tecfil.png";
import logoUfg from "@/assets/logos/logo-ufg.png";
import logoCreaPr from "@/assets/logos/logo-crea-pr.png";
import { getBootcampCheckoutUrl, getBootcampEventBySlug } from "@/lib/bootcamp-events.js";
import {
  BOOTCAMP_NATAL,
  BOOTCAMP_VERSION_LABELS,
  isBootcampMockupVersion,
} from "@/lib/bootcamp-natal-content.js";

export const prerender = false;

const { slug = "", version = "" } = Astro.params;
const legacyNatalSlug = "natal-25-07-26";
const canonicalNatalSlug = "natal-23-07-26";

if (slug === legacyNatalSlug && version) {
  return Astro.redirect(`/agenda/${canonicalNatalSlug}/${version}`, 301);
}

const event = getBootcampEventBySlug(slug);
const activeVersion = String(version).toLowerCase();
const isValidVersion = isBootcampMockupVersion(activeVersion);
const content = BOOTCAMP_NATAL;
const logoSrc = logoAmplify.src;
const heroSrc = treinamentoPresencial.src;
const citySrc = forumPalestra.src;
const checkoutUrl = event ? getBootcampCheckoutUrl(event, Astro.url) : "";
const sponsorUrl = event?.whatsappGroupUrl || "https://wa.me/5511950350002?text=Ol%C3%A1%20Adriano%2C%20gostaria%20de%20falar%20sobre%20possibilidade%20de%20patrocinar%20o%20Bootcamp%20IA%20para%20neg%C3%B3cios%20em%20Natal";
const horizontalVideoSrc = "/bootcamp/video-optimized/bootcamp-natal-horizontal-wifi.mp4";
const verticalVideoSrc = "/bootcamp/video-optimized/bootcamp-natal-vertical-cellular.mp4";
const horizontalVideoFallbackSrc = "/bootcamp/video-optimized/bootcamp-natal-horizontal-cellular.mp4";
const verticalVideoPoster = "/bootcamp/midias/thumbnail_1d1f0446.jpg";
const horizontalVideoPoster = content.templateAssets.stage04;
const brandingClientLogos = [
  { src: logoGrupoPrimo.src, alt: "Grupo Primo" },
  { src: logoAmcham.src, alt: "Amcham" },
  { src: logoGouvea.src, alt: "Gouvêa" },
  { src: logoTecfil.src, alt: "Tecfil" },
  { src: logoUfg.src, alt: "UFG" },
  { src: logoCreaPr.src, alt: "CREA-PR" },
];
const brandingFaq = [
  {
    question: "Até que dia vão as inscrições?",
    answer:
      "As inscrições ficarão abertas até três dias antes do evento ou até esgotarem as vagas. Recomendamos garantir o ingresso o quanto antes, pois as vagas são limitadas.",
  },
  {
    question: "Vocês fornecem certificado?",
    answer:
      "Sim. Todos os participantes recebem certificado digital de conclusão, reconhecendo sua participação na imersão do Bootcamp IA para Negócios®.",
  },
  {
    question: "Como será a alimentação?",
    answer: "O evento oferece coffee break à tarde e coquetel happy hour.",
  },
  {
    question: "Tem estacionamento?",
    answer: "O evento será no Bright Coworking Natal. Detalhes finais de acesso, estacionamento e chegada serão enviados aos inscritos antes da imersão.",
  },
];
const cityHeroImage = "/bootcamp/parque-cidade-natal-torre.jpg";
const cityForteImage = "/bootcamp/forte-dos-reis-magos-natal-1600.jpg";
const cityMorroImage = "/bootcamp/morro-do-careca-ponta-negra-natal.jpg";
const cityLandmarks = [
  {
    label: "Forte",
    title: "Estrutura",
    copy: "O Forte dos Reis Magos vira metáfora do dia: critério, base e método antes de qualquer ferramenta.",
    image: cityForteImage,
  },
  {
    label: "Dunas",
    title: "Trajetória",
    copy: "Das dunas à prática: sair do improviso, atravessar exercícios reais e chegar a um plano de aplicação.",
    image: cityMorroImage,
  },
  {
    label: "Potengi",
    title: "Fluxo",
    copy: "Dados, atendimento, conteúdo e operação precisam circular. IA entra para organizar esse fluxo.",
    image: cityHeroImage,
  },
  {
    label: "Ponta Negra",
    title: "Encontro",
    copy: "Uma turma presencial para aprender junto, trocar repertório e criar resenha boa depois da compra.",
    image: cityMorroImage,
  },
];
const cityRoute = [
  {
    time: "09:00",
    title: "Chegada",
    copy: "Credenciamento, leitura da turma e alinhamento do que cada pessoa quer tirar da IA.",
  },
  {
    time: "Manhã",
    title: "Método",
    copy: "Fundamentos, prompts, critérios de qualidade e repertório para decidir melhor.",
  },
  {
    time: "Tarde",
    title: "Prática",
    copy: "Agentes, chatbot, dados e conteúdo visual aplicados a situações reais de trabalho.",
  },
  {
    time: "18:00",
    title: "Plano",
    copy: "De rocha: você sai com prioridades, próximos passos e convite para o grupo oficial da turma.",
  },
];
const cityFaq = [
  {
    question: "Preciso saber programar?",
    answer: "Não. A proposta é IA sem aperreio: linguagem clara, prática guiada e exercícios que partem da rotina de trabalho.",
  },
  {
    question: "Como faço a inscrição?",
    answer: "Sem arrodeio: a compra acontece pela Sympla, e a confirmação chega por email com os dados da turma.",
  },
  {
    question: "O grupo de WhatsApp é obrigatório?",
    answer: "Não. O opt-in é voluntário depois da compra. O grupo serve para avisos, materiais, logística e networking.",
  },
  {
    question: "O local já está definido?",
    answer: "Sim. O Bootcamp será no Bright Coworking Natal, na Av. Dão Silveira, 3860 - Loja 03 - Parque das Colinas, Natal - RN, 59066-180.",
  },
];
const pageTitle = event && isValidVersion
  ? event.slug === "natal-23-07-26" && activeVersion === "cidade"
    ? "Bootcamp IA para Negócios em Natal | Amplify"
    : `${BOOTCAMP_VERSION_LABELS[activeVersion]} | Bootcamp ${event.city} | Amplify`
  : "Bootcamp não encontrado | Amplify";
const pageDescription = event && isValidVersion
  ? event.slug === "natal-23-07-26" && activeVersion === "cidade"
    ? "Dia 23/07, uma imersão presencial para líderes e profissionais que querem aplicar IA com método, clareza e resultado."
    : `Mockup ${BOOTCAMP_VERSION_LABELS[activeVersion]} da landing page do Bootcamp Amplify em ${event.city}, no dia ${event.date}.`
  : "Turma de Bootcamp não encontrada.";

if (!event || !isValidVersion) {
  Astro.response.status = 404;
}
---

<PageShell title={pageTitle} description={pageDescription} chatbot={false}>
  {event && isValidVersion ? (
    <main class={`boot-mockup boot-mockup--${activeVersion}`} data-bootcamp-slug={event.slug} data-bootcamp-version={activeVersion}>
      {activeVersion === "template" && (
        <>
          <section class="template-hero" aria-labelledby="template-title">
            <picture class="template-hero__media" aria-hidden="true">
              <source srcset={content.templateAssets.heroMobile} media="(max-width: 680px)" />
              <img src={content.templateAssets.hero} alt="" width="1600" height="900" loading="eager" />
            </picture>
            <div class="template-hero__overlay"></div>
            <header class="template-header">
              <a class="template-logo-mark" href="/" aria-label="Bootcamp IA para Negócios Natal">
                <img src={content.templateAssets.logo} alt="Bootcamp IA para Negócios Natal" width="398" height="148" loading="eager" />
              </a>
              <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-checkout-link>{content.template.cta}</a>
            </header>
            <div class="template-hero__copy">
              <p>{content.template.eyebrow}</p>
              <h1 id="template-title">{content.template.headline}</h1>
              <p>{content.template.lead}</p>
              <div class="template-meta" aria-label="Resumo do evento">
                <span>{content.longDateLabel}</span>
                <span>{content.cityLabel}</span>
                <span>Presencial</span>
                <span>{content.durationLabel}</span>
              </div>
              <div class="template-actions">
                <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-checkout-link>{content.template.cta}</a>
                <a class="template-actions__sponsor" href={sponsorUrl} target="_blank" rel="noopener noreferrer">Seja um Patrocinador</a>
                <span>{event.date} · {event.startTime} às {event.endTime}</span>
              </div>
            </div>
          </section>

          <section class="template-band template-band--proof" aria-label="Prova social">
            <p>Bootcamp IA para Negócios® Natal · {content.longDateLabel}</p>
            <strong>{content.template.proof}</strong>
            <div>
              <span>lideranças</span>
              <span>empreendedores</span>
              <span>profissionais liberais</span>
              <span>equipes corporativas</span>
            </div>
          </section>

          <section class="template-countdown" aria-label="Contagem regressiva">
            <p>{content.template.countdownTitle}</p>
            <div>
              <span><strong>44</strong>dias</span>
              <span><strong>09</strong>horas</span>
              <span><strong>30</strong>minutos</span>
              <span><strong>00</strong>segundos</span>
            </div>
          </section>

          <section class="template-section template-video" aria-labelledby="video-title">
            <div>
              <p>Última edição</p>
              <h2 id="video-title">{content.template.videoTitle}</h2>
            </div>
            <div class="template-video__frame bootcamp-video-card bootcamp-video-card--vertical" aria-label="Vídeo da edição anterior">
              <video class="bootcamp-video" poster={verticalVideoPoster} playsinline preload="metadata">
                <source src={verticalVideoSrc} type="video/mp4" />
              </video>
              <button type="button" class="bootcamp-video-play" aria-label="Reproduzir vídeo">
                <span>
                  <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M22 15.5v33c0 2.4 2.7 3.8 4.7 2.4l23.4-16.5c1.7-1.2 1.7-3.7 0-4.9L26.7 13.1c-2-1.4-4.7 0-4.7 2.4Z"></path></svg>
                </span>
              </button>
              <button type="button" class="bootcamp-video-fullscreen" aria-label="Abrir vídeo em tela cheia">
                <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M10 24V10h14v6h-8v8h-6Zm30-14h14v14h-6v-8h-8v-6ZM16 40v8h8v6H10V40h6Zm32 8v-8h6v14H40v-6h8Z"></path></svg>
              </button>
            </div>
          </section>

          <section class="template-section template-what" aria-labelledby="what-title">
            <div class="template-section__head">
              <p>Imersão presencial</p>
              <h2 id="what-title">{content.template.whatTitle}</h2>
            </div>
            <div class="template-what__copy">
              {content.template.whatCopy.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>

          <section class="template-section template-location" aria-label="Informações do evento">
            <figure>
              <img src={content.templateAssets.cityArt} alt="Arte visual do Bootcamp IA para Negócios" width="820" height="620" loading="lazy" />
            </figure>
            <article>
              <span>Data</span>
              <strong>{event.date}</strong>
              <p>{content.longDateLabel}</p>
            </article>
            <article>
              <span>Horário</span>
              <strong>{event.startTime} às {event.endTime}</strong>
              <p>{content.durationLabel}</p>
            </article>
            <article>
              <span>Local</span>
              <strong>{event.venue}</strong>
              <p>{event.address}</p>
            </article>
          </section>

          <section class="template-section" aria-labelledby="expect-title">
            <div class="template-section__head">
              <p>O que esperar</p>
              <h2 id="expect-title">Experiência intensiva, prática e presencial.</h2>
            </div>
            <div class="template-grid">
              {content.expectations.map((item) => (
                <article>
                  <h3>{item.title}</h3>
                  <p>{item.copy}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="template-section template-program" aria-labelledby="program-title">
            <div class="template-section__head">
              <p>Programação</p>
              <h2 id="program-title">4 work sessions para sair com repertório e aplicação.</h2>
            </div>
            <div class="template-program__list">
              {content.sessions.map((session, index) => (
                <article>
                  <img
                    src={[
                      content.templateAssets.session01,
                      content.templateAssets.session02,
                      content.templateAssets.session03,
                      content.templateAssets.session04,
                    ][index]}
                    alt=""
                    width="360"
                    height="240"
                    loading="lazy"
                  />
                  <span>{session.label}</span>
                  <h3>{session.title}</h3>
                </article>
              ))}
            </div>
          </section>

          <section class="template-section template-audience" aria-labelledby="audience-title">
            <div>
              <p>Para quem é</p>
              <h2 id="audience-title">Profissionais que querem aplicar IA no trabalho real.</h2>
            </div>
            <ul>
              {content.audience.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section class="template-section template-offers" aria-labelledby="offers-title">
            <div class="template-section__head">
              <p>Ingressos</p>
              <h2 id="offers-title">Escolha seu plano.</h2>
            </div>
            <div class="template-offers__grid">
              {content.offers.map((offer) => (
                <article>
                  <h3>{offer.title}</h3>
                  <strong>{offer.price}</strong>
                  <p>{offer.note}</p>
                  <ul>
                    {offer.items.map((item) => <li>{item}</li>)}
                  </ul>
                  <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-checkout-link>
                    {offer.title === "Plano individual" ? "Comprar ingresso" : "Falar com consultor"}
                  </a>
                </article>
              ))}
            </div>
          </section>

          <section class="template-section template-mentor" aria-labelledby="mentor-title">
            <img src={content.templateAssets.mentor} alt="Leonardo Camacho" width="720" height="900" loading="lazy" />
            <div>
              <p>Seu professor</p>
              <h2 id="mentor-title">{content.mentor.name}</h2>
              <strong>{content.mentor.title}</strong>
              <p>{content.mentor.bio}</p>
            </div>
            <aside>
              {content.stats.map((stat) => (
                <span><strong>{stat.value}</strong>{stat.label}</span>
              ))}
            </aside>
          </section>

          <section class="template-section template-quote" aria-label="Depoimento">
            <blockquote>“{content.testimonial.quote}”</blockquote>
            <p>{content.testimonial.author} · {content.testimonial.role}</p>
          </section>

          <section class="template-section template-faq" aria-labelledby="faq-title">
            <div class="template-section__head">
              <p>Dúvidas frequentes</p>
              <h2 id="faq-title">FAQ</h2>
            </div>
            {content.faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </section>

          <section class="template-final" aria-label="Comprar ingresso">
            <h2>Garanta sua vaga no Bootcamp IA para Negócios® Natal.</h2>
            <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-checkout-link>{content.template.cta}</a>
          </section>
        </>
      )}

      {activeVersion === "branding" && (
        <>
          <header class="bn-nav">
            <div class="bn-container bn-nav__inner">
              <a class="bn-nav__brand" href="/" aria-label="Voltar para a pagina inicial da Amplify">
                <img src={logoSrc} alt="Amplify" width="120" height="24" />
                <span>Bootcamp IA para Negócios® · Natal</span>
              </a>
              <div class="bn-nav__links">
                <a href="#programacao">Programação</a>
                <a href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-checkout-link>Garanta sua vaga</a>
              </div>
            </div>
          </header>

          <section class="bn-hero" aria-labelledby="bn-title">
            <img class="bn-hero__photo" src={heroSrc} alt="" width="1280" height="720" loading="eager" />
            <div class="bn-hero__scrim"></div>
            <span class="bn-pulse bn-pulse--hero" aria-hidden="true"></span>
            <div class="bn-container bn-hero__inner">
              <p class="bn-label">Bootcamp IA para Negócios® <span></span> Natal · {content.longDateLabel}</p>
              <h1 id="bn-title">Do zero ao <strong>método em 10 horas.</strong></h1>
              <p>
                Enquanto outros assistem tutoriais, você já está implementando IA na sua vida.
                Método prático + networking + cases reais. Presencial, intenso, irresistível.
              </p>
              <div class="bn-actions">
                <a class="bn-button bn-button--primary" href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-checkout-link>Garanta sua vaga <span aria-hidden="true">→</span></a>
                <a class="bn-button bn-button--secondary" href="#programacao">Ver programação</a>
                <a class="bn-button bn-button--ghost" href={sponsorUrl} target="_blank" rel="noopener noreferrer">Seja um Patrocinador</a>
              </div>
              <div class="bn-meta" aria-label="Resumo do evento">
                <span>{content.cityLabel}</span>
                <span>{content.longDateLabel}</span>
                <span>{event.startTime} às {event.endTime}</span>
                <span>{event.venue}</span>
                <span>{content.durationLabel}</span>
              </div>
            </div>
          </section>

          <section class="bn-section bn-split" aria-labelledby="bn-what-title" data-screen-label="O que é">
            <div>
              <p class="bn-label">O que é o Bootcamp</p>
              <h2 id="bn-what-title">Não é aula. É aceleração.</h2>
            </div>
            <div class="bn-copy">
              <p>
                Você já sabe que IA existe. Já testou. Viu potencial. Mas aí vem a verdade:
                testando você nunca sai do sandbox. O <strong>Bootcamp IA para Negócios®</strong> é
                para quem quer transformar curiosidade em método, método em operação, operação em resultado.
              </p>
              <p>
                10 horas de imersão estratégica com <strong>Leonardo Camacho</strong>. Você sai com
                um plano claro, ferramentas escolhidas e confiança para implementar.
              </p>
              <div class="bn-note"><strong>92%</strong> dos participantes aplicam IA em tarefas reais nos 7 dias seguintes.</div>
            </div>
          </section>

          <section class="bn-section bn-section--surface" aria-labelledby="bn-expect-title">
            <div class="bn-section__head">
              <p class="bn-label">O que esperar do Bootcamp</p>
              <h2 id="bn-expect-title">Uma experiência imersiva, prática e transformadora.</h2>
            </div>
            <div class="bn-grid">
              {content.expectations.map((item) => (
                <article>
                  <h3>{item.title}</h3>
                  <p>{item.copy}</p>
                </article>
              ))}
            </div>
          </section>

          <section id="programacao" class="bn-section" aria-labelledby="bn-program-title">
            <div class="bn-section__head">
              <p class="bn-label">Programação</p>
              <h2 id="bn-program-title">Quatro Work Sessions práticas e focadas.</h2>
              <p>
                Cada sessão combina exercícios reais, discussão de casos e aplicação conectada ao
                contexto de trabalho de quem está na sala.
              </p>
            </div>
            <div class="bn-program">
              {content.sessions.map((session, index) => (
                <article>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <h3>{session.title}</h3>
                    <p>{session.copy}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="bn-section" aria-labelledby="bn-audience-title">
            <div class="bn-section__head">
              <p class="bn-label">Para quem é</p>
              <h2 id="bn-audience-title">O Bootcamp é para quem está pronto para agir.</h2>
            </div>
            <div class="bn-audience">
              {content.audience.map((item) => (
                <p><span>→</span>{item}</p>
              ))}
            </div>
          </section>

          <section class="bn-section bn-experience" aria-labelledby="bn-experience-title">
            <img src={content.templateAssets.stage04} alt="Sala de aula presencial do Bootcamp" width="720" height="480" loading="lazy" />
            <div>
              <p class="bn-label">O que está incluído</p>
              <h2 id="bn-experience-title">Experiência presencial completa.</h2>
              <ul>
                <li>Ingresso para 10 horas de imersão</li>
                <li>Certificado de Conclusão</li>
                <li>Coffee Break e networking</li>
                <li>Grupo de WhatsApp exclusivo da turma <small>para troca de experiências, informações e networking</small></li>
              </ul>
            </div>
          </section>

          <section class="bn-section bn-video-stats" aria-labelledby="bn-video-title">
            <div class="bn-section__head">
              <p class="bn-label">Assista ao vídeo</p>
              <h2 id="bn-video-title">Veja como foi a última edição do Bootcamp.</h2>
              <p>Interação real, cases concretos e pessoas saindo com método.</p>
            </div>
            <div class="bn-video-card bootcamp-video-card bootcamp-video-card--horizontal" aria-label="Vídeo da última edição do Bootcamp">
              <video class="bootcamp-video" poster={horizontalVideoPoster} playsinline preload="metadata">
                <source src={horizontalVideoSrc} type="video/mp4" media="(min-width: 720px)" />
                <source src={horizontalVideoFallbackSrc} type="video/mp4" />
              </video>
              <button type="button" class="bn-video-play bootcamp-video-play" aria-label="Reproduzir vídeo">
                <span>
                  <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M22 15.5v33c0 2.4 2.7 3.8 4.7 2.4l23.4-16.5c1.7-1.2 1.7-3.7 0-4.9L26.7 13.1c-2-1.4-4.7 0-4.7 2.4Z"></path></svg>
                </span>
              </button>
              <button type="button" class="bootcamp-video-fullscreen" aria-label="Abrir vídeo em tela cheia">
                <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M10 24V10h14v6h-8v8h-6Zm30-14h14v14h-6v-8h-8v-6ZM16 40v8h8v6H10V40h6Zm32 8v-8h6v14H40v-6h8Z"></path></svg>
              </button>
            </div>
            <div class="bn-section__head bn-section__head--center">
              <p class="bn-label">Um plano de ação prático</p>
              <h2>Com ferramentas aplicáveis e uma metodologia que transforma.</h2>
            </div>
            <div class="bn-stats">
              {content.stats.map((stat) => (
                <article>
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </article>
              ))}
            </div>
          </section>

          <section class="bn-section bn-section--surface bn-mentor" aria-labelledby="bn-mentor-title">
            <img src={content.templateAssets.mentor} alt="Leonardo Camacho" width="720" height="900" loading="lazy" />
            <div>
              <p class="bn-label">Quem será seu professor?</p>
