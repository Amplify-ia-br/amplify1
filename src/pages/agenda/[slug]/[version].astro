  .bn-video-card {
    position: relative;
    width: min(100%, 1280px);
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    margin: 0 auto 54px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgba(34, 224, 211, 0.16), transparent 18rem),
      #111414;
    border-radius: 14px;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.42);
