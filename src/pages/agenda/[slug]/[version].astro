{event && isValidVersion && (
  <script is:inline define:vars={{ slug: event.slug, version: activeVersion }}>
    function preserveUtm(link) {
      try {
        const url = new URL(link.href);
        const current = new URL(window.location.href);
        ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"].forEach((key) => {
          const value = current.searchParams.get(key);
          if (value && !url.searchParams.has(key)) url.searchParams.set(key, value);
        });
        link.href = url.toString();
      } catch (_error) {}
    }

    function track(eventName) {
      const payload = JSON.stringify({ slug, version, eventName, pageUrl: window.location.href });
      if (navigator.sendBeacon) {
        navigator.sendBeacon("/api/bootcamp-track", new Blob([payload], { type: "application/json" }));
        return;
      }
      fetch("/api/bootcamp-track", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: payload,
        keepalive: true,
      }).catch(() => {});
    }

    document.querySelectorAll("[data-checkout-link]").forEach((link) => {
      preserveUtm(link);
      link.addEventListener("click", () => track("bootcamp:checkout_clicado"));
    });

    const cityRoot = document.querySelector(".boot-mockup--cidade");
    if (cityRoot) {
      const progress = cityRoot.querySelector(".tp-nav__progress");
      const updateProgress = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
        if (progress) progress.style.width = `${pct}%`;
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const startCounts = (root) => {
        root.querySelectorAll("[data-count-to]").forEach((el) => {
          const to = parseInt(el.getAttribute("data-count-to") || "0", 10);
          const prefix = el.getAttribute("data-prefix") || "";
          const suffix = el.getAttribute("data-suffix") || "";
          if (reduced) {
            el.textContent = `${prefix}${to}${suffix}`;
            return;
          }
          let start = null;
          const tick = (timestamp) => {
            if (!start) start = timestamp;
            const progress = Math.min((timestamp - start) / 1400, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = `${prefix}${Math.round(to * eased)}${suffix}`;
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      };

      cityRoot.querySelectorAll("[data-stagger]").forEach((group) => {
        Array.from(group.children).forEach((child, index) => {
          child.style.transitionDelay = `${index * 80}ms`;
        });
      });

      if ("IntersectionObserver" in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("in-view");
              if (entry.target.hasAttribute("data-count-root")) startCounts(entry.target);
              revealObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.22 }
        );
        cityRoot.querySelectorAll(".tp-reveal, .tp-session, [data-count-root]").forEach((el) => revealObserver.observe(el));
      } else {
        cityRoot.querySelectorAll(".tp-reveal, .tp-session").forEach((el) => el.classList.add("in-view"));
        cityRoot.querySelectorAll("[data-count-root]").forEach(startCounts);
      }

      cityRoot.querySelectorAll(".tp-faq__q").forEach((button) => {
        button.addEventListener("click", () => {
          const item = button.closest(".tp-faq__item");
          const answer = item?.querySelector(".tp-faq__a");
          if (!item || !answer) return;
          const isOpen = item.classList.contains("open");
          cityRoot.querySelectorAll(".tp-faq__item.open").forEach((openItem) => {
            if (openItem === item) return;
            openItem.classList.remove("open");
            const openAnswer = openItem.querySelector(".tp-faq__a");
            const openButton = openItem.querySelector(".tp-faq__q");
            if (openAnswer) openAnswer.style.maxHeight = "0px";
            if (openButton) openButton.setAttribute("aria-expanded", "false");
          });
          item.classList.toggle("open", !isOpen);
          answer.style.maxHeight = isOpen ? "0px" : `${answer.scrollHeight}px`;
          button.setAttribute("aria-expanded", String(!isOpen));
        });
      });

      const stickyCta = cityRoot.querySelector(".tp-sticky-cta");
      const offerSection = cityRoot.querySelector("#oferta");
      if (stickyCta && offerSection && "IntersectionObserver" in window) {
        const stickyObserver = new IntersectionObserver(
          ([entry]) => stickyCta.classList.toggle("is-visible", entry.boundingClientRect.top < 0 && !entry.isIntersecting),
          { threshold: 0 }
        );
        stickyObserver.observe(offerSection);
      }
    }

    document.querySelectorAll(".bootcamp-video-card").forEach((card) => {
      const video = card.querySelector("video");
      const playButton = card.querySelector(".bootcamp-video-play");
      const fullscreenButton = card.querySelector(".bootcamp-video-fullscreen");
      if (!video || !playButton) return;

      const previewFrame = Number(video.dataset.previewFrame);
      if (Number.isFinite(previewFrame) && previewFrame > 0) {
        const loadPreviewFrame = () => {
          if (video.currentTime > 0 || video.readyState < 1) return;
          try {
            video.currentTime = previewFrame;
          } catch (error) {
            // Some mobile browsers block programmatic seeking before the first user gesture.
          }
        };
        if (video.readyState >= 1) loadPreviewFrame();
        else video.addEventListener("loadedmetadata", loadPreviewFrame, { once: true });
      }

      playButton.addEventListener("click", () => {
        video.setAttribute("controls", "controls");
        video.play().catch(() => {});
      });

      video.addEventListener("play", () => {
        card.classList.add("is-playing");
        track("bootcamp:video_play");
      }, { once: true });

      video.addEventListener("pause", () => {
        if (!video.ended) card.classList.remove("is-playing");
      });

      video.addEventListener("ended", () => {
        card.classList.remove("is-playing");
      });

      fullscreenButton?.addEventListener("click", () => {
        if (video.requestFullscreen) video.requestFullscreen();
        else if (video.webkitEnterFullscreen) video.webkitEnterFullscreen();
      });
    });

    fetch(`/api/bootcamp-status?slug=${encodeURIComponent(slug)}`)
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        const label = document.querySelector("[data-status-label]");
        if (!label || !data?.statusLabel) return;
        label.textContent = data.statusLabel;
      })
      .catch(() => {});
  </script>
)}

