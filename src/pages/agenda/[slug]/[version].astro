  .bn-video-card video {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 38%;
    border-radius: 8px;
    filter: brightness(0.78);
    transform: scale(1.01);
    transition:
      filter 220ms ease,
