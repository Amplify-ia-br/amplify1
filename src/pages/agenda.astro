---
import PageShell from "@/layouts/PageShell.astro";
import Agenda from "@/pages/_Agenda.tsx";
import { getImage } from "astro:assets";
import fernandoImage from "@/assets/founders/fernando-godoy.png";

const [fernandoAvif, fernandoWebp] = await Promise.all([
  getImage({ src: fernandoImage, format: "avif", quality: 55, widths: [160, 240, 320] }),
  getImage({ src: fernandoImage, format: "webp", quality: 65, widths: [160, 240, 320] }),
]);

const optimizedFernando = {
  avifSrcSet: fernandoAvif.srcSet.attribute,
  webpSrcSet: fernandoWebp.srcSet.attribute,
  fallbackSrc: fernandoWebp.src,
  sizes: "(max-width: 768px) 128px, 160px",
  width: fernandoWebp.attributes.width,
  height: fernandoWebp.attributes.height,
};
---
<PageShell title="Agenda | Amplify">
  <Agenda fernandoImage={optimizedFernando} client:load />
</PageShell>
