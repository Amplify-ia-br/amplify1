  /* Confirmation: a quiet, static typographic conclusion. */
  .thanks{
    --confirmation-pink:#c8184a;
    --confirmation-dark:#8f1136;
    --confirmation-paper:#fff8f2;
    position:fixed;
    inset:0;
    display:grid;
    grid-template-rows:auto minmax(0,1fr) auto;
    width:100%;
    height:100dvh;
    min-height:100svh;
    overflow:hidden;
    padding:clamp(18px,3vh,30px) clamp(22px,3.85vw,60px);
    color:var(--confirmation-paper);
    background-color:var(--confirmation-pink);
    background-image:var(--paper-texture);
    background-size:720px;
    background-blend-mode:multiply;
    visibility:hidden;
    opacity:0;
    transform:none;
    transition:none;
  }
  .page[data-view="thanks"] .thanks{visibility:visible;opacity:1;transform:none;transition:none}
  .thanks::before,.thanks::after{display:none}
  .thanks-head,.thanks-foot{z-index:2}
  .thanks-main{
    position:relative;
    z-index:2;
    top:auto;
    left:auto;
    align-self:center;
    width:min(920px,76vw);
    margin:0 0 0 clamp(32px,6.8vw,106px);
    padding:0;
    transform:none;
  }
  .thanks-main h2{
    max-width:920px;
    font-size:clamp(66px,7.1vw,110px);
    line-height:.86;
    letter-spacing:-.085em;
  }
  .thanks-index{margin-top:clamp(22px,2.8vh,28px)}
  .thanks-main>p:nth-of-type(2){width:min(590px,72%);margin-top:clamp(20px,2.6vh,27px)}
  .thanks-actions{margin-top:clamp(22px,2.8vh,29px)}
  .thanks-actions button{height:62px;transition:none}
  @media(max-width:980px){
    .thanks-main{top:auto;left:auto;width:88%;margin-left:4vw}
    .thanks-main h2{font-size:min(9.8vw,9.4vh,88px)}
    .thanks-main>p:nth-of-type(2){width:min(570px,78%)}
  }
  @media(max-width:680px){
    .thanks{padding:13px 15px max(14px,env(safe-area-inset-bottom))}
    .thanks-head{grid-template-columns:auto 1fr auto;font-size:6px;column-gap:8px}
    .thanks-head p:nth-child(2){display:block;text-align:center}
    .thanks-main{top:auto;left:auto;width:100%;margin:0;padding:0}
    .thanks-main h2{width:100%;font-size:min(11.7vw,7.3vh,48px);line-height:.91;letter-spacing:-.068em}
    .thanks-main h2 span{white-space:nowrap}
    .thanks-index{margin-top:16px}
    .thanks-main>p:nth-of-type(2){width:100%;margin-top:19px;font-size:14px;line-height:1.24}
    .thanks-actions{display:grid;margin-top:20px;gap:10px}
    .thanks-actions button{width:100%;min-width:0;height:46px}
    .thanks-foot{display:flex;align-items:center;justify-content:space-between;min-height:57px;padding-top:12px;gap:8px}
    .thanks-foot .amplify{width:76px}
    .thanks-foot .shock{width:55px}
    .thanks-foot>p{flex:0 1 108px;max-width:108px;font-size:5px;line-height:1.25}
  }
  @media(max-height:720px) and (min-width:681px){
    .thanks-main{margin-left:4vw}
    .thanks-main h2{font-size:min(6.5vw,10.5vh,82px)}
    .thanks-index{margin-top:14px}
    .thanks-main>p:nth-of-type(2){margin-top:16px;font-size:15px}
    .thanks-actions{margin-top:16px}
    .thanks-actions button{height:50px}
    .thanks-foot{min-height:68px}
  }
  @media(max-width:380px),(max-height:640px){
    .thanks-main{top:auto;margin-left:0}
    .thanks-main h2{font-size:min(11vw,6.8vh,42px)}
    .thanks-index{margin-top:11px}
    .thanks-main>p:nth-of-type(2){margin-top:13px;font-size:13px}
    .thanks-actions{margin-top:13px;gap:7px}
    .thanks-actions button{height:42px}
    .thanks-foot{min-height:46px}
  }
  .thanks-foot .xvia{filter:grayscale(1) brightness(0) invert(1)}
  @media(max-width:680px){
    .invite-foot .brands{gap:5px}
    .invite-foot .amplify{width:65px}
    .invite-foot .shock{width:41px}
    .invite-foot .xvia{width:62px}
    .invite-foot .brands>span{font-size:10px}
    .thanks-foot .brands{gap:5px}
    .thanks-foot .amplify{width:62px}
    .thanks-foot .shock{width:38px}
    .thanks-foot .xvia{width:56px}
    .thanks-foot .brands>span{font-size:10px}
    .thanks-foot>p{max-width:108px}
  }
  /* Expanded editorial landing — the approved save-the-date becomes the first fold. */
  :global(html){height:auto;scroll-behavior:smooth;scroll-padding-top:72px}
  :global(body){height:auto;overflow-x:hidden;overflow-y:auto;background:#f0eee6}
  .page{--cyan-ink:#006a73;width:100%;height:auto;min-height:100svh;overflow:visible;padding:0;background-color:var(--paper)}
