---
import PageShell from "@/layouts/PageShell.astro";
import { Picture } from "astro:assets";
import logoAmplify from "@/assets/logo-amplify-color.png";
import logoShockwave from "@/assets/amplify-day/shockwave.webp";
import logoXvia from "@/assets/amplify-day/xvia-white.png";
import paperTexture from "@/assets/amplify-day/editorial-paper.webp";
import brasiliaVertical from "@/assets/amplify-day/visual-kit/catedral-tres-poderes.webp";
import tesourinhaAerea from "@/assets/amplify-day/visual-kit/tesourinha-aerea.webp";
import candangosPhoto from "@/assets/amplify-day/visual-kit/candangos.webp";
import ulyssesPhoto from "@/assets/amplify-day/ulysses-preview.jpeg";
import logoTecfil from "@/assets/logos/logo-tecfil.png";
import logoToccato from "@/assets/logos/logo-toccato.png";
import logoCrea from "@/assets/logos/logo-crea-pr.png";
import logoUfg from "@/assets/logos/logo-ufg.png";
import logoGouvea from "@/assets/logos/logo-gouvea.png";
import logoAmcham from "@/assets/logos/logo-amcham.png";
import logoGrupoPrimo from "@/assets/logos/logo-grupo-primo.png";
import logoDwx from "@/assets/logos/logo-dwx.png";
import GrafismoCupulas from "@/components/amplify-day/visual-kit/grafismos/GrafismoCupulas.astro";
import GrafismoNave from "@/components/amplify-day/visual-kit/grafismos/GrafismoNave.astro";
import GrafismoCandangos from "@/components/amplify-day/visual-kit/grafismos/GrafismoCandangos.astro";
import GrafismoTesourinha from "@/components/amplify-day/visual-kit/grafismos/GrafismoTesourinha.astro";
import GrafismoSuperquadra from "@/components/amplify-day/visual-kit/grafismos/GrafismoSuperquadra.astro";
import GrafismoEixo from "@/components/amplify-day/visual-kit/grafismos/GrafismoEixo.astro";
import FitaDeDados from "@/components/amplify-day/visual-kit/motion/FitaDeDados.astro";
import ImagemReticula from "@/components/amplify-day/visual-kit/imagem/ImagemReticula.astro";
import ImagemDuotone from "@/components/amplify-day/visual-kit/imagem/ImagemDuotone.astro";
const title = "Amplify Day 2026 | Reserve a data";
const description = "Amplify Day. Evento presencial em Brasília, 23 de setembro de 2026. Participação por convite.";
const echoes = [-92, -72, -54, -39, -26, -15, -7];
const organizationLogos = [
  { src: logoTecfil.src, alt: "Tecfil" },
  { src: logoToccato.src, alt: "Toccato" },
  { src: logoCrea.src, alt: "CREA-PR" },
  { src: logoUfg.src, alt: "UFG" },
  { src: logoGouvea.src, alt: "Gouvêa Ecosystem" },
  { src: logoAmcham.src, alt: "Amcham" },
  { src: logoGrupoPrimo.src, alt: "Grupo Primo" },
  { src: logoDwx.src, alt: "DWX" },
];
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "Amplify Day 2026",
  description,
  startDate: "2026-09-23",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: "Ulysses Centro de Convenções",
    address: {
      "@type": "PostalAddress",
      streetAddress: "SDC, Eixo Monumental, Lote 05",
      addressLocality: "Brasília",
      addressRegion: "DF",
      postalCode: "70655-775",
      addressCountry: "BR",
    },
  },
  organizer: [
    { "@type": "Organization", name: "Amplify", url: "https://amplify.ia.br/" },
    { "@type": "Organization", name: "Shock Wave", url: "https://shockwave.academy/" },
    { "@type": "Organization", name: "X-VIA" },
  ],
};
---

<PageShell title={title} description={description} chatbot={false} marketingScripts={false} globalStylesheet={false}>
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <main class="page" data-page data-view="invite" aria-labelledby="event-title" style={`--paper-texture:url(${paperTexture.src})`}>
    <section class="invite" aria-label="Convite para o Amplify Day" aria-hidden="false">
      <nav class="editorial-nav" aria-label="Navegação do Amplify Day">
        <a class="nav-brand" href="#inicio">Amplify Day</a>
        <div class="nav-meta"><span>23 set 2026</span><span>Ulysses · Brasília</span></div>
        <div class="nav-links">
          <a href="#experiencia">Experiência</a><a href="#para-quem">Para quem</a><a href="#local">Local</a><a href="#coalizadoras">Coalizadoras</a>
        </div>
        <button class="nav-cta" type="button" data-open data-cta-position="nav">Entrar na lista prioritária</button>
      </nav>

      <section class="hero" id="inicio">
        <div class="hero-head">
          <p class="event-name" id="event-title">Amplify Day</p>
          <p class="purpose">
            <span>Um dia de imersão em inteligência artificial.</span>
            <span>Conversas que geram decisão.</span>
            <span>Palestrantes de impacto.</span>
            <em>Sua inteligência amplificada.</em>
          </p>
        </div>

        <div class="hero-date" aria-label="23 de setembro de 2026">
          <div class="field" aria-hidden="true">
            {echoes.map((offset, index) => (
              <span class="echo" style={`--offset:${offset}px;--peak:${offset * 1.08}px;--delay:${index * 52}ms;--alpha:${0.07 + index * 0.02}`}>23</span>
            ))}
            <span class="core">23</span><span class="signal"></span>
          </div>
          <div class="date-caption"><span>Set</span><span>2026</span></div>
        </div>

        <div class="hero-image" aria-label="Brasília, sede do Amplify Day">
          <ImagemReticula src={brasiliaVertical.src} alt="Arquitetura de Brasília sob o céu azul" loading="eager" step="7px" speed={0.18} />
          <span class="hero-image-label">Brasília · DF</span>
        </div>

        <aside class="hero-action">
          <div class="save"><span>01</span><h1>Reserve<br />a data</h1></div>
          <p class="hero-audience">Um encontro presencial, por convite, para quem decide, influencia ou coloca IA em prática.</p>
          <button class="primary" type="button" data-open data-cta-position="hero"><span>Entrar na lista prioritária</span></button>
          <p class="cta-note">Cadastre seu interesse. Nosso time entra em contato após analisar seu perfil.</p>
        </aside>

        <footer class="hero-foot">
          <div class="brands" aria-label="Coalizadoras: Amplify, Shock Wave e X-VIA">
            <img class="amplify" src={logoAmplify.src} alt="Amplify" width="1301" height="204" />
            <span aria-hidden="true">+</span>
            <img class="shock" src={logoShockwave.src} alt="Shock Wave" width="500" height="331" />
            <span aria-hidden="true">+</span>
            <img class="xvia" src={logoXvia.src} alt="X-VIA" width="3426" height="774" />
          </div>
          <p>23 set 2026 <i>·</i> Brasília <i>·</i> Presencial</p>
        </footer>
      </section>

      <div class="data-strip"><FitaDeDados items={["AMPLIFY DAY", "23 SET 2026", "BRASÍLIA", "PRESENCIAL", "POR CONVITE"]} repeat={3} speed={0.28} /></div>

      <section class="experience section-shell" id="experiencia">
        <header class="section-heading">
          <span>02 · Experiência</span>
          <h2>Duas plenárias.<br />Conversas em escalas diferentes.</h2>
        </header>
        <div class="stage-grid">
          <article class="stage stage-main">
            <div class="stage-art"><GrafismoCupulas animated={true} speed={0.18} title="Duas cúpulas representam conversa e decisão" /></div>
            <p class="stage-index">Plenária 01</p>
            <h3>Plenária principal</h3>
            <p>Palestras de impacto, visões e decisões que precisam chegar à liderança.</p>
          </article>
          <article class="stage stage-panels">
            <div class="stage-art"><GrafismoNave animated={false} title="Linhas da Catedral se expandem em várias direções" /></div>
            <p class="stage-index">Plenária 02</p>
            <h3>Palco de painéis</h3>
            <p>Conversas com mais contexto, confronto de experiências e espaço para perguntas.</p>
          </article>
        </div>
        <p class="program-note">Temas e participantes serão anunciados durante a curadoria da programação.</p>
      </section>

      <section class="city-transition" aria-label="Brasília vista de cima">
        <ImagemDuotone src={tesourinhaAerea.src} alt="Vista aérea das tesourinhas de Brasília" tint={0.24} scrim={0.1} />
        <p><span>Não é sobre assistir.</span><strong>É sobre sair com critério.</strong></p>
      </section>

      <section class="audience section-shell" id="para-quem">
        <div class="audience-heading">
          <span>03 · Para quem</span>
          <h2>Para quem a IA já virou responsabilidade.</h2>
        </div>
        <div class="audience-graphic"><GrafismoCandangos animated={true} speed={0.22} title="Os Candangos representam quem constrói e implementa" /></div>
        <ol class="responsibility-list">
          <li><span>01</span><p>Decide prioridades, investimentos ou políticas.</p></li>
          <li><span>02</span><p>Lidera equipes, produtos, operações ou transformação.</p></li>
          <li><span>03</span><p>Implementa IA e precisa conectar execução a impacto.</p></li>
        </ol>
        <div class="curation">
          <p class="curation-label">Como funciona a curadoria</p>
          <ol><li>Você entra na lista prioritária.</li><li>Nosso time conhece o seu contexto.</li><li>Os convites são enviados conforme a composição da sala.</li></ol>
          <button class="secondary-cta" type="button" data-open data-cta-position="audience">Entrar na lista prioritária <span>→</span></button>
        </div>
      </section>

      <section class="location" id="local">
        <div class="location-media">
          <Picture src={ulyssesPhoto} formats={["avif", "webp"]} widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 58vw" alt="Centro de Convenções Ulysses Guimarães visto do alto" loading="lazy" />
          <p>Ulysses Centro de Convenções · Brasília</p>
        </div>
        <div class="location-copy">
          <span>04 · Local</span>
          <h2>Brasília, no centro das decisões.</h2>
          <div class="location-mark"><GrafismoTesourinha animated={false} /></div>
          <p class="venue">Ulysses Centro de Convenções</p>
          <address>SDC, Eixo Monumental, Lote 05<br />Brasília · DF · 70655-775</address>
          <p>Desembarque fácil por táxi ou aplicativo, próximo aos setores hoteleiros e com estacionamento terceirizado no complexo.</p>
          <a class="map-link" href="https://www.google.com/maps/search/?api=1&query=Ulysses+Centro+de+Conven%C3%A7%C3%B5es+Bras%C3%ADlia" target="_blank" rel="noopener" data-map>Ver no mapa <span>↗</span></a>
        </div>
      </section>

      <section class="coalition section-shell" id="coalizadoras">
        <div class="coalition-image"><ImagemReticula src={candangosPhoto.src} alt="Monumento Os Candangos e Congresso Nacional ao pôr do sol" step="8px" animated={false} /></div>
        <header class="coalition-heading">
          <span>05 · Coalizadoras</span>
          <h2>Três trajetórias.<br />Uma sala em comum.</h2>
        </header>
        <div class="coalition-grid">
          <article><p class="org-name">Amplify</p><h3>IA aplicada à transformação real.</h3><p>Educação corporativa, consultoria e comunidades para transformar conhecimento em capacidade de execução.</p><dl><div><dt>130 mil+</dt><dd>alunos capacitados</dd></div><div><dt>1 mil+</dt><dd>treinamentos</dd></div></dl></article>
          <article><p class="org-name">Shock Wave</p><h3>Criatividade e fluência para mover negócios.</h3><p>Aprendizado prático, repertório e aplicação de inteligência artificial no trabalho e nas decisões.</p></article>
          <article><p class="org-name">X‑VIA</p><h3>Pioneirismo em governo digital no Brasil.</h3><p>Desde 2014, aproxima governo e cidadão por meio de tecnologia, serviços e novas experiências públicas.</p></article>
        </div>
        <div class="amplify-fronts" aria-label="Frentes de atuação da Amplify"><span>Capacitação</span><span>Consultoria e Serviços</span><span>Comunidades</span></div>
      </section>

      <section class="proof section-shell" aria-labelledby="proof-title">
        <div class="proof-art"><GrafismoSuperquadra columns={12} rows={4} lit={[3, 9, 14, 20, 27, 34, 41]} animated={false} /></div>
        <header><span>06 · Histórico</span><h2 id="proof-title">Organizações já impactadas pelas coalizadoras.</h2><p>Relações de trabalho e transformação. Estas marcas não indicam patrocínio, participação ou apoio ao evento.</p></header>
        <div class="logo-wall">{organizationLogos.map((logo) => <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />)}</div>
      </section>

      <section class="faq section-shell" id="faq">
        <header><span>07 · Perguntas frequentes</span><h2>O que você precisa saber agora.</h2></header>
        <div class="faq-list">
          <details><summary>Para quem é o Amplify Day?</summary><p>Para quem decide, influencia ou implementa inteligência artificial e já precisa conectar escolhas a impacto.</p></details>
          <details><summary>O cadastro confirma a participação?</summary><p>Não. Ele registra seu interesse para a curadoria. Os convites serão enviados conforme a composição da sala.</p></details>
          <details><summary>Quando programação e palestrantes serão anunciados?</summary><p>Durante a curadoria da programação. Quem estiver na lista prioritária receberá as novidades primeiro.</p></details>
          <details><summary>Onde será realizado?</summary><p>No Ulysses Centro de Convenções, em Brasília, no dia 23 de setembro de 2026.</p></details>
          <details><summary>Como receberei as próximas informações?</summary><p>Pelo e-mail informado no cadastro. Após concluir o perfil, você também poderá entrar no grupo de WhatsApp.</p></details>
        </div>
      </section>

      <section class="final-cta section-shell">
        <div class="final-axis"><GrafismoEixo animated={false} /></div>
        <p>23 set 2026 · Brasília · Presencial</p>
        <h2>Entre agora.<br />O convite vem depois.</h2>
        <p class="final-copy">Cadastre seu interesse para acompanhar a construção do Amplify Day e participar da curadoria.</p>
        <button class="primary final-button" type="button" data-open data-cta-position="final"><span>Entrar na lista prioritária</span></button>
      </section>

      <footer class="site-foot section-shell">
        <div class="brands" aria-label="Coalizadoras: Amplify, Shock Wave e X-VIA"><img class="amplify" src={logoAmplify.src} alt="Amplify" width="1301" height="204" /><span aria-hidden="true">+</span><img class="shock" src={logoShockwave.src} alt="Shock Wave" width="500" height="331" /><span aria-hidden="true">+</span><img class="xvia" src={logoXvia.src} alt="X-VIA" width="3426" height="774" /></div>
        <p>Uma conversa à altura de quem decide.</p>
      </footer>
    </section>

    <section class="response" aria-labelledby="response-title" aria-hidden="true" inert>
      <header class="response-head"><p>Amplify Day</p><button type="button" data-close>Voltar ao convite</button></header>
      <div class="response-grid">
        <div class="response-copy">
          <p>Lista prioritária · 01</p>
          <h2 id="response-title">Entre<br />na lista</h2>
          <p>Deixe seu nome e e-mail para receber primeiro as próximas informações sobre o Amplify Day.</p>
        </div>
        <form class="form" data-form novalidate>
          <label><span>Nome</span><input type="text" name="name" autocomplete="name" required /><small data-error="name" hidden>Informe seu nome.</small></label>
          <label><span>E-mail</span><input type="email" name="email" autocomplete="email" inputmode="email" required /><small data-error="email" hidden>Informe um e-mail válido.</small></label>
          <label class="website-field" aria-hidden="true"><span>Website</span><input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          <button class="submit" type="submit">Continuar</button>
          <p class="note" data-note role="status" aria-live="polite">Ao continuar, você autoriza o contato sobre o Amplify Day. Consulte nossa <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a>.</p>
        </form>
      </div>
      <footer class="response-foot">
        <p>23 set 2026 · Brasília · Presencial</p>
        <div class="brands" aria-label="Coalizadoras: Amplify, Shockwave e X-VIA">
          <img class="amplify" src={logoAmplify.src} alt="Amplify" width="1301" height="204" /><span aria-hidden="true">+</span>
          <img class="shock" src={logoShockwave.src} alt="Shockwave" width="500" height="331" />
          <span aria-hidden="true">+</span><img class="xvia" src={logoXvia.src} alt="X-VIA" width="3426" height="774" />
        </div>
      </footer>
    </section>

    <section class="qualification" aria-labelledby="qualification-title" aria-hidden="true" inert>
      <button class="qualification-backdrop" type="button" data-qualification-close aria-label="Voltar ao formulário inicial"></button>
      <div class="qualification-panel" role="dialog" aria-modal="true" aria-labelledby="qualification-title">
        <div class="pink-echoes" aria-hidden="true"><span>Liderança</span><span>Liderança</span><span>Liderança</span><span>Liderança</span></div>
        <header class="qualification-head"><p>Amplify Day · Contexto</p><button type="button" data-qualification-close>Voltar</button></header>
        <div class="qualification-grid">
          <div class="qualification-copy">
            <p class="qualification-index">02 · Sua presença importa</p>
            <h2 id="qualification-title">Onde a sua<br />liderança acontece?</h2>
            <p>Esta sala está sendo formada por líderes que movem empresas, setores e causas relevantes. Conte-nos sobre o lugar que você ocupa nessa conversa.</p>
          </div>
          <form class="qualification-form" data-qualification-form novalidate>
            <label><span>Organização</span><input type="text" name="organization" autocomplete="organization" required /><small data-q-error="organization" hidden>Informe sua organização.</small></label>
            <label><span>Cargo ou papel de liderança</span><input type="text" name="role" autocomplete="organization-title" required /><small data-q-error="role" hidden>Informe seu cargo ou papel.</small></label>
            <label><span>LinkedIn <i>opcional</i></span><input type="url" name="linkedin" inputmode="url" placeholder="linkedin.com/in/seu-perfil" /></label>
            <label class="content-consent"><input type="checkbox" name="marketingConsent" value="true" /><span>Quero receber também conteúdos, análises e convites da Amplify e Shock Wave.</span></label>
            <button class="qualification-submit" type="submit"><span>Concluir meu cadastro</span><b aria-hidden="true">→</b></button>
            <p class="qualification-note" data-qualification-note role="status" aria-live="polite">Seus dados ficam salvos conforme você avança.</p>
          </form>
        </div>
      </div>
    </section>

    <section class="thanks" aria-labelledby="thanks-title" aria-hidden="true" inert>
      <header class="thanks-head"><p>Amplify Day</p><p>23 set 2026 · Brasília</p><p>Perfil recebido</p></header>
      <div class="thanks-main">
        <h2 id="thanks-title"><span>Sua presença</span><span>Amplifica <em>tudo.</em></span></h2>
        <p class="thanks-index">03 · Lista prioritária</p>
        <p>Obrigado por contar um pouco sobre você. Você entrou na lista prioritária. Avisaremos por e-mail quando a curadoria de convites abrir.<strong> Reserve 23 de setembro.</strong></p>
        <div class="thanks-actions"><button type="button" data-calendar>Adicionar à agenda</button><a href="#" data-whatsapp hidden target="_blank" rel="noopener">Entrar no grupo de WhatsApp</a><button type="button" data-restart>Rever o convite</button></div>
      </div>
      <footer class="thanks-foot">
        <div class="brands" aria-label="Coalizadoras: Amplify, Shockwave e X-VIA"><img class="amplify" src={logoAmplify.src} alt="Amplify" width="1301" height="204" /><span aria-hidden="true">+</span><img class="shock" src={logoShockwave.src} alt="Shockwave" width="500" height="331" /><span aria-hidden="true">+</span><img class="xvia" src={logoXvia.src} alt="X-VIA" width="3426" height="774" /></div>
        <p>Uma conversa à altura de quem decide.</p>
      </footer>
    </section>
  </main>

  <script>
    const STORAGE_KEY = "amplify-day-lead";
    const page = document.querySelector<HTMLElement>("[data-page]");
    const response = document.querySelector<HTMLElement>(".response");
    const invite = document.querySelector<HTMLElement>(".invite");
    const form = document.querySelector<HTMLFormElement>("[data-form]");
    const openButtons = document.querySelectorAll<HTMLButtonElement>("[data-open]");
    const open = openButtons[0] || null;
    const close = document.querySelector<HTMLButtonElement>("[data-close]");
    const qualification = document.querySelector<HTMLElement>(".qualification");
    const thanks = document.querySelector<HTMLElement>(".thanks");
    const qualificationForm = document.querySelector<HTMLFormElement>("[data-qualification-form]");
    const responseNote = document.querySelector<HTMLElement>("[data-note]");
    const qualificationNote = document.querySelector<HTMLElement>("[data-qualification-note]");
    const whatsapp = document.querySelector<HTMLAnchorElement>("[data-whatsapp]");
    const track = (eventName: string, properties: Record<string, string | number | boolean> = {}) => {
      const analytics = (window as typeof window & { va?: (command: string, payload: unknown) => void }).va;
      analytics?.("event", { name: eventName, data: properties });
      window.dispatchEvent(new CustomEvent("amplify:analytics", { detail: { eventName, ...properties } }));
    };
    type View = "invite" | "form" | "qualification" | "thanks";
    const setView = (view: View) => {
      if (!page || !response) return;
      page.dataset.view = view;
      invite?.setAttribute("aria-hidden", String(view !== "invite"));
      response.setAttribute("aria-hidden", String(view !== "form"));
      qualification?.setAttribute("aria-hidden", String(view !== "qualification"));
      thanks?.setAttribute("aria-hidden", String(view !== "thanks"));
      invite?.toggleAttribute("inert", view !== "invite");
      response.toggleAttribute("inert", view !== "form");
      qualification?.toggleAttribute("inert", view !== "qualification");
      thanks?.toggleAttribute("inert", view !== "thanks");
      document.documentElement.style.overflow = view === "invite" ? "" : "hidden";
      window.setTimeout(() => {
        if (view === "form") form?.querySelector<HTMLInputElement>("input")?.focus();
        else if (view === "qualification") qualificationForm?.querySelector<HTMLInputElement>("input")?.focus();
        else if (view === "invite") open?.focus();
      }, 540);
    };
    openButtons.forEach((button) => button.addEventListener("click", () => {
      track("amplify_day_cta_clicked", { position: button.dataset.ctaPosition || "unknown" });
      track("amplify_day_form_opened", { position: button.dataset.ctaPosition || "unknown" });
      setView("form");
    }));
    close?.addEventListener("click", () => setView("invite"));
    const readProgress = (): Record<string, unknown> => {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); } catch { return {}; }
    };
    const saveProgress = (stage: string, values: Record<string, unknown>) => {
      const detail = { ...readProgress(), ...values, stage, updatedAt: new Date().toISOString() };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(detail));
      window.dispatchEvent(new CustomEvent("amplify:lead-progress", { detail }));
      return detail;
    };
    const eventId = () => globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    const sendLeadEvent = async (eventName: string, values: Record<string, unknown> = {}, keepalive = false) => {
      const detail = { ...readProgress(), ...values };
      const response = await fetch("/api/amplify-day-lead", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        keepalive,
        body: JSON.stringify({ ...detail, eventName, idempotencyKey: eventId() }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result?.ok) throw new Error(result?.error || "capture_failed");
      return result;
    };
    const setBusy = (button: HTMLButtonElement | null, busy: boolean, idleLabel: string, busyLabel: string) => {
      if (!button) return;
      button.disabled = busy;
      button.setAttribute("aria-busy", String(busy));
      const label = button.querySelector("span") || button;
      label.textContent = busy ? busyLabel : idleLabel;
    };
    const validate = (input: HTMLInputElement, valid: boolean) => {
      input.setAttribute("aria-invalid", String(!valid));
      const error = document.querySelector<HTMLElement>(`[data-error="${input.name}"]`);
      if (error) error.hidden = valid;
    };
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const name = form.elements.namedItem("name") as HTMLInputElement;
      const email = form.elements.namedItem("email") as HTMLInputElement;
      const website = form.elements.namedItem("website") as HTMLInputElement;
      const nameOK = Boolean(name.value.trim());
      const emailOK = Boolean(email.value.trim()) && email.validity.valid;
      validate(name, nameOK); validate(email, emailOK);
      if (!nameOK || !emailOK) return (!nameOK ? name : email).focus();
      const values = { name: name.value.trim(), email: email.value.trim(), website: website?.value || "" };
      const previous = readProgress();
      if (previous.email && previous.email !== values.email) localStorage.removeItem(STORAGE_KEY);
      saveProgress("identity", values);
      const submit = form.querySelector<HTMLButtonElement>(".submit");
      setBusy(submit, true, "Continuar", "Salvando");
      if (responseNote) { responseNote.textContent = "Salvando seus dados…"; responseNote.classList.add("active"); }
      try {
        await sendLeadEvent("amplify_day_interest_captured", values);
        track("amplify_day_identity_submitted");
        if (responseNote) responseNote.textContent = "Dados recebidos. Agora, conte um pouco sobre sua atuação.";
        setView("qualification");
      } catch {
        if (responseNote) responseNote.textContent = "Não conseguimos salvar agora. Seus dados continuam aqui; tente novamente.";
      } finally {
        setBusy(submit, false, "Continuar", "Salvando");
      }
    });
    document.querySelectorAll<HTMLButtonElement>("[data-qualification-close]").forEach((button) => button.addEventListener("click", () => setView("form")));
    let saveTimer = 0;
    let lastPartialPayload = "";
    const collectQualification = () => {
      if (!qualificationForm) return {};
      const data = Object.fromEntries(new FormData(qualificationForm).entries()) as Record<string, unknown>;
      return { ...data, marketingConsent: Boolean(qualificationForm.elements.namedItem("marketingConsent") && (qualificationForm.elements.namedItem("marketingConsent") as HTMLInputElement).checked) };
    };
    const persistPartial = async () => {
      const current = readProgress();
      if (current.stage === "complete") return;
      const values = collectQualification();
      const serialized = JSON.stringify(values);
      if (serialized === lastPartialPayload || !current.email) return;
      lastPartialPayload = serialized;
      saveProgress("qualification_partial", values);
      try {
        await sendLeadEvent("amplify_day_qualification_updated", values);
        if (qualificationNote) qualificationNote.textContent = "Progresso salvo.";
      } catch {
        if (qualificationNote) qualificationNote.textContent = "Progresso salvo neste navegador; tentaremos sincronizar novamente ao concluir.";
      }
    };
    qualificationForm?.addEventListener("input", () => {
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(persistPartial, 1200);
    });
    qualificationForm?.addEventListener("focusout", () => {
      window.clearTimeout(saveTimer);
      void persistPartial();
    });
    qualificationForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      window.clearTimeout(saveTimer);
      const organization = qualificationForm.elements.namedItem("organization") as HTMLInputElement;
      const role = qualificationForm.elements.namedItem("role") as HTMLInputElement;
      const linkedin = qualificationForm.elements.namedItem("linkedin") as HTMLInputElement;
      const fields = [organization, role];
      let firstInvalid: HTMLInputElement | undefined;
      fields.forEach((input) => {
        const valid = Boolean(input.value.trim());
        input.setAttribute("aria-invalid", String(!valid));
        const error = document.querySelector<HTMLElement>(`[data-q-error="${input.name}"]`);
        if (error) error.hidden = valid;
        if (!valid && !firstInvalid) firstInvalid = input;
      });
      if (firstInvalid) return firstInvalid.focus();
      const linkedinOK = !linkedin.value.trim() || linkedin.validity.valid;
      linkedin.setAttribute("aria-invalid", String(!linkedinOK));
      if (!linkedinOK) {
        if (qualificationNote) qualificationNote.textContent = "Informe uma URL válida do LinkedIn.";
        return linkedin.focus();
      }
      const values = { ...collectQualification(), profileCompletedAt: new Date().toISOString() };
      const submit = qualificationForm.querySelector<HTMLButtonElement>(".qualification-submit");
      setBusy(submit, true, "Concluir meu cadastro", "Salvando perfil");
      saveProgress("complete", values);
      try {
        const result = await sendLeadEvent("amplify_day_profile_completed", values);
        const whatsappUrl = typeof result?.actions?.whatsappUrl === "string" ? result.actions.whatsappUrl : "";
        if (whatsapp && whatsappUrl) {
          whatsapp.href = whatsappUrl;
          whatsapp.hidden = false;
        }
        track("amplify_day_profile_completed");
        if (qualificationNote) qualificationNote.textContent = "Perfil recebido.";
        setView("thanks");
      } catch {
        saveProgress("qualification_partial", values);
        if (qualificationNote) qualificationNote.textContent = "Não conseguimos concluir agora. Seus dados continuam aqui; tente novamente.";
      } finally {
        setBusy(submit, false, "Concluir meu cadastro", "Salvando perfil");
      }
    });
    document.querySelector<HTMLButtonElement>("[data-restart]")?.addEventListener("click", () => setView("invite"));
    document.querySelector<HTMLButtonElement>("[data-calendar]")?.addEventListener("click", () => {
      void sendLeadEvent("amplify_day_calendar_added", {}, true).catch(() => null);
      track("amplify_day_calendar_added");
      const ics = ["BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//Amplify//Amplify Day//PT-BR","BEGIN:VEVENT","UID:amplify-day-2026@amplify.ja.br","DTSTAMP:20260822T120000Z","DTSTART;VALUE=DATE:20260923","DTEND;VALUE=DATE:20260924","SUMMARY:Amplify Day 2026","LOCATION:Brasília","DESCRIPTION:Evento presencial Amplify Day.","END:VEVENT","END:VCALENDAR"].join("\r\n");
      const link = document.createElement("a"); link.href = URL.createObjectURL(new Blob([ics], { type: "text/calendar" })); link.download = "amplify-day-2026.ics"; link.click(); URL.revokeObjectURL(link.href);
    });
    whatsapp?.addEventListener("click", () => {
      void sendLeadEvent("amplify_day_whatsapp_clicked", {}, true).catch(() => null);
      track("amplify_day_whatsapp_clicked");
    });
    document.querySelector<HTMLAnchorElement>("[data-map]")?.addEventListener("click", () => track("amplify_day_map_clicked"));
    const saved = readProgress();
    if (form) {
      const name = form.elements.namedItem("name") as HTMLInputElement;
      const email = form.elements.namedItem("email") as HTMLInputElement;
      if (typeof saved.name === "string") name.value = saved.name;
      if (typeof saved.email === "string") email.value = saved.email;
    }
    if (qualificationForm) {
      ["organization", "role", "linkedin"].forEach((key) => {
        const input = qualificationForm.elements.namedItem(key) as HTMLInputElement | null;
        if (input && typeof saved[key] === "string") input.value = saved[key] as string;
      });
      const consent = qualificationForm.elements.namedItem("marketingConsent") as HTMLInputElement | null;
      if (consent) consent.checked = saved.marketingConsent === true;
    }
    if (new URLSearchParams(location.search).get("qualificar") === "1") {
      setView(saved.email ? "qualification" : "form");
    }
  </script>
</PageShell>

