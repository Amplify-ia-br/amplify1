        <li><b>4</b><span><small>Competência geral</small>Comunicação</span></li>
        <li><b>5</b><span><small>Competência geral</small>Cultura digital</span></li>
        <li><b>7</b><span><small>Competência geral</small>Argumentação</span></li>
