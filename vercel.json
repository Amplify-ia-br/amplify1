{
  "functions": {
    "api/knowledge/**/*.ts": {
      "includeFiles": "okf/public/**"
    },
    "api/mcp.ts": {
      "includeFiles": "okf/public/**"
    },
    "api/ana-chat.ts": {
      "includeFiles": "okf/public/**"
    }
  },
  "headers": [
    {
      "source": "/knowledge",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }]
    },
    {
      "source": "/knowledge/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }]
    },
    {
      "source": "/api/knowledge",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }]
    },
    {
      "source": "/api/knowledge/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }]
    },
    {
      "source": "/api/mcp",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }]
    },
    {
      "source": "/lab/ana",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }]
    },
    {
      "source": "/api/ana-chat",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }]
    }
  ],
  "rewrites": [
    {
      "source": "/Leia",
      "destination": "/leia"
    }
  ]
}
