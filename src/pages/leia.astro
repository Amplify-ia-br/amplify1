<div class="cta-fixo" id="cta-fixo"><a class="botao" href="#contato" data-intencao="masterclass">Solicitar masterclass <span class="seta" aria-hidden="true">&rarr;</span></a></div>

<script>
/* ====== CONFIGURAÇÃO ======
   ENDPOINT: endereço que recebe a solicitação em JSON (o mesmo do formulário atual do site).
   Vazio = modo prévia: a página mostra o resumo, mas não envia nada.
   VIDEO_SRC_HD e VIDEO_SRC_MOBILE: variantes escolhidas no clique, sem bloquear a carga da LP. */
const CONFIG = {
  ENDPOINT: "/api/leia-lead",
  VIDEO_SRC_HD: "/leia/video/leia-apresentacao.mp4",
  VIDEO_SRC_MOBILE: "/leia/video/leia-apresentacao-720p.mp4"
};

(function () {
  const $ = (id) => document.getElementById(id);

  function sincronizarFormatoMasterclass() {
    const grupo = $("formato-masterclass");
    const mostrar = $("intencao-masterclass").checked;
    grupo.hidden = !mostrar;
    grupo.querySelectorAll("input").forEach((input) => { input.disabled = !mostrar; });
  }

  // Botões de entrada marcam a opção certa no formulário
  document.querySelectorAll("[data-intencao]").forEach((a) => {
    a.addEventListener("click", () => {
      const alvo = $("intencao-" + a.dataset.intencao);
      if (alvo) {
        alvo.checked = true;
        sincronizarFormatoMasterclass();
      }
    });
  });
  document.querySelectorAll('input[name="intencao"]').forEach((input) => input.addEventListener("change", sincronizarFormatoMasterclass));
  sincronizarFormatoMasterclass();

  // Vídeo carregado só quando a pessoa escolhe assistir
  $("video-play").addEventListener("click", () => {
    const box = $("video-box");
    const v = document.createElement("video");
    const conexao = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    const conexaoLenta = Boolean(conexao?.saveData || /(^|-)2g$/.test(conexao?.effectiveType || "") || (conexao?.downlink && conexao.downlink < 2));
    const telaCompacta = window.matchMedia("(max-width: 767px)").matches;
    const usar720p = telaCompacta || conexaoLenta;
    v.className = "video__media";
    v.controls = true; v.playsInline = true; v.preload = "auto";
    v.width = usar720p ? 1280 : 1920;
    v.height = usar720p ? 720 : 1080;
    v.dataset.quality = usar720p ? "720p" : "1080p";
    v.setAttribute("aria-label", "Vídeo de apresentação do L.E.I.A.");
    v.poster = "/leia/assets/personagem-05.jpg";
    const falhou = () => { $("video-aviso").hidden = false; };
    v.addEventListener("error", falhou);
    const src = document.createElement("source");
    src.src = usar720p ? CONFIG.VIDEO_SRC_MOBILE : CONFIG.VIDEO_SRC_HD;
    src.type = "video/mp4";
    src.addEventListener("error", falhou);
    v.appendChild(src);
    box.replaceChildren(v);
    v.play().catch(() => {});
  });

  // Copiar com fallback para seleção
  function copiar(texto, noSelecionar, statusEl, okMsg) {
    const selecionar = () => { const r = document.createRange(); r.selectNodeContents(noSelecionar); const s = getSelection(); s.removeAllRanges(); s.addRange(r); statusEl.textContent = "Texto selecionado. Use Ctrl+C para copiar."; };
    try { navigator.clipboard.writeText(texto).then(() => { statusEl.textContent = okMsg; }).catch(selecionar); } catch (e) { selecionar(); }
  }
  $("copiar-email").addEventListener("click", () => copiar($("email-comercial").textContent, $("email-comercial"), $("copiar-email-status"), "E-mail copiado."));

  // Máscara de telefone
  $("telefone").addEventListener("input", (ev) => {
    const d = ev.target.value.replace(/\D/g, "").slice(0, 11);
    let v = d;
    if (d.length > 2) v = `(${d.slice(0, 2)}) ${d.slice(2)}`;
    if (d.length > 7) v = `(${d.slice(0, 2)}) ${d.slice(2, d.length - 4)}-${d.slice(-4)}`;
    ev.target.value = v;
  });

  // Validação e envio
  const form = $("form-contato"), ok = $("ok");
  let lead = null;
  function marcar(id, valido) {
    $(id).setAttribute("aria-invalid", valido ? "false" : "true");
    $(id + "-erro").hidden = valido;
    return valido;
  }
  function validar() {
    const campos = ["nome", "email", "escola", "papel"];
    const r = [
      marcar("nome", $("nome").value.trim().length >= 3),
      marcar("email", /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test($("email").value.trim())),
      marcar("escola", $("escola").value.trim().length >= 2),
      marcar("papel", !!$("papel").value)
    ];
    const i = r.indexOf(false);
    if (i >= 0) $(campos[i]).focus();
    return i < 0;
  }
  ["nome", "email", "escola", "papel"].forEach((id) => $(id).addEventListener("change", () => { if ($(id).getAttribute("aria-invalid") === "true") validar(); }));

  function utm() {
    const out = {};
    try { new URLSearchParams(location.search).forEach((v, k) => { if (k.startsWith("utm_")) out[k] = v; }); } catch (e) {}
    return out;
  }

  form.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    if ($("website").value) return; // campo anti-spam preenchido: ignora
    if (!validar()) return;
    const f = new FormData(form);
    const solicitouMasterclass = f.get("intencao") !== "orcamento";
    const intencao = solicitouMasterclass ? "Solicitar masterclass" : "Conversar com especialista sobre implantação e orçamento";
    const formatoMasterclass = solicitouMasterclass ? String(f.get("formatoMasterclass") || "") : "";
    lead = {
      intencao, nome: f.get("nome").trim(), email: f.get("email").trim(), escola: f.get("escola").trim(), papel: f.get("papel"),
      formatoMasterclass, estudantes: f.get("estudantes") || "", cidade: (f.get("cidade") || "").trim(), telefone: f.get("telefone") || "",
      origem: "Site L.E.I.A.", criadoEm: new Date().toISOString(), ...utm()
    };
    const linhas = [["Como quer começar", lead.intencao], ["Nome", lead.nome], ["E-mail", lead.email], ["Escola ou rede", lead.escola], ["Papel", lead.papel]];
    if (lead.formatoMasterclass) linhas.splice(1, 0, ["Formato da masterclass", lead.formatoMasterclass === "presencial" ? "Presencial" : "Online"]);
    if (lead.estudantes) linhas.push(["Estudantes (9º ao 3º EM)", lead.estudantes]);
    if (lead.cidade) linhas.push(["Cidade", lead.cidade]);
    if (lead.telefone) linhas.push(["Telefone", lead.telefone]);
    const dl = $("resumo"); dl.textContent = "";
    linhas.forEach(([k, v]) => { const d = document.createElement("div"), dt = document.createElement("dt"), dd = document.createElement("dd"); dt.textContent = k; dd.textContent = v; d.append(dt, dd); dl.append(d); });
    lead.texto = "Solicitação pelo site do L.E.I.A.\n\n" + linhas.map(([k, v]) => `${k}: ${v}`).join("\n");

    let enviado = false;
    if (CONFIG.ENDPOINT) {
      $("enviar").disabled = true;
      try {
        const payload = {
          name: lead.nome,
          email: lead.email,
          school: lead.escola,
          role: lead.papel,
          interest: f.get("intencao") === "orcamento" ? "implantacao" : "masterclass",
          masterclassFormat: lead.formatoMasterclass,
          students: lead.estudantes,
          cityState: lead.cidade,
          phone: lead.telefone,
          path: location.pathname,
          ...utm()
        };
        const r = await fetch(CONFIG.ENDPOINT, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        enviado = r.ok;
      } catch (e) { enviado = false; }
      $("enviar").disabled = false;
    }
    if (enviado) {
      $("ok-titulo").textContent = "Solicitação enviada.";
      $("ok-texto").textContent = "Nossa equipe entra em contato para alinhar contexto e formato.";
    } else if (CONFIG.ENDPOINT) {
      $("ok-titulo").textContent = "Não conseguimos enviar agora.";
      $("ok-texto").textContent = "Copie o resumo abaixo e envie para comercial@amplify.ia.br, ou tente de novo em alguns minutos.";
    } else {
      $("ok-titulo").textContent = "Prévia: formulário ainda não conectado.";
      $("ok-texto").textContent = "Na versão publicada, esta solicitação vai direto para a equipe comercial. Nada foi enviado.";
    }
    form.hidden = true; ok.hidden = false; ok.focus();
  });

  $("copiar-resumo").addEventListener("click", () => copiar(lead ? lead.texto : "", $("resumo"), $("resumo-status"), "Resumo copiado."));
  $("editar").addEventListener("click", () => { ok.hidden = true; form.hidden = false; $("resumo-status").textContent = ""; $("nome").focus(); });

  // CTA fixo no celular: aparece depois do hero e some no contato
  const fixo = $("cta-fixo");
  let heroVis = true, contatoVis = false;
  const upd = () => fixo.classList.toggle("on", !heroVis && !contatoVis);
  if ("IntersectionObserver" in window) {
    new IntersectionObserver(([en]) => { heroVis = en.isIntersecting; upd(); }).observe($("topo"));
    new IntersectionObserver(([en]) => { contatoVis = en.isIntersecting; upd(); }, { threshold: 0.05 }).observe($("contato"));
  }
})();
</script>

<Analytics />
