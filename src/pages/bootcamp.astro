---
import PageShell from "@/layouts/PageShell.astro";
import { BOOTCAMP_NATAL } from "@/lib/bootcamp-natal-content.js";
import { getBootcampCheckoutUrl, getBootcampEventBySlug } from "@/lib/bootcamp-events.js";

const content = BOOTCAMP_NATAL;
const event = getBootcampEventBySlug("natal-25-07-26");
const checkoutUrl = getBootcampCheckoutUrl(event, Astro.url) || event?.symplaCheckoutUrl || "https://www.sympla.com.br/";
const pageTitle = `Bootcamp IA para Negócios Natal | Amplify`;
const pageDescription = `${content.template.headline}. ${content.longDateLabel}, das ${content.timeLabel}, em ${content.cityLabel}.`;
---

<PageShell title={pageTitle} description={pageDescription} chatbot={false}>
  <main class="natal-page">
    <header class="natal-header" aria-label="Amplify">
      <a href="/" class="natal-logo-link" aria-label="Voltar para a pagina inicial da Amplify">
        <img src={content.templateAssets.logo} alt="Bootcamp IA para Negócios Natal" width="220" height="64" class="natal-logo" />
      </a>
      <nav class="natal-nav" aria-label="Navegacao do Bootcamp">
        <a href="#conteudo">Conteudo</a>
        <a href="#mentor">Mentor</a>
        <a href="#ingressos">Ingressos</a>
        <a href="#faq">FAQ</a>
      </nav>
    </header>

    <section class="natal-hero" aria-labelledby="bootcamp-title">
      <picture class="natal-hero-media" aria-hidden="true">
        <source srcset={content.templateAssets.heroMobile} media="(max-width: 760px)" />
        <img src={content.templateAssets.hero} alt="" width="1600" height="1000" loading="eager" />
      </picture>
      <div class="natal-hero-shade" aria-hidden="true"></div>

      <div class="natal-hero-grid">
        <div class="natal-hero-copy">
          <p class="natal-kicker">{content.template.eyebrow}</p>
          <h1 id="bootcamp-title">{content.template.headline}</h1>
          <p>{content.template.lead}</p>
          <div class="natal-actions">
            <a class="natal-primary js-bootcamp-checkout" href={checkoutUrl} target="_blank" rel="noopener noreferrer">
              {content.template.cta}
            </a>
            <a class="natal-secondary" href="#conteudo">Ver programa</a>
          </div>
        </div>

        <aside class="natal-event-box" aria-label="Resumo do evento">
          <span>{content.cityLabel}</span>
          <strong>{content.longDateLabel}</strong>
          <span>{content.timeLabel}</span>
          <span>{content.venueLabel}</span>
        </aside>
      </div>
    </section>

    <section class="natal-band natal-intro" aria-labelledby="sobre-title">
      <div class="natal-section-head">
        <p class="natal-kicker">Imersao presencial</p>
        <h2 id="sobre-title">{content.template.whatTitle}</h2>
      </div>
      <div class="natal-copy-stack">
        {content.template.whatCopy.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="natal-band natal-proof" aria-label="Numeros do Bootcamp">
      {content.stats.map((stat) => (
        <div>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </section>

    <section id="conteudo" class="natal-band natal-sessions" aria-labelledby="conteudo-title">
      <div class="natal-section-head">
        <p class="natal-kicker">Conteudo</p>
        <h2 id="conteudo-title">Um dia para sair com metodo, nao so repertorio.</h2>
      </div>
      <div class="natal-session-grid">
        {content.sessions.map((session, index) => (
          <article>
            <span>{session.label}</span>
            <h3>{session.title}</h3>
            <p>{session.copy}</p>
            <img
              src={[
                content.templateAssets.session01,
                content.templateAssets.session02,
                content.templateAssets.session03,
                content.templateAssets.session04,
              ][index]}
              alt=""
              width="900"
              height="640"
              loading="lazy"
            />
          </article>
        ))}
      </div>
    </section>

    <section class="natal-band natal-audience" aria-labelledby="publico-title">
      <div class="natal-city-media" aria-hidden="true">
        <img src={content.templateAssets.cityArt} alt="" width="900" height="640" loading="lazy" />
      </div>
      <div class="natal-audience-copy">
        <p class="natal-kicker">Para quem e</p>
        <h2 id="publico-title">Profissionais que precisam transformar IA em resultado de negocio.</h2>
        <ul>
          {content.audience.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section id="mentor" class="natal-band natal-mentor" aria-labelledby="mentor-title">
      <div class="natal-mentor-photo">
        <img src={content.templateAssets.mentor} alt={`Foto de ${content.mentor.name}`} width="960" height="1440" loading="lazy" />
      </div>
      <div class="natal-mentor-copy">
        <p class="natal-kicker">Quem conduz</p>
        <h2 id="mentor-title">{content.mentor.name}</h2>
        <p class="natal-mentor-title">{content.mentor.title}</p>
        <p>{content.mentor.bio}</p>
      </div>
    </section>

    <section id="ingressos" class="natal-band natal-offers" aria-labelledby="ingressos-title">
      <div class="natal-section-head">
        <p class="natal-kicker">Ingressos</p>
        <h2 id="ingressos-title">Escolha o melhor formato para participar.</h2>
      </div>
      <div class="natal-offer-grid">
        {content.offers.map((offer) => (
          <article>
            <h3>{offer.title}</h3>
            <strong>{offer.price}</strong>
            <span>{offer.note}</span>
            <ul>
              {offer.items.map((item) => <li>{item}</li>)}
            </ul>
            <a class="natal-primary js-bootcamp-checkout" href={checkoutUrl} target="_blank" rel="noopener noreferrer">
              Garantir vaga
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="natal-band natal-testimonial" aria-label="Depoimento">
      <blockquote>
        <p>“{content.testimonial.quote}”</p>
        <footer>
          <strong>{content.testimonial.author}</strong>
          <span>{content.testimonial.role}</span>
        </footer>
      </blockquote>
    </section>

    <section id="faq" class="natal-band natal-faq" aria-labelledby="faq-title">
      <div class="natal-section-head">
        <p class="natal-kicker">FAQ</p>
        <h2 id="faq-title">Perguntas frequentes</h2>
      </div>
      <div class="natal-faq-list">
        {content.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="natal-final" aria-labelledby="final-title">
      <p class="natal-kicker">{content.cityLabel} · {content.dateLabel}</p>
      <h2 id="final-title">Leve IA para a rotina do seu negocio com criterio e pratica.</h2>
      <a class="natal-primary js-bootcamp-checkout" href={checkoutUrl} target="_blank" rel="noopener noreferrer">
        {content.template.cta}
      </a>
    </section>
  </main>
</PageShell>

<script define:vars={{ eventSlug: event?.slug || "natal-25-07-26" }}>
  document.querySelectorAll(".js-bootcamp-checkout").forEach((link) => {
    link.addEventListener("click", () => {
      navigator.sendBeacon?.(
        "/api/bootcamp-track",
        new Blob(
          [
            JSON.stringify({
              eventName: "bootcamp_checkout_clicked",
              bootcampSlug: eventSlug,
              source: "bootcamp_lp",
              page: window.location.pathname,
            }),
          ],
          { type: "application/json" },
        ),
      );
    });
  });
</script>

<style>
  .natal-page {
    min-height: 100svh;
    background:
      radial-gradient(circle at 75% 8%, hsl(var(--primary) / 0.16), transparent 24rem),
      linear-gradient(150deg, #050607 0%, #101215 54%, #071412 100%);
    color: hsl(var(--foreground));
  }

  .natal-header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0 clamp(1rem, 4vw, 3rem);
    border-bottom: 1px solid hsl(var(--border) / 0.64);
    background: rgba(5, 6, 7, 0.84);
    backdrop-filter: blur(18px);
  }

  .natal-logo-link {
    display: inline-flex;
    align-items: center;
  }

  .natal-logo {
    width: auto;
    height: 2.1rem;
    object-fit: contain;
  }

  .natal-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.35rem);
    font-size: 0.84rem;
    font-weight: 800;
  }

  .natal-nav a {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }

  .natal-nav a:hover,
  .natal-nav a:focus-visible {
    color: hsl(var(--foreground));
  }

  .natal-hero {
    position: relative;
    min-height: calc(100svh - 4.5rem);
    overflow: hidden;
  }

  .natal-hero-media,
  .natal-hero-shade {
    position: absolute;
    inset: 0;
  }

  .natal-hero-media img,
  .natal-city-media img,
  .natal-session-grid img,
  .natal-mentor-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .natal-hero-media {
    opacity: 0.6;
  }

  .natal-hero-shade {
    background:
      linear-gradient(90deg, rgba(5, 6, 7, 0.96), rgba(5, 6, 7, 0.52) 52%, rgba(5, 6, 7, 0.82)),
      linear-gradient(0deg, #050607 0%, transparent 42%);
  }

  .natal-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.33fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    min-height: calc(100svh - 4.5rem);
    padding: clamp(5rem, 12vw, 8rem) clamp(1rem, 4vw, 4rem) clamp(2rem, 5vw, 4rem);
  }

  .natal-hero-copy,
  .natal-section-head,
  .natal-copy-stack,
  .natal-audience-copy,
  .natal-mentor-copy {
    display: grid;
    gap: 1rem;
  }

  .natal-kicker {
    margin: 0;
    color: hsl(var(--primary));
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .natal-hero h1,
  .natal-band h2,
  .natal-final h2 {
    margin: 0;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .natal-hero h1 {
    max-width: 15ch;
    font-size: clamp(3.1rem, 6.7vw, 5.9rem);
  }

  .natal-band h2,
  .natal-final h2 {
    max-width: 13ch;
    font-size: clamp(2.5rem, 6.5vw, 5.8rem);
  }

  .natal-hero p,
  .natal-copy-stack p,
  .natal-audience-copy p,
  .natal-mentor-copy p,
  .natal-final p {
    margin: 0;
    max-width: 44rem;
    color: hsl(var(--muted-foreground));
    font-size: clamp(0.98rem, 1.55vw, 1.12rem);
    line-height: 1.65;
  }

  .natal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }

  .natal-primary,
  .natal-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.15rem;
    padding: 0 1.15rem;
    border-radius: 0.45rem;
    font-weight: 850;
    text-decoration: none;
  }

  .natal-primary {
    background: hsl(var(--primary));
    color: #041010;
  }

  .natal-secondary {
    border: 1px solid hsl(var(--border));
    color: hsl(var(--foreground));
    background: rgba(255, 255, 255, 0.04);
  }

  .natal-event-box {
    display: grid;
    gap: 0.7rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    border: 1px solid hsl(var(--border));
    background: rgba(5, 6, 7, 0.72);
    backdrop-filter: blur(18px);
  }

  .natal-event-box span {
    color: hsl(var(--muted-foreground));
    line-height: 1.35;
  }

  .natal-event-box strong {
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    line-height: 1;
  }

  .natal-band {
    padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 4vw, 4rem);
  }

  .natal-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
  }

  .natal-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding-top: 0;
    background: hsl(var(--border));
    border-top: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
  }

  .natal-proof div {
    display: grid;
    gap: 0.3rem;
    padding: clamp(1.3rem, 3vw, 2rem);
    background: #090b0d;
  }

  .natal-proof strong {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1;
    color: hsl(var(--primary));
  }

  .natal-proof span {
    color: hsl(var(--muted-foreground));
  }

  .natal-session-grid,
  .natal-offer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    background: hsl(var(--border));
    border: 1px solid hsl(var(--border));
  }

  .natal-session-grid article,
  .natal-offer-grid article {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    background: #090b0d;
    padding: clamp(1.1rem, 2.4vw, 1.6rem);
  }

  .natal-session-grid span,
  .natal-offer-grid span {
    color: hsl(var(--primary));
    font-size: 0.8rem;
    font-weight: 850;
  }

  .natal-page h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2.1vw, 1.8rem);
    line-height: 1.05;
  }

  .natal-session-grid p,
  .natal-offer-grid li,
  .natal-faq p,
  .natal-testimonial span {
    margin: 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.55;
  }

  .natal-session-grid img {
    aspect-ratio: 4 / 3;
    margin-top: 0.5rem;
    border: 1px solid hsl(var(--border));
    filter: saturate(0.82) contrast(1.08);
  }

  .natal-audience {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: center;
    background: #10100e;
  }

  .natal-city-media {
    min-height: min(58vw, 34rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .natal-audience-copy ul,
  .natal-offer-grid ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .natal-audience-copy li {
    color: hsl(var(--foreground));
    line-height: 1.55;
  }

  .natal-mentor {
    display: grid;
    grid-template-columns: minmax(16rem, 0.42fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: center;
  }

  .natal-mentor-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    background: #090b0d;
  }

  .natal-mentor-photo img {
    object-position: center top;
  }

  .natal-mentor-title {
    color: hsl(var(--primary)) !important;
    font-weight: 800;
  }

  .natal-offers {
    background: #080a0c;
  }

  .natal-offer-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .natal-offer-grid article > strong {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1;
  }

  .natal-offer-grid .natal-primary {
    margin-top: 0.7rem;
  }

  .natal-testimonial {
    background: #f4f1ea;
    color: #111111;
  }

  .natal-testimonial blockquote {
    margin: 0;
    max-width: 58rem;
  }

  .natal-testimonial p {
    margin: 0;
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  .natal-testimonial footer {
    display: grid;
    gap: 0.2rem;
    margin-top: 1.4rem;
  }

  .natal-testimonial span {
    color: #53504a;
  }

  .natal-faq-list {
    display: grid;
    gap: 1px;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    background: hsl(var(--border));
    border: 1px solid hsl(var(--border));
  }

  .natal-faq details {
    background: #090b0d;
    padding: clamp(1rem, 2.4vw, 1.5rem);
  }

  .natal-faq summary {
    cursor: pointer;
    color: hsl(var(--foreground));
    font-weight: 850;
  }

  .natal-faq p {
    margin-top: 0.8rem;
  }

  .natal-final {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 4vw, 4rem);
    background:
      linear-gradient(90deg, rgba(5, 6, 7, 0.95), rgba(5, 6, 7, 0.65)),
      url("/bootcamp/midias/foto-natal.BKHPec6X_2722X9.webp") center / cover;
  }

  @media (max-width: 980px) {
    .natal-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
      padding-top: 0.95rem;
      padding-bottom: 0.95rem;
    }

    .natal-nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.1rem;
    }

    .natal-hero,
    .natal-hero-grid {
      min-height: calc(100svh - 7rem);
    }

    .natal-hero-grid,
    .natal-intro,
    .natal-audience,
    .natal-mentor {
      grid-template-columns: 1fr;
    }

    .natal-session-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .natal-proof,
    .natal-offer-grid {
      grid-template-columns: 1fr;
    }

    .natal-city-media {
      min-height: 18rem;
    }
  }

  @media (max-width: 620px) {
    .natal-actions,
    .natal-primary,
    .natal-secondary {
      width: 100%;
    }

    .natal-session-grid {
      grid-template-columns: 1fr;
    }

    .natal-hero h1 {
      font-size: clamp(2.65rem, 11.8vw, 4rem);
    }
  }
</style>
