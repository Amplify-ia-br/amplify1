  .boot-mockup--branding {
    --bn-bg: #0a0a0a;
    --bn-surface: #111212;
    --bn-surface-2: #151818;
    --bn-line: rgba(255, 255, 255, 0.105);
    --bn-line-soft: rgba(255, 255, 255, 0.07);
    --bn-text: #f6f7f4;
    --bn-muted: #9b9f9d;
    --bn-faint: #737977;
    --bn-accent: #2dd4bf;
    --bn-page-gutter: clamp(24px, 8.6vw, 180px);
    color: var(--bn-text);
    background: var(--bn-bg);
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .bn-container,
  .bn-section {
    width: min(1680px, calc(100% - (var(--bn-page-gutter) * 2)));
    margin-inline: auto;
  }

  .bn-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.84);
    border-bottom: 1px solid var(--bn-line-soft);
    backdrop-filter: blur(14px);
  }

  .bn-nav__inner {
    min-height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .bn-nav__brand,
  .bn-nav__links {
    display: inline-flex;
    align-items: center;
    gap: 28px;
  }

  .bn-nav__brand::after {
    content: "";
    width: 1px;
    height: 30px;
    order: 1;
    background: var(--bn-line);
  }

  .bn-nav__brand img,
  .bn-footer img {
    width: 206px;
    height: auto;
  }

  .bn-nav__brand span {
    order: 2;
    color: var(--bn-muted);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .bn-nav__links a:first-child {
    color: var(--bn-muted);
    font-size: 1.12rem;
    font-weight: 500;
  }

  .bn-nav__links a:last-child,
  .bn-button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    padding: 0 28px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transform: translateY(0);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .bn-nav__links a:last-child,
  .bn-button--primary {
    color: var(--bn-accent);
    background: rgba(45, 212, 191, 0.025);
    border: 1px solid rgba(45, 212, 191, 0.44);
    box-shadow: 0 0 0 rgba(34, 224, 211, 0);
  }

  .bn-button--secondary,
  .bn-button--ghost {
    color: var(--bn-text);
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid var(--bn-line);
  }

  .bn-button--ghost {
    color: var(--bn-muted);
    background: transparent;
    border-color: transparent;
  }

  .bn-nav__links a:last-child:hover,
  .bn-button:hover {
    transform: translateY(-2px);
  }

  .bn-nav__links a:last-child:hover,
  .bn-button--primary:hover {
    box-shadow: 0 14px 34px rgba(34, 224, 211, 0.22);
  }

  .bn-button--secondary:hover,
  .bn-button--ghost:hover {
    color: var(--bn-text);
    border-color: rgba(34, 224, 211, 0.35);
    background: rgba(34, 224, 211, 0.07);
  }

  .bn-nav__links a:last-child:active,
  .bn-button:active {
    transform: translateY(0) scale(0.98);
  }

  .bn-hero {
    position: relative;
    min-height: calc(100vh - 96px);
    overflow: hidden;
    background: var(--bn-bg);
    border-bottom: 1px solid var(--bn-line-soft);
  }

  .bn-hero__photo,
  .bn-hero__scrim {
    position: absolute;
    inset: 0;
  }

  .bn-hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 34%;
    filter: grayscale(0.15) saturate(0.58) brightness(0.38);
  }

  .bn-hero__scrim {
    background:
      radial-gradient(circle at 78% 47%, rgba(45, 212, 191, 0.035), transparent 23rem),
      linear-gradient(90deg, rgba(10, 10, 10, 0.98), rgba(10, 10, 10, 0.84) 48%, rgba(10, 10, 10, 0.62)),
      linear-gradient(180deg, rgba(10, 10, 10, 0.74), rgba(10, 10, 10, 0.22) 44%, var(--bn-bg));
  }

  .bn-pulse {
    position: absolute;
    width: 420px;
    height: 420px;
    border: 1px solid rgba(45, 212, 191, 0.16);
    border-radius: 999px;
    opacity: 0.48;
    pointer-events: none;
  }

  .bn-pulse::after {
    content: "";
    position: absolute;
    inset: 48px;
    border: 1px solid rgba(45, 212, 191, 0.18);
    border-radius: inherit;
    animation: bn-ring 7s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  .bn-pulse--hero {
    right: 6%;
    top: 26%;
    width: 660px;
    height: 660px;
  }

  .bn-pulse--final {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  @keyframes bn-ring {
    0% {
      opacity: 0.7;
      transform: scale(0.6);
    }

    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  .bn-hero__inner {
    position: relative;
    z-index: 2;
    padding: clamp(148px, 16vh, 216px) 0 clamp(86px, 10vh, 136px);
  }

  .bn-label {
