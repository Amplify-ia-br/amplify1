---
import PageShell from "@/layouts/PageShell.astro";
import logoAmplify from "@/assets/logo-amplify-branco.png";
import treinamentoPresencial from "@/assets/optimized/treinamento-presencial.webp";
import forumPalestra from "@/assets/optimized/forum-palestra.webp";
import logoGrupoPrimo from "@/assets/logos/logo-grupo-primo.png";
import logoAmcham from "@/assets/logos/logo-amcham.png";
import logoGouvea from "@/assets/logos/logo-gouvea.png";
import logoTecfil from "@/assets/logos/logo-tecfil.png";
import logoUfg from "@/assets/logos/logo-ufg.png";
import logoCreaPr from "@/assets/logos/logo-crea-pr.png";
import { getBootcampCheckoutUrl, getBootcampEventBySlug } from "@/lib/bootcamp-events.js";
import { BOOTCAMP_NATAL } from "@/lib/bootcamp-natal-content.js";

export const prerender = false;

const event = getBootcampEventBySlug("crea-rn-25-07-26");
const content = BOOTCAMP_NATAL;
const checkoutUrl = event ? getBootcampCheckoutUrl(event, Astro.url) : "https://www.sympla.com.br/";
const sponsorUrl = event?.whatsappGroupUrl || "https://wa.me/5511950350002";
const logoSrc = logoAmplify.src;
const heroSrc = treinamentoPresencial.src;
const secondaryImage = forumPalestra.src;
const creaLogo = "/bootcamp/crea-rn/logo-crea-rn-white.png";
const creaLogoColor = "/bootcamp/crea-rn/logo-crea-rn.png";
const professorImage = content.templateAssets.mentor;
const companyLogos = [
  { src: logoGrupoPrimo.src, alt: "Grupo Primo" },
  { src: logoAmcham.src, alt: "Amcham" },
  { src: logoGouvea.src, alt: "Gouvêa" },
  { src: logoTecfil.src, alt: "Tecfil" },
  { src: logoUfg.src, alt: "UFG" },
  { src: logoCreaPr.src, alt: "CREA-PR" },
];

const mentorHighlights = [
  {
    title: "Pesquisa",
    copy: "IA aplicada ao aprendizado organizacional, estratégia e performance em empresas de alto crescimento.",
  },
  {
    title: "Implantação",
    copy: "Projetos de data science e IA conectados a receita, produto, analytics, go-to-market e operação comercial.",
  },
  {
    title: "Formação",
    copy: "Mestre pela Fundação Dom Cabral, doutorando pela Burgundy School of Business, Educador de IA e Head de Soluções da Amplify.",
  },
];

const roles = [
  "Engenharia civil",
  "Engenharia elétrica",
  "Engenharia mecânica",
  "Agronomia",
  "Geociências",
  "Segurança do trabalho",
  "Gestão técnica / empresa",
  "Estudante ou recém-formado",
];

const modules = [
  {
    title: "IA para produtividade técnica",
    copy: "Como usar IA para acelerar leitura, síntese, documentação, propostas, relatórios e rotinas de escritório técnico sem abrir mão de critério profissional.",
  },
  {
    title: "Documentos, normas e responsabilidade",
    copy: "Como organizar contexto, trabalhar com referências, revisar entregáveis e definir limites claros: IA apoia o profissional, não substitui responsabilidade técnica.",
  },
  {
    title: "Projetos, obras e operação",
    copy: "Exemplos aplicados a planejamento, acompanhamento, comunicação com clientes, orçamentos, checklists, fiscalização, atendimento e gestão de pendências.",
  },
  {
    title: "Da ferramenta ao método",
    copy: "Um roteiro para escolher casos de uso, priorizar ganhos reais e voltar com próximos passos aplicáveis em escritórios, empresas e rotinas profissionais.",
  },
];

const audiences = [
  "Engenheiros e engenheiras que querem usar IA com produtividade e responsabilidade.",
  "Empresas técnicas registradas que precisam qualificar equipes e padronizar rotinas.",
  "Profissionais de agronomia, geociências e segurança do trabalho com alto volume de documentação e decisão.",
  "Gestores, coordenadores e responsáveis técnicos que precisam avaliar onde a IA entra no processo.",
  "Estudantes e recém-formados que querem desenvolver repertório prático para o mercado.",
];

const faq = [
  {
    question: "Preciso saber programar?",
    answer: "Não. O Boot Camp foi desenhado para profissionais técnicos que precisam aplicar IA no trabalho, mesmo sem formação em programação.",
  },
  {
    question: "A IA substitui responsabilidade técnica?",
    answer: "Não. A proposta é exatamente o contrário: mostrar como usar IA como apoio ao raciocínio, documentação e produtividade, preservando responsabilidade profissional, revisão humana e critério técnico.",
  },
  {
    question: "O evento será pago?",
    answer: "Sim. A inscrição individual é feita pelo Sympla, com pagamento seguro e confirmação pela plataforma.",
  },
  {
    question: "Empresas podem levar equipes?",
    answer: "Sim. Haverá plano corporativo para grupos e empresas técnicas. O formulário da página gera uma mensagem personalizada para falar com Adriano no WhatsApp.",
  },
  {
    question: "Haverá possibilidade de patrocínio?",
    answer: "Sim. A LP já prevê contato para patrocínio da edição em parceria com o CREA-RN.",
  },
];

const pageTitle = "Boot Camp IA para os Desafios de Engenharia | CREA-RN + Amplify";
const pageDescription = "Imersão presencial no CREA-RN para engenheiros, empresas técnicas e profissionais do Sistema Confea/Crea aplicarem IA com método, produtividade e responsabilidade.";
---

<PageShell title={pageTitle} description={pageDescription} chatbot={false}>
  <main class="crea-lp" data-bootcamp-slug={event.slug} data-bootcamp-version="crea-rn">
    <header class="crea-nav">
      <div class="crea-container crea-nav__inner">
        <a class="crea-brand" href="/" aria-label="Voltar para a pagina inicial da Amplify">
          <img src={logoSrc} alt="Amplify" width="120" height="24" />
          <span></span>
          <img src={creaLogo} alt="CREA-RN" width="236" height="60" />
        </a>
        <nav aria-label="Navegação principal">
          <a href="#programacao">Programação</a>
          <a href="#oferta">Inscrição</a>
        </nav>
      </div>
    </header>

    <section class="crea-hero" aria-labelledby="crea-title">
      <img class="crea-hero__photo" src={heroSrc} alt="" width="1280" height="720" loading="eager" />
      <div class="crea-hero__scrim"></div>
      <div class="crea-blueprint" aria-hidden="true"></div>
      <div class="crea-container crea-hero__inner">
        <p class="crea-label">CREA-RN + Amplify · Natal · 25 de julho de 2026</p>
        <h1 id="crea-title">Boot Camp IA para os Desafios de Engenharia</h1>
        <p>
          Uma imersão presencial para profissionais técnicos aplicarem inteligência artificial
          em projetos, documentos, decisões e rotinas de engenharia com método, produtividade e responsabilidade.
        </p>
        <div class="crea-actions">
          <a class="crea-button crea-button--primary" href="#oferta">Quero me inscrever</a>
          <a class="crea-button crea-button--secondary" href="#programacao">Ver programação</a>
          <a class="crea-button crea-button--ghost" href="#patrocinio">Patrocinar edição</a>
        </div>
        <div class="crea-meta" aria-label="Resumo do evento">
          <span>CREA-RN</span>
          <span>Av. Senador Salgado Filho, 1840</span>
          <span>09:00 às 18:00</span>
          <span>Inscrições abertas</span>
        </div>
      </div>
    </section>

    <section class="crea-section crea-split" aria-labelledby="why-title">
      <div>
        <p class="crea-label">Por que no CREA-RN</p>
        <h2 id="why-title">IA precisa entrar no trabalho técnico sem desmontar o critério profissional.</h2>
      </div>
      <div class="crea-copy">
        <p>
          Engenharia, agronomia e geociências lidam com documentação, responsabilidade, prazos,
          orçamento, comunicação com clientes, normas e decisões que não aceitam improviso.
        </p>
        <p>
          Por isso, este Boot Camp não vende IA como atalho mágico. A proposta é ensinar um método
          para usar IA como apoio ao raciocínio, à organização e à execução, mantendo revisão humana,
          rastreabilidade e responsabilidade técnica.
        </p>
        <div class="crea-note">Pensado para profissionais e empresas do ecossistema CREA-RN.</div>
      </div>
    </section>

    <section class="crea-section crea-section--surface" aria-labelledby="conversion-title">
      <div class="crea-container crea-conversion">
        <div>
          <p class="crea-label">Antes de comprar</p>
          <h2 id="conversion-title">Receba a programação completa.</h2>
          <p>Receba a programação e os próximos passos por email. Se fizer sentido, o link de inscrição pelo Sympla vai junto.</p>
        </div>
        <form class="crea-form" data-bootcamp-form data-success-message="Programação registrada. Enviaremos os próximos passos por email.">
          <input type="hidden" name="eventName" value="bootcamp_program_requested" />
          <input type="hidden" name="entryPoint" value="programacao_crea_rn" />
          <input type="hidden" name="intent" value="avaliar_ingresso_individual" />
          <input type="hidden" name="sourceCta" value="receber_programacao_crea_rn" />
          <label>Nome<input name="name" type="text" autocomplete="name" required placeholder="Seu nome" /></label>
          <label>Email<input name="email" type="email" autocomplete="email" required placeholder="voce@empresa.com" /></label>
          <label>Perfil
            <select name="role" required>
              <option value="">Selecione</option>
              {roles.map((role) => <option value={role}>{role}</option>)}
            </select>
          </label>
          <button class="crea-button crea-button--primary" type="submit">Receber programação</button>
          <p class="crea-form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section id="programacao" class="crea-section" aria-labelledby="program-title">
      <div class="crea-container">
        <div class="crea-section__head">
          <p class="crea-label">Programação</p>
          <h2 id="program-title">Quatro blocos práticos para aplicar IA no trabalho técnico.</h2>
        </div>
        <div class="crea-program">
          {modules.map((module, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{module.title}</h3>
                <p>{module.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="crea-section crea-section--surface" aria-labelledby="audience-title">
      <div class="crea-container">
        <div class="crea-section__head">
          <p class="crea-label">Para quem é</p>
          <h2 id="audience-title">Um evento para quem responde por entrega técnica.</h2>
        </div>
        <div class="crea-audience">
          {audiences.map((item) => <p><span>→</span>{item}</p>)}
        </div>
      </div>
    </section>

    <section class="crea-section crea-experience" aria-labelledby="included-title">
      <img src={secondaryImage} alt="Treinamento presencial da Amplify" width="720" height="480" loading="eager" />
      <div>
        <p class="crea-label">O que está incluído</p>
        <h2 id="included-title">Um dia de imersão presencial no CREA-RN.</h2>
        <ul>
          <li>10 horas de imersão prática, das 09:00 às 18:00</li>
          <li>Exercícios aplicados a rotinas técnicas e empresas de engenharia</li>
          <li>Certificado digital de participação</li>
          <li>Formulário previsto para inscrição individual, plano corporativo e patrocínio</li>
        </ul>
      </div>
    </section>

    <section class="crea-section crea-section--surface crea-mentor" aria-labelledby="mentor-title">
      <div class="crea-mentor__profile">
        <img class="crea-mentor__photo" src={professorImage} alt="Leonardo Camacho" width="720" height="900" loading="eager" />
        <div class="crea-mentor__content">
          <p class="crea-label">Quem será seu professor?</p>
          <h2 id="mentor-title">Leonardo Camacho</h2>
          <strong>Educador de IA e Head de Soluções da Amplify</strong>
          <div class="crea-mentor__bio">
            <p>{content.mentor.bio}</p>
            <p>{content.mentor.application}</p>
          </div>
          <div class="crea-mentor__proof">
            {mentorHighlights.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))}
          </div>
          <p class="crea-mentor__quote">Na terra de Câmara Cascudo, método e ofício são tradição.</p>
        </div>
      </div>
      <div class="crea-client-row" aria-label="Empresas que confiam na Amplify">
        <span>Empresas e instituições que confiam na Amplify</span>
        <div>
          {companyLogos.map((client) => (
            <img src={client.src} alt={client.alt} width="120" height="40" loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <section id="oferta" class="crea-section" aria-labelledby="offer-title">
      <div class="crea-container">
        <div class="crea-section__head">
          <p class="crea-label">Inscrição, empresas e patrocínio</p>
          <h2 id="offer-title">Escolha como participar do Boot Camp.</h2>
          <p>Garanta sua vaga individual, leve sua equipe ou associe sua marca a uma formação prática para profissionais técnicos do RN.</p>
        </div>
        <div class="crea-offer-grid">
          <article class="crea-card crea-card--highlight crea-card--purchase">
            <div class="crea-card__intro">
              <span class="crea-badge" data-sympla-badge>Inscrições abertas</span>
              <h3>Ingresso individual</h3>
              <p>Um dia para transformar IA em ganho real de produtividade: menos retrabalho, documentos melhores e decisões técnicas mais organizadas.</p>
            </div>
            <div class="crea-card__body">
              <ul class="crea-card-list">
                <li>Relatórios, propostas e rotinas técnicas com IA</li>
                <li>Certificado digital</li>
                <li>Aplicações para engenharia, agronomia e gestão técnica</li>
              </ul>
              <p class="crea-card-note">Compra e confirmação pela plataforma oficial do evento.</p>
            </div>
            <div class="crea-card__action">
              <a class="crea-button crea-button--primary" href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-checkout-link>Garantir minha vaga</a>
            </div>
          </article>

          <article class="crea-card crea-card--form">
            <div class="crea-card__intro">
              <span class="crea-badge crea-badge--outline">Equipes técnicas</span>
              <h3>Plano corporativo</h3>
              <p>Leve a equipe para sair com uma linguagem comum de IA, casos de uso priorizados e próximos passos aplicáveis no trabalho.</p>
            </div>
            <form class="crea-form crea-form--compact" data-bootcamp-form data-whatsapp-form data-whatsapp-kind="corporate" data-success-message="Abrindo WhatsApp com a mensagem pronta.">
              <input type="hidden" name="eventName" value="bootcamp_corporate_lead" />
              <input type="hidden" name="entryPoint" value="plano_corporativo_crea_rn" />
              <input type="hidden" name="intent" value="comprar_para_equipe" />
              <input type="hidden" name="sourceCta" value="plano_corporativo_crea_rn" />
              <label>Nome<input name="name" type="text" autocomplete="name" required placeholder="Seu nome" /></label>
              <label>Email<input name="email" type="email" autocomplete="email" required placeholder="voce@empresa.com" /></label>
              <label>Empresa<input name="company" type="text" autocomplete="organization" required placeholder="Nome da empresa" /></label>
              <label>Quantas pessoas?
                <select name="teamSize" required>
                  <option value="">Selecione</option>
                  <option value="5-9">5 a 9</option>
                  <option value="10-19">10 a 19</option>
                  <option value="20+">20+</option>
                </select>
              </label>
              <button class="crea-button crea-button--primary" type="submit">Pedir condição corporativa</button>
              <p class="crea-form-status" role="status" aria-live="polite"></p>
            </form>
          </article>

          <article class="crea-card crea-card--form" id="patrocinio">
            <div class="crea-card__intro">
              <span class="crea-badge crea-badge--outline">Marca parceira</span>
              <h3>Patrocínio</h3>
              <p>Associe sua marca a uma agenda prática de inovação para engenheiros, empresas técnicas e lideranças profissionais do RN.</p>
            </div>
            <form class="crea-form crea-form--compact" data-bootcamp-form data-whatsapp-form data-whatsapp-kind="sponsor" data-success-message="Abrindo WhatsApp com a mensagem pronta.">
              <input type="hidden" name="eventName" value="bootcamp_sponsor_lead" />
              <input type="hidden" name="entryPoint" value="patrocinio_crea_rn" />
              <input type="hidden" name="intent" value="patrocinio" />
              <input type="hidden" name="sourceCta" value="patrocinio_crea_rn" />
              <label>Nome<input name="name" type="text" autocomplete="name" required placeholder="Seu nome" /></label>
              <label>Email<input name="email" type="email" autocomplete="email" required placeholder="voce@empresa.com" /></label>
              <label>Empresa<input name="company" type="text" autocomplete="organization" required placeholder="Nome da empresa" /></label>
              <label>Interesse
                <select name="sponsorInterest" required>
                  <option value="">Selecione</option>
                  <option value="patrocinio">Patrocínio</option>
                  <option value="apoio_institucional">Apoio institucional</option>
                  <option value="plano_corporativo">Plano corporativo</option>
                </select>
              </label>
              <button class="crea-button crea-button--secondary" type="submit">Conversar sobre patrocínio</button>
              <p class="crea-form-status" role="status" aria-live="polite"></p>
            </form>
          </article>
        </div>
      </div>
    </section>

    <section class="crea-section crea-faq" aria-labelledby="faq-title">
      <div class="crea-container">
        <div class="crea-section__head">
          <p class="crea-label">Perguntas frequentes</p>
          <h2 id="faq-title">O essencial antes de decidir.</h2>
        </div>
        <div class="crea-faq__list">
          {faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="crea-final" aria-label="Inscrição">
      <div class="crea-container">
        <img src={creaLogoColor} alt="CREA-RN" width="200" height="50" loading="lazy" />
        <h2>IA aplicada ao trabalho técnico, com método e responsabilidade.</h2>
        <p>25 de julho, das 09:00 às 18:00, no CREA-RN.</p>
        <div class="crea-actions crea-actions--center">
          <a class="crea-button crea-button--primary" href="#oferta">Ver inscrição</a>
          <a class="crea-button crea-button--secondary" href="#patrocinio">Ver patrocínio</a>
        </div>
      </div>
    </section>

    <footer class="crea-footer">
      <div class="crea-container">
        <img src={logoSrc} alt="Amplify" width="120" height="24" />
        <span>Parceria CREA-RN + Amplify · Boot Camp IA para os Desafios de Engenharia</span>
      </div>
    </footer>
  </main>
</PageShell>

<script is:inline define:vars={{ slug: event.slug, checkoutUrl }}>
  const leadStorageKey = `bootcamp:${slug}:lead`;

  function getStoredLead() {
    try {
      return JSON.parse(window.localStorage.getItem(leadStorageKey) || "{}");
    } catch (_error) {
      return {};
    }
  }

  function storeLead(fields) {
    try {
      window.localStorage.setItem(leadStorageKey, JSON.stringify({ ...getStoredLead(), ...fields }));
    } catch (_error) {}
  }

  function preserveUtm(link) {
    try {
      const url = new URL(link.href);
      const current = new URL(window.location.href);
      ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"].forEach((key) => {
        const value = current.searchParams.get(key);
        if (value && !url.searchParams.has(key)) url.searchParams.set(key, value);
      });
      link.href = url.toString();
    } catch (_error) {}
  }

  function track(eventName, extra = {}) {
    const payload = JSON.stringify({
      slug,
      version: "crea-rn",
      eventName,
      pageUrl: window.location.href,
      checkoutUrl,
      ...getStoredLead(),
      ...extra,
    });
    if (navigator.sendBeacon && !extra.forceFetch) {
      navigator.sendBeacon("/api/bootcamp-track", new Blob([payload], { type: "application/json" }));
      return;
    }
    return fetch("/api/bootcamp-track", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: payload,
      keepalive: true,
    }).catch(() => {});
  }

  function getTicketLabel(value) {
    return ({ "5-9": "5 a 9", "10-19": "10 a 19", "20+": "20 ou mais" })[value] || value || "mais de 5";
  }

  function getWhatsappPayload(payload, kind) {
    const name = String(payload.name || "").trim();
    const company = String(payload.company || "").trim();
    const email = String(payload.email || "").trim();
    const identity = [name, company ? `da empresa ${company}` : ""].filter(Boolean).join(", ");
    const teamSize = getTicketLabel(String(payload.teamSize || "").trim());
    const base = kind === "sponsor"
      ? "gostaria de falar sobre patrocínio para o Boot Camp IA para os Desafios de Engenharia em parceria com o CREA-RN."
      : `gostaria de ver condições para ${teamSize} ingressos corporativos para o Boot Camp IA para os Desafios de Engenharia em parceria com o CREA-RN.`;
    const message = [
      "Olá Adriano,",
      identity ? `eu sou ${identity}` : "eu gostaria de falar com você",
      `e ${base}`,
      email ? `Meu email é ${email}.` : "",
    ].filter(Boolean).join(" ");

    return {
      message,
      url: `https://wa.me/5511950350002?text=${encodeURIComponent(message)}`,
    };
  }

  document.querySelectorAll("[data-checkout-link]").forEach((link) => {
    preserveUtm(link);
    link.addEventListener("click", () => track("bootcamp_checkout_started", { sourceCta: link.textContent?.trim() || "checkout" }));
  });

  const symplaBadge = document.querySelector("[data-sympla-badge]");
  if (symplaBadge) {
    fetch(`/api/bootcamp-status?slug=${encodeURIComponent(slug)}`)
      .then((response) => response.json())
      .then((payload) => {
        const label = payload?.availability?.label || "Inscrições via Sympla";
        symplaBadge.textContent = payload?.availability?.isAvailable ? "Inscrições abertas" : label;
        symplaBadge.dataset.available = payload?.availability?.isAvailable ? "true" : "false";
      });
  }

  document.querySelectorAll("[data-bootcamp-form]").forEach((form) => {
    const status = form.querySelector(".crea-form-status");
    const button = form.querySelector("button[type='submit']");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      const email = String(payload.email || "").trim().toLowerCase();
      if (!email) return;

      storeLead({
        email,
        name: payload.name,
        company: payload.company,
        role: payload.role,
        teamSize: payload.teamSize,
      });

      if (status) status.textContent = "Enviando...";
      if (button) button.disabled = true;

      if (form.hasAttribute("data-whatsapp-form")) {
        const whatsapp = getWhatsappPayload(payload, form.dataset.whatsappKind);
        fetch("/api/bootcamp-track", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            slug,
            version: "crea-rn",
            pageUrl: window.location.href,
            checkoutUrl,
            ...payload,
            email,
            whatsappMessage: whatsapp.message,
            forceFetch: true,
          }),
          keepalive: true,
        }).catch(() => {});
        if (status) status.textContent = form.dataset.successMessage || "Abrindo WhatsApp...";
        form.classList.add("is-submitted");
        window.open(whatsapp.url, "_blank", "noopener,noreferrer");
        if (button) button.disabled = false;
        return;
      }

      try {
        const response = await fetch("/api/bootcamp-track", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            slug,
            version: "crea-rn",
            pageUrl: window.location.href,
            checkoutUrl,
            ...payload,
            email,
            forceFetch: true,
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.error) throw new Error(result.error || "Não foi possível registrar seu interesse.");
        form.classList.add("is-submitted");
        if (status) status.textContent = form.dataset.successMessage || "Recebido. Confira seu email.";
      } catch (error) {
        if (status) status.textContent = error.message || "Erro ao enviar. Tente novamente.";
      } finally {
        if (button) button.disabled = false;
      }
    });
